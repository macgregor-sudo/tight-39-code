module

public import HTKronLists

@[expose] public section

/-!
# T component (3, 0): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 426 rows are split at row-type boundaries: idempotency rows [0,95) and
[95,301) (the latter with all frame-sum rows), pairing rows [301,363) and
[363,426). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T30w0 : Z4 := ⟨(-), (-), (), (-)⟩

theorem T30c0 : engine (denLcm (NativeT.rawEntries 3 0)) (NativeT.tSpec 3 0) (((NativeT.rawEntries 3 0).drop 0).take 95) (stateList ystar) =
    T30w0 := by decide +kernel

def T30w1 : Z4 := ⟨(), (), (-), ()⟩

theorem T30c1 : engine (denLcm (NativeT.rawEntries 3 0)) (NativeT.tSpec 3 0) (((NativeT.rawEntries 3 0).drop 95).take 206) (stateList ystar) =
    T30w1 := by decide +kernel

def T30w2 : Z4 := ⟨(-), (), (-), ()⟩

theorem T30c2 : engine (denLcm (NativeT.rawEntries 3 0)) (NativeT.tSpec 3 0) (((NativeT.rawEntries 3 0).drop 301).take 62) (stateList ystar) =
    T30w2 := by decide +kernel

def T30w3 : Z4 := ⟨(), (-), (), (-)⟩

theorem T30c3 : engine (denLcm (NativeT.rawEntries 3 0)) (NativeT.tSpec 3 0) (((NativeT.rawEntries 3 0).drop 363).take 63) (stateList ystar) =
    T30w3 := by decide +kernel

theorem T30len : (NativeT.rawEntries 3 0).length = 426 := by decide +kernel

theorem T30sum : T30w0 + (T30w1 + (T30w2 + (T30w3 + 0))) = tBookValue 3 0 := by decide +kernel

theorem tCheck30 : tValue 3 0 = tBookValue 3 0 := by
  have h0 : tValue 3 0 = engine (denLcm (NativeT.rawEntries 3 0)) (NativeT.tSpec 3 0) ((NativeT.rawEntries 3 0).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 95 95 rfl, T30c0,
    engine_split' _ _ _ _ 95 206 301 rfl, T30c1,
    engine_split' _ _ _ _ 301 62 363 rfl, T30c2,
    engine_split' _ _ _ _ 363 63 426 rfl, T30c3,
    engine_drop_length _ _ _ _ 426 (by rw [T30len])]
  exact T30sum

end Option2.NativeStress.HTRouteKron

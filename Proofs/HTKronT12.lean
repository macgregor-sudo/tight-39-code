module

public import HTKronLists

@[expose] public section

/-!
# T component (1, 2): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 438 rows are split at row-type boundaries: idempotency rows [0,104) and
[104,321) (the latter with all frame-sum rows), pairing rows [321,379) and
[379,438). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T12w0 : Z4 := ⟨(-), (-), (-), ()⟩

theorem T12c0 : engine (denLcm (NativeT.rawEntries 1 2)) (NativeT.tSpec 1 2) (((NativeT.rawEntries 1 2).drop 0).take 104) (stateList ystar) =
    T12w0 := by decide +kernel

def T12w1 : Z4 := ⟨(), (), (), (-)⟩

theorem T12c1 : engine (denLcm (NativeT.rawEntries 1 2)) (NativeT.tSpec 1 2) (((NativeT.rawEntries 1 2).drop 104).take 217) (stateList ystar) =
    T12w1 := by decide +kernel

def T12w2 : Z4 := ⟨(), (), (), ()⟩

theorem T12c2 : engine (denLcm (NativeT.rawEntries 1 2)) (NativeT.tSpec 1 2) (((NativeT.rawEntries 1 2).drop 321).take 58) (stateList ystar) =
    T12w2 := by decide +kernel

def T12w3 : Z4 := ⟨(-), (-), (-), (-)⟩

theorem T12c3 : engine (denLcm (NativeT.rawEntries 1 2)) (NativeT.tSpec 1 2) (((NativeT.rawEntries 1 2).drop 379).take 59) (stateList ystar) =
    T12w3 := by decide +kernel

theorem T12len : (NativeT.rawEntries 1 2).length = 438 := by decide +kernel

theorem T12sum : T12w0 + (T12w1 + (T12w2 + (T12w3 + 0))) = tBookValue 1 2 := by decide +kernel

theorem tCheck12 : tValue 1 2 = tBookValue 1 2 := by
  have h0 : tValue 1 2 = engine (denLcm (NativeT.rawEntries 1 2)) (NativeT.tSpec 1 2) ((NativeT.rawEntries 1 2).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 104 104 rfl, T12c0,
    engine_split' _ _ _ _ 104 217 321 rfl, T12c1,
    engine_split' _ _ _ _ 321 58 379 rfl, T12c2,
    engine_split' _ _ _ _ 379 59 438 rfl, T12c3,
    engine_drop_length _ _ _ _ 438 (by rw [T12len])]
  exact T12sum

end Option2.NativeStress.HTRouteKron

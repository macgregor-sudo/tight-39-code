@[expose] public section

/-! # Explicit row formula for the phased pure T00 covector

At every unit phase `ξ` (u_a = ξ_a / exactPhases_a), the weight of original row `fNumber pe.e.label`, for an
entry `pe` of `HTPhaseKron.covT00`, is `toComplex(literal) · u^(pe.x)`; every other original row has weight `0`. -/

set_option autoImplicit false
set_option maxRecDepth 100000
namespace Option2.NativeStress.HTPhaseComplete
open HTPhaseKron NativeH ConfigurationResidualIndices CKM.NativeFirstOrder

/-- Distinct original rows (kernel check; the same fact is `rep00_nodup` via `rep00_typed`). -/
theorem rows00_nodup : (HTPhaseKron.covT00.map fun q => (fNumber q.e.label).val).Nodup := by decide +kernel

theorem ellT00_row (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (pe : PEntry) (h : pe ∈ HTPhaseKron.covT00) :
    HTPhaseKron.ellT00 ξ hξ (fNumber pe.e.label) = Q12.toComplex pe.e.coefficient.toQ12 * mono (Uph ξ hξ) pe.x :=
  sum_ite_of_nodup HTPhaseKron.covT00 (fun q => Q12.toComplex q.e.coefficient.toQ12 * mono (Uph ξ hξ) q.x)
    rows00_nodup pe h

theorem ellT00_off (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (r : Fin 2184)
    (h : ∀ q ∈ HTPhaseKron.covT00, fNumber q.e.label ≠ r) : HTPhaseKron.ellT00 ξ hξ r = 0 :=
  sum_ite_of_not_mem HTPhaseKron.covT00 _ r h

end Option2.NativeStress.HTPhaseComplete

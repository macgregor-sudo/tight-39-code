-- BEGIN LITERALQUARTETREADOUTS BODY
/-
# Scalar readouts of the literal complex quartet

The matrices and reconstruction are those of LiteralComplexQuartet, with
the existing Fourier root and the exact three coordinate plus nine phase
labels. Equal readouts determine the scalar matrix without an assumed
trace normalization. For Hermitian matrices, the scalar pairing is real;
the product of the two matrices need not itself be Hermitian.

This is the classical complete-MUB reconstruction application, not a new
tomography theorem: Parthasarathy quant-ph/0408069 Theorem2.4(i), and
Klappenecker–Rötteler quant-ph/0502031 Theorem3/Remark2. The literal binder
and arbitrary-complex reconstruction were established in the imported
first-party module. All proofs below are locally authored applications.
Pinned mathlib imports retain their notices and attribution in that module.
Thanks to the classical source authors, Lean and mathlib contributors.
“If I have seen further it is by standing on the sholders of Giants.” — Isaac Newton, letter to Robert Hooke, 1676.
Quotation source: https://www.newtonproject.ox.ac.uk/view/texts/normalized/OTHE00018
-/


@[expose] public section
noncomputable section

namespace UnitaryErrorBases.ComplexQuartet

open scoped BigOperators

/-- The twelve complex trace readouts are all one third exactly at I/3.
The coordinate frame supplies trace one, so no trace hypothesis is required. -/
theorem literal_quartet_complex_readouts_iff (A : ComplexMatrix3) :
    ((∀ t : Fin 3, (A * coordinateProjector t).trace = (1 / 3 : ℂ)) ∧
      (∀ s t : PhaseIndex, (A * phaseProjector s t).trace = (1 / 3 : ℂ))) ↔
      A = (1 / 3 : ℂ) • (1 : ComplexMatrix3) := by
  constructor
  · rintro ⟨hE, hP⟩
    have htrace : A.trace = 1 := by
      calc
        A.trace = (A * (∑ t : Fin 3, coordinateProjector t)).trace := by
          rw [coordinateProjector_sum, Matrix.mul_one]
        _ = ∑ t : Fin 3, (A * coordinateProjector t).trace := by
          rw [Matrix.mul_sum, Matrix.trace_sum]
        _ = 1 := by norm_num [hE, Fin.sum_univ_three]
    have hframe (s : PhaseIndex) :
        (∑ t : PhaseIndex, (1 / 3 : ℂ) • phaseProjector s t) =
          (1 / 3 : ℂ) • (1 : ComplexMatrix3) := by
      rw [← Finset.smul_sum, phaseProjector_sum]
    have hphase : (∑ s : PhaseIndex, (1 / 3 : ℂ) • (1 : ComplexMatrix3)) =
        (1 : ComplexMatrix3) := by
      calc
        _ = (1 / 3 : ℂ) • (1 : ComplexMatrix3) +
              (1 / 3 : ℂ) • (1 : ComplexMatrix3) +
              (1 / 3 : ℂ) • (1 : ComplexMatrix3) := Fin.sum_univ_three _
        _ = 1 := by rw [← add_smul, ← add_smul]; norm_num
    have hrec :
        (∑ t : Fin 3, (1 / 3 : ℂ) • coordinateProjector t) +
            (∑ s : PhaseIndex, ∑ t : PhaseIndex,
              (1 / 3 : ℂ) • phaseProjector s t) =
          A + A.trace • (1 : ComplexMatrix3) := by
      simpa only [hE, hP] using literal_quartet_reconstruction A
    rw [← Finset.smul_sum, coordinateProjector_sum] at hrec
    simp only [hframe] at hrec
    rw [hphase, htrace, one_smul] at hrec
    exact (add_right_cancel hrec).symm
  · rintro rfl
    constructor
    · intro t
      simp only [Matrix.smul_mul, Matrix.one_mul, Matrix.trace_smul,
        coordinateProjector_trace, smul_eq_mul, mul_one]
    · intro s t
      simp only [Matrix.smul_mul, Matrix.one_mul, Matrix.trace_smul,
        phaseProjector_trace, smul_eq_mul, mul_one]

/-- The trace of a product of two Hermitian matrices is real. -/
theorem trace_mul_eq_real_of_isHermitian (A P : ComplexMatrix3)
    (hA : A.IsHermitian) (hP : P.IsHermitian) :
    ((A * P).trace.re : ℂ) = (A * P).trace := by
  apply Complex.conj_eq_iff_re.mp
  change star (A * P).trace = (A * P).trace
  rw [← Matrix.trace_conjTranspose, Matrix.conjTranspose_mul,
    hP.eq, hA.eq, Matrix.trace_mul_comm]

/-- For Hermitian A, equal real readouts against the twelve literal matrices
already determine I/3; positivity and trace one are not hypotheses. -/
theorem literal_quartet_real_readouts_iff (A : ComplexMatrix3)
    (hA : A.IsHermitian) :
    ((∀ t : Fin 3, (A * coordinateProjector t).trace.re = (1 / 3 : ℝ)) ∧
      (∀ s t : PhaseIndex, (A * phaseProjector s t).trace.re = (1 / 3 : ℝ))) ↔
      A = (1 / 3 : ℂ) • (1 : ComplexMatrix3) := by
  constructor
  · rintro ⟨hE, hP⟩
    apply (literal_quartet_complex_readouts_iff A).mp
    constructor
    · intro t
      calc
        (A * coordinateProjector t).trace =
            ((A * coordinateProjector t).trace.re : ℂ) :=
          (trace_mul_eq_real_of_isHermitian A _ hA
            (coordinateProjector_isHermitian t)).symm
        _ = (1 / 3 : ℂ) := by rw [hE t]; norm_num
    · intro s t
      calc
        (A * phaseProjector s t).trace =
            ((A * phaseProjector s t).trace.re : ℂ) :=
          (trace_mul_eq_real_of_isHermitian A _ hA
            (phaseProjector_isHermitian s t)).symm
        _ = (1 / 3 : ℂ) := by rw [hP s t]; norm_num
  · intro h
    have hcomplex := (literal_quartet_complex_readouts_iff A).mpr h
    constructor
    · intro t
      have ht := congrArg Complex.re (hcomplex.1 t)
      norm_num at ht
      exact ht
    · intro s t
      have ht := congrArg Complex.re (hcomplex.2 s t)
      norm_num at ht
      exact ht

end UnitaryErrorBases.ComplexQuartet

-- END LITERALQUARTETREADOUTS BODY
#check UnitaryErrorBases.ComplexQuartet.literal_quartet_complex_readouts_iff
#check UnitaryErrorBases.ComplexQuartet.trace_mul_eq_real_of_isHermitian
#check UnitaryErrorBases.ComplexQuartet.literal_quartet_real_readouts_iff
#print axioms UnitaryErrorBases.ComplexQuartet.literal_quartet_complex_readouts_iff
#print axioms UnitaryErrorBases.ComplexQuartet.trace_mul_eq_real_of_isHermitian
#print axioms UnitaryErrorBases.ComplexQuartet.literal_quartet_real_readouts_iff

-- END PASSED LITERALQUARTETREADOUTS ASSEMBLY BODY
-- BEGIN NATIVEINCLUDEDQUARTETREADOUTS BODY
/-
# Actual native readouts of the included complex quartet

A Hermitian complex matrix is included into the actual native Albert type
using the two existing inverse coordinate maps, with hidden component zero.
The readout below is Glennie.trace of the actual Glennie.jordan product.
No pairing or multiplication is defined by transport.

The included coordinate and phase points refer to the literal matrices in
LiteralComplexQuartet. Equality to an independently specified native anchor
list remains a separate adapter; this module does not redefine that list
or claim its original labels have been formally bound. No purity or trace
normalization is assumed for the arbitrary native argument.

These locally authored proofs compose existing first-party coordinate,
native-product and classical quartet reconstruction results. Source/provenance
and complete upstream notices remain in NativeTitsTracePairing and
LiteralQuartetReadouts. No new theorem or tomography novelty is claimed.
Thanks to those source authors and to the Lean and mathlib contributors.
“If I have seen further it is by standing on the sholders of Giants.” — Isaac Newton, letter to Robert Hooke, 1676.
Quotation source: https://www.newtonproject.ox.ac.uk/view/texts/normalized/OTHE00018
-/


@[expose] public section
noncomputable section

namespace CompactAlbert

open UnitaryErrorBases.ComplexQuartet

/-- Include a Hermitian matrix through the existing inverse coordinates,
with hidden B-component zero. -/
def includeHermitianMatrix (P : {a : TitsComplexMatrix // a.IsHermitian}) :
    Glennie.Albert :=
  fromTitsCoordinates (fromHermitianPair (P, 0))

/-- Both actual coordinate components of the included matrix are fixed. -/
theorem includeHermitianMatrix_pair
    (P : {a : TitsComplexMatrix // a.IsHermitian}) :
    nativeTitsMatrixPair (includeHermitianMatrix P) = (P.val, 0) := by
  have h : toHermitianPair (toTitsCoordinates (includeHermitianMatrix P)) = (P, 0) := by
    unfold includeHermitianMatrix
    rw [toTitsCoordinates_fromTitsCoordinates, toHermitianPair_fromHermitianPair]
  apply Prod.ext
  · change hermitianMatrix (toTitsCoordinates (includeHermitianMatrix P)) = P.val
    exact congrArg (fun q : HermitianTitsPair => q.1.val) h
  · change (toTitsCoordinates (includeHermitianMatrix P)).2.2 = 0
    exact congrArg (fun q : HermitianTitsPair => q.2) h

/-- The actual native trace readout against an included matrix is precisely
the real visible-matrix trace readout. -/
theorem native_trace_jordan_includeHermitianMatrix (x : Glennie.Albert)
    (P : {a : TitsComplexMatrix // a.IsHermitian}) :
    Glennie.trace (Glennie.jordan x (includeHermitianMatrix P)) =
      (hermitianMatrix (toTitsCoordinates x) * P.val).trace.re := by
  have hp := includeHermitianMatrix_pair P
  have hv : hermitianMatrix (toTitsCoordinates (includeHermitianMatrix P)) = P.val :=
    congrArg (fun q : TitsMatrixPair => q.1) hp
  have hh : (toTitsCoordinates (includeHermitianMatrix P)).2.2 = 0 :=
    congrArg (fun q : TitsMatrixPair => q.2) hp
  rw [native_trace_jordan_eq_visible_pairing_of_hidden_eq_zero x
    (includeHermitianMatrix P) hh, hv]

/-- The native inclusion of the coordinate projector labelled t. -/
def includedCoordinatePoint (t : Fin 3) : Glennie.Albert :=
  includeHermitianMatrix ⟨coordinateProjector t, coordinateProjector_isHermitian t⟩

/-- The native inclusion of the phase projector labelled by frame 1+s and outcome t. -/
def includedPhasePoint (s t : PhaseIndex) : Glennie.Albert :=
  includeHermitianMatrix ⟨phaseProjector s t, phaseProjector_isHermitian s t⟩

/-- Equal actual native readouts against this included twelve-point quartet
force exactly the visible component I/3. The hidden component is unrestricted. -/
theorem native_included_quartet_readouts_iff (x : Glennie.Albert) :
    ((∀ t : Fin 3,
        Glennie.trace (Glennie.jordan x (includedCoordinatePoint t)) = (1 / 3 : ℝ)) ∧
      (∀ s t : PhaseIndex,
        Glennie.trace (Glennie.jordan x (includedPhasePoint s t)) = (1 / 3 : ℝ))) ↔
      hermitianMatrix (toTitsCoordinates x) =
        (1 / 3 : ℂ) • (1 : TitsComplexMatrix) := by
  have hE (t : Fin 3) :
      Glennie.trace (Glennie.jordan x (includedCoordinatePoint t)) =
        (hermitianMatrix (toTitsCoordinates x) * coordinateProjector t).trace.re :=
    native_trace_jordan_includeHermitianMatrix x
      ⟨coordinateProjector t, coordinateProjector_isHermitian t⟩
  have hP (s t : PhaseIndex) :
      Glennie.trace (Glennie.jordan x (includedPhasePoint s t)) =
        (hermitianMatrix (toTitsCoordinates x) * phaseProjector s t).trace.re :=
    native_trace_jordan_includeHermitianMatrix x
      ⟨phaseProjector s t, phaseProjector_isHermitian s t⟩
  simpa only [hE, hP] using
    literal_quartet_real_readouts_iff (hermitianMatrix (toTitsCoordinates x))
      (hermitianMatrix_isHermitian (toTitsCoordinates x))

end CompactAlbert

-- END NATIVEINCLUDEDQUARTETREADOUTS BODY
#check CompactAlbert.includeHermitianMatrix_pair
#check CompactAlbert.native_trace_jordan_includeHermitianMatrix
#check CompactAlbert.native_included_quartet_readouts_iff
#print axioms CompactAlbert.includeHermitianMatrix_pair
#print axioms CompactAlbert.native_trace_jordan_includeHermitianMatrix
#print axioms CompactAlbert.native_included_quartet_readouts_iff

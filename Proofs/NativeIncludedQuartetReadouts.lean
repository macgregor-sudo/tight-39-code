@[expose] public section
noncomputable section

namespace CompactAlbert

/-- The existing ambient complex matrix space, regarded as a real vector space. -/
abbrev TitsComplexMatrix := Matrix (Fin 3) (Fin 3) ℂ

/-- An ambient matrix pair. Actual coordinate inputs have Hermitian first entry. -/
abbrev TitsMatrixPair := TitsComplexMatrix × TitsComplexMatrix

/-- Independent visible product formula, with the real trace correction. -/
def compactSecondTitsProductComplex (a B c D : TitsComplexMatrix) : TitsComplexMatrix :=
  (1 / 2 : ℂ) • (a * c + c * a - B * D.conjTranspose - D * B.conjTranspose) +
    ((B * D.conjTranspose).trace.re : ℂ) • (1 : TitsComplexMatrix)

/-- Independent hidden product formula. The adjugate polarization is polynomial,
so neither hidden matrix is required to be invertible. -/
def compactSecondTitsProductHidden (a B c D : TitsComplexMatrix) : TitsComplexMatrix :=
  (1 / 2 : ℂ) •
    (((c.trace.re : ℂ) • (1 : TitsComplexMatrix) - c) * B +
      ((a.trace.re : ℂ) • (1 : TitsComplexMatrix) - a) * D +
      ((B + D).adjugate.conjTranspose - B.adjugate.conjTranspose -
        D.adjugate.conjTranspose))

/-- The independent operation on ambient pairs; its intended compact carrier
has Hermitian first component. No inverse native map occurs in the definition. -/
def compactSecondTitsProduct (p r : TitsMatrixPair) : TitsMatrixPair :=
  (compactSecondTitsProductComplex p.1 p.2 r.1 r.2,
    compactSecondTitsProductHidden p.1 p.2 r.1 r.2)

/-- The two independently written matrix square expressions. This is a formula,
not a square transported through the native coordinate equivalence. -/
def compactSecondTitsSquare (p : TitsMatrixPair) : TitsMatrixPair :=
  (p.1 * p.1 - p.2 * p.2.conjTranspose +
      ((p.2 * p.2.conjTranspose).trace.re : ℂ) • (1 : TitsComplexMatrix),
    ((p.1.trace.re : ℂ) • (1 : TitsComplexMatrix) - p.1) * p.2 +
      p.2.adjugate.conjTranspose)

/-- The actual Hermitian coordinate view preserves addition. -/
theorem hermitianMatrix_add (q r : TitsCoordinates) :
    hermitianMatrix (q + r) = hermitianMatrix q + hermitianMatrix r := by
  apply Matrix.ext
  intro row column
  fin_cases row <;> fin_cases column <;>
    simp [hermitianMatrix, Matrix.add_apply]

/-- The same view is linear over the compact model's scalar field R. -/
theorem hermitianMatrix_smul (t : ℝ) (q : TitsCoordinates) :
    hermitianMatrix (t • q) = t • hermitianMatrix q := by
  apply Matrix.ext
  intro row column
  fin_cases row <;> fin_cases column <;>
    simp [hermitianMatrix, Matrix.smul_apply, Complex.real_smul, smul_eq_mul]

/-- The ordinary complex trace has the unnormalized native real trace. -/
theorem hermitianMatrix_trace (q : TitsCoordinates) :
    (hermitianMatrix q).trace = (titsTrace q : ℂ) := by
  simp [Matrix.trace_fin_three, hermitianMatrix, titsTrace]

/-- The existing matrix-pair view packaged only as a real-linear map. -/
def titsMatrixPairLinear : TitsCoordinates →ₗ[ℝ] TitsMatrixPair where
  toFun := toMatrixPair
  map_add' q r := by
    apply Prod.ext
    · exact hermitianMatrix_add q r
    · rfl
  map_smul' t q := by
    apply Prod.ext
    · exact hermitianMatrix_smul t q
    · rfl

/-- The actual native coordinate map into the ambient matrix pair. -/
def nativeTitsMatrixPair : Glennie.Albert →ₗ[ℝ] TitsMatrixPair :=
  titsMatrixPairLinear.comp compactTitsCoordinateEquiv.toLinearMap

/-- Polarization of the actual native symmetric binary product. Its proof
uses the existing native entry equations, not an assumed product dictionary. -/
theorem native_jordan_polarization (x y : Glennie.Albert) :
    Glennie.jordan x y = (1 / 2 : ℝ) •
      (Glennie.jordan (x + y) (x + y) - Glennie.jordan x x - Glennie.jordan y y) := by
  apply Glennie.Albert.extExplicit
  · simp [Glennie.jordan_d0, Glennie.octDot_coordinates,
      Glennie.octNormSq, Quaternion.normSq_def']
    ring
  · simp [Glennie.jordan_d1, Glennie.octDot_coordinates,
      Glennie.octNormSq, Quaternion.normSq_def']
    ring
  · simp [Glennie.jordan_d2, Glennie.octDot_coordinates,
      Glennie.octNormSq, Quaternion.normSq_def']
    ring
  · simp [Glennie.jordan_o01, Glennie.octMul_add_left,
      Glennie.octMul_add_right, Glennie.octConj_add]
    module
  · simp [Glennie.jordan_o02, Glennie.octMul_add_left,
      Glennie.octMul_add_right, Glennie.octConj_add]
    module
  · simp [Glennie.jordan_o12, Glennie.octMul_add_left,
      Glennie.octMul_add_right, Glennie.octConj_add]
    module

/-- Real trace-pair symmetry follows from actual conjugate transpose and trace. -/
theorem matrixTrace_pair_re_symm (B D : TitsComplexMatrix) :
    (B * D.conjTranspose).trace.re = (D * B.conjTranspose).trace.re := by
  have h := congrArg Complex.re
    (Matrix.trace_conjTranspose (D * B.conjTranspose))
  simpa [Matrix.conjTranspose_mul, Complex.star_def] using h

/-- The displayed independent product is exactly real polarization of its
displayed square, even on the ambient pair carrier. No matrix inverse occurs. -/
theorem compactSecondTitsProduct_eq_polarization (p r : TitsMatrixPair) :
    compactSecondTitsProduct p r = (1 / 2 : ℝ) •
      (compactSecondTitsSquare (p + r) - compactSecondTitsSquare p -
        compactSecondTitsSquare r) := by
  rcases p with ⟨a, B⟩
  rcases r with ⟨c, D⟩
  apply Prod.ext
  · change compactSecondTitsProductComplex a B c D = (1 / 2 : ℝ) •
      ((compactSecondTitsSquare (a + c, B + D)).1 -
        (compactSecondTitsSquare (a, B)).1 -
        (compactSecondTitsSquare (c, D)).1)
    simp only [compactSecondTitsSquare, compactSecondTitsProductComplex,
      Matrix.conjTranspose_add, add_mul, mul_add, Matrix.trace_add,
      Complex.add_re, Complex.ofReal_add, matrixTrace_pair_re_symm D B]
    match_scalars <;> norm_num [map_div₀] <;> ring
  · change compactSecondTitsProductHidden a B c D = (1 / 2 : ℝ) •
      ((compactSecondTitsSquare (a + c, B + D)).2 -
        (compactSecondTitsSquare (a, B)).2 -
        (compactSecondTitsSquare (c, D)).2)
    simp only [compactSecondTitsSquare, compactSecondTitsProductHidden,
      Matrix.trace_add, Complex.add_re, Complex.ofReal_add,
      Matrix.conjTranspose_add, add_smul, Matrix.smul_mul, Matrix.mul_smul,
      add_mul, mul_add, sub_mul, mul_sub, one_mul]
    match_scalars <;> norm_num [map_div₀] <;> ring

/-- Both checked actual native square components, combined with the proved
trace wrapper. This does not assert a cubic-norm identification. -/

@[expose] public section
noncomputable section

namespace CompactAlbert

open scoped BigOperators

/-- The scalar projection of the existing real-linear octonion equivalence. -/
theorem titsScalar_add (x y : Glennie.Octonion) :
    (octonionToTitsRow (x + y)).1 =
      (octonionToTitsRow x).1 + (octonionToTitsRow y).1 := by
  exact congrArg Prod.fst (map_add octonionTitsRowEquiv x y)

/-- The same scalar projection preserves real scaling. -/
theorem titsScalar_smul (r : ℝ) (x : Glennie.Octonion) :
    (octonionToTitsRow (r • x)).1 = r • (octonionToTitsRow x).1 := by
  exact congrArg Prod.fst (map_smul octonionTitsRowEquiv r x)

/-- The already checked scalar product in the existing signed B rows.
This is a coordinate rewrite, with conjugation on the first B row. -/
theorem titsScalar_mul (x y : Glennie.Octonion) :
    (octonionToTitsRow (Glennie.octMul x y)).1 =
      (octonionToTitsRow x).1 * (octonionToTitsRow y).1 -
        ∑ column : Fin 3,
          star ((octonionToTitsRow x).2 column) *
            (octonionToTitsRow y).2 column := by
  change octonionComplexScalar (Glennie.octMul x y) = _
  rw [octonionComplexScalar_mul]
  simp [titsRow_eq_neg_conjugate_vector, complexDot3,
    Fin.sum_univ_three, octonionComplexScalar]

/-- The checked compact norm in one complex scalar and the three B entries. -/
theorem octonion_norm_tits_row (x : Glennie.Octonion) :
    Glennie.octNormSq x =
      Complex.normSq ((octonionToTitsRow x).1) +
        ∑ column : Fin 3, Complex.normSq ((octonionToTitsRow x).2 column) := by
  rw [octonion_norm_complex_coordinates, titsRow_eq_neg_conjugate_vector]
  simp [octonionComplexScalar, Complex.star_def]

/-- Visible component of the actual compact Albert square. The trace
correction is positive and present even for singular B. No independent Tits
square or product formula is assumed as a hypothesis. -/
theorem native_tits_visible_square (x : Glennie.Albert) :
    hermitianMatrix (toTitsCoordinates (Glennie.jordan x x)) =
      hermitianMatrix (toTitsCoordinates x) *
          hermitianMatrix (toTitsCoordinates x) -
        (toTitsCoordinates x).2.2 *
          (toTitsCoordinates x).2.2.conjTranspose +
        (((toTitsCoordinates x).2.2 *
            (toTitsCoordinates x).2.2.conjTranspose).trace.re : ℂ) •
          (1 : Matrix (Fin 3) (Fin 3) ℂ) := by
  apply Matrix.ext
  intro row column
  change (hermitianMatrix (toTitsCoordinates (Glennie.jordan x x)) :
      Matrix (Fin 3) (Fin 3) ℂ) row column =
    ((hermitianMatrix (toTitsCoordinates x) *
          hermitianMatrix (toTitsCoordinates x) -
        (toTitsCoordinates x).2.2 *
          (toTitsCoordinates x).2.2.conjTranspose +
        (((toTitsCoordinates x).2.2 *
            (toTitsCoordinates x).2.2.conjTranspose).trace.re : ℂ) •
          (1 : Matrix (Fin 3) (Fin 3) ℂ)) :
      Matrix (Fin 3) (Fin 3) ℂ) row column
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply,
    Matrix.mul_apply, Matrix.conjTranspose_apply, Matrix.trace_fin_three,
    Matrix.one_apply, Fin.sum_univ_three]
  fin_cases row <;> fin_cases column <;> apply Complex.ext <;>
    simp [toTitsCoordinates, hermitianMatrix,
      Glennie.jordan_d0, Glennie.jordan_d1, Glennie.jordan_d2,
      Glennie.jordan_o01, Glennie.jordan_o02, Glennie.jordan_o12,
      Glennie.octDot_self, octonion_norm_tits_row,
      titsScalar_add, titsScalar_smul, titsScalar_conjugate, titsScalar_mul,
      titsRow_add, titsRow_smul, titsRow_conjugate,
      Fin.sum_univ_three, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, Pi.neg_apply,
      Complex.real_smul, smul_eq_mul, Complex.star_def,
      Complex.normSq_apply, Complex.mul_re, Complex.mul_im] <;> ring

end CompactAlbert


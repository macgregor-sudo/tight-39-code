/-! The cyclic cofactor formula for an arbitrary star-ring matrix of order three. -/

@[expose] public section

namespace Matrix

variable {R : Type*} [CommRing R] [StarRing R]

/-- A row of `adj(B)ᴴ` is the star of the cross product of the next two rows.
The additions in `Fin 3` express the fixed cyclic orientation. No determinant
or invertibility hypothesis is present. -/
theorem adjugate_conjTranspose_apply_fin_three
    (B : Matrix (Fin 3) (Fin 3) R) (row column : Fin 3) :
    B.adjugate.conjTranspose row column =
      star (B (row + 1) (column + 1) * B (row + 2) (column + 2) -
        B (row + 1) (column + 2) * B (row + 2) (column + 1)) := by
  rw [Matrix.adjugate_fin_three]
  fin_cases row <;> fin_cases column <;>
    simp [Matrix.conjTranspose_apply] <;> ring

end Matrix


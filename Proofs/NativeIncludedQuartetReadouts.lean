namespace CompactAlbert

/-- Forgetting only the Hermitian proof retains the existing coordinates. -/
theorem toMatrixPair_injective : Function.Injective toMatrixPair := by
  intro q r h
  apply titsHermitianPairEquiv.injective
  change toHermitianPair q = toHermitianPair r
  apply Prod.ext
  · apply Subtype.ext
    exact congrArg Prod.fst h
  · change q.2.2 = r.2.2
    exact congrArg (fun p : TitsMatrixPair => p.2) h

/-- The actual native matrix-pair view is injective, without a new inverse. -/
theorem nativeTitsMatrixPair_injective : Function.Injective nativeTitsMatrixPair := by
  intro x y h
  apply compactTitsCoordinateEquiv.injective
  apply toMatrixPair_injective
  exact h

/-- At a=I/3 the two explicit square equations are exactly the normalized
B-row Gram and adjugate equations. The ordinary trace supplies the Gram scale. -/
theorem compactSecondTitsSquare_third_iff (B : TitsComplexMatrix) :
    compactSecondTitsSquare ((1 / 3 : ℂ) • (1 : TitsComplexMatrix), B) =
        ((1 / 3 : ℂ) • (1 : TitsComplexMatrix), B) ↔
      B * B.conjTranspose = (1 / 9 : ℂ) • (1 : TitsComplexMatrix) ∧
        B.adjugate.conjTranspose = (1 / 3 : ℂ) • B := by
  constructor
  · intro h
    have hv := congrArg Prod.fst h
    have hh := congrArg Prod.snd h
    change ((1 / 3 : ℂ) • (1 : TitsComplexMatrix)) *
          ((1 / 3 : ℂ) • (1 : TitsComplexMatrix)) - B * B.conjTranspose +
        ((B * B.conjTranspose).trace.re : ℂ) • (1 : TitsComplexMatrix) =
      (1 / 3 : ℂ) • (1 : TitsComplexMatrix) at hv
    have ht := congrArg (fun M : TitsComplexMatrix => M.trace.re) hv
    norm_num [Matrix.trace_add, Matrix.trace_sub, Matrix.trace_smul,
      Matrix.trace_one, Matrix.smul_mul, Matrix.mul_smul, smul_smul,
      smul_eq_mul, Complex.mul_re, Complex.mul_im] at ht
    have hr : (B * B.conjTranspose).trace.re = (1 / 3 : ℝ) := by
      linarith
    have hv' := hv
    rw [hr] at hv'
    norm_num [Matrix.smul_mul, Matrix.mul_smul, smul_smul] at hv'
    have hz : (1 / 9 : ℂ) • (1 : TitsComplexMatrix) - B * B.conjTranspose = 0 := by
      exact add_right_cancel (show
        ((1 / 9 : ℂ) • (1 : TitsComplexMatrix) - B * B.conjTranspose) +
            (1 / 3 : ℂ) • (1 : TitsComplexMatrix) =
          (0 : TitsComplexMatrix) + (1 / 3 : ℂ) • (1 : TitsComplexMatrix) by
        simpa using hv')
    have hB : B * B.conjTranspose = (1 / 9 : ℂ) • (1 : TitsComplexMatrix) :=
      (sub_eq_zero.mp hz).symm
    change ((((1 / 3 : ℂ) • (1 : TitsComplexMatrix)).trace.re : ℂ) •
        (1 : TitsComplexMatrix) - (1 / 3 : ℂ) • (1 : TitsComplexMatrix)) * B +
          B.adjugate.conjTranspose = B at hh
    norm_num [Matrix.trace_smul, Matrix.trace_one, sub_mul,
      Matrix.smul_mul, smul_smul] at hh
    have hsharp : B.adjugate.conjTranspose = (1 / 3 : ℂ) • B := by
      calc
        B.adjugate.conjTranspose =
            (B - (1 / 3 : ℂ) • B + B.adjugate.conjTranspose) -
              (B - (1 / 3 : ℂ) • B) := by module
        _ = B - (B - (1 / 3 : ℂ) • B) := by rw [hh]
        _ = (1 / 3 : ℂ) • B := by module
    exact ⟨hB, hsharp⟩
  · rintro ⟨hB, hsharp⟩
    apply Prod.ext
    · change ((1 / 3 : ℂ) • (1 : TitsComplexMatrix)) *
            ((1 / 3 : ℂ) • (1 : TitsComplexMatrix)) - B * B.conjTranspose +
          ((B * B.conjTranspose).trace.re : ℂ) • (1 : TitsComplexMatrix) =
        (1 / 3 : ℂ) • (1 : TitsComplexMatrix)
      simp only [hB]
      norm_num [Matrix.smul_mul, Matrix.mul_smul, smul_smul,
        Matrix.trace_smul, Matrix.trace_one]
    · change ((((1 / 3 : ℂ) • (1 : TitsComplexMatrix)).trace.re : ℂ) •
          (1 : TitsComplexMatrix) - (1 / 3 : ℂ) • (1 : TitsComplexMatrix)) * B +
            B.adjugate.conjTranspose = B
      simp only [hsharp]
      norm_num [Matrix.trace_smul, Matrix.trace_one, sub_mul,
        Matrix.smul_mul, smul_smul] <;> module

/-- The actual native trace is one when the visible component is I/3. -/
theorem native_trace_eq_one_of_visible_third (x : Glennie.Albert)
    (ha : hermitianMatrix (toTitsCoordinates x) =
      (1 / 3 : ℂ) • (1 : TitsComplexMatrix)) :
    Glennie.trace x = 1 := by
  have ht : (hermitianMatrix (toTitsCoordinates x)).trace.re = 1 := by
    rw [ha]
    norm_num [Matrix.trace_smul, Matrix.trace_one]
  change titsTrace (toTitsCoordinates x) = 1
  simpa only [hermitianMatrix_trace, Complex.ofReal_re] using ht

/-- Actual native idempotency is equivalent to the two normalized B-row
equations under exactly the visible-component hypothesis. Anchor spanning
and the determinant-one normalization are not asserted by this theorem. -/
theorem native_idempotent_iff_tits_rows_of_visible_third (x : Glennie.Albert)
    (ha : hermitianMatrix (toTitsCoordinates x) =
      (1 / 3 : ℂ) • (1 : TitsComplexMatrix)) :
    Glennie.jordan x x = x ↔
      (toTitsCoordinates x).2.2 * (toTitsCoordinates x).2.2.conjTranspose =
          (1 / 9 : ℂ) • (1 : TitsComplexMatrix) ∧
        (toTitsCoordinates x).2.2.adjugate.conjTranspose =
          (1 / 3 : ℂ) • (toTitsCoordinates x).2.2 := by
  let B : TitsComplexMatrix := (toTitsCoordinates x).2.2
  have hp : nativeTitsMatrixPair x = ((1 / 3 : ℂ) • (1 : TitsComplexMatrix), B) := by
    change (hermitianMatrix (toTitsCoordinates x), B) = _
    rw [ha]
  change Glennie.jordan x x = x ↔
    B * B.conjTranspose = (1 / 9 : ℂ) • (1 : TitsComplexMatrix) ∧
      B.adjugate.conjTranspose = (1 / 3 : ℂ) • B
  constructor
  · intro h
    apply (compactSecondTitsSquare_third_iff B).mp
    calc
      compactSecondTitsSquare ((1 / 3 : ℂ) • (1 : TitsComplexMatrix), B) =
          compactSecondTitsSquare (nativeTitsMatrixPair x) := by rw [hp]
      _ = nativeTitsMatrixPair (Glennie.jordan x x) := (native_tits_square_pair x).symm
      _ = ((1 / 3 : ℂ) • (1 : TitsComplexMatrix), B) := by rw [h, hp]
  · intro h
    apply nativeTitsMatrixPair_injective
    rw [native_tits_square_pair, hp]
    exact (compactSecondTitsSquare_third_iff B).mpr h

end CompactAlbert


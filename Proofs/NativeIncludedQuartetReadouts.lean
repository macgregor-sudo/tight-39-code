/-- The actual native product trace is the visible Hermitian pairing plus
twice the hidden B Dᴴ pairing. No idempotency hypothesis is needed. -/
theorem native_trace_jordan_eq_tits_pairing (x y : Glennie.Albert) :
    Glennie.trace (Glennie.jordan x y) =
      (hermitianMatrix (toTitsCoordinates x) *
          hermitianMatrix (toTitsCoordinates y)).trace.re +
        2 * ((toTitsCoordinates x).2.2 *
          (toTitsCoordinates y).2.2.conjTranspose).trace.re := by

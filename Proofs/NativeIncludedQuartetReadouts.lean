#print axioms UnitaryErrorBases.ThreeCycleFourier.pairEquations_iff_recurrence
#print axioms UnitaryErrorBases.ThreeCycleFourier.inverse_pairEquations_iff_recurrence
#print axioms UnitaryErrorBases.ThreeCycleFourier.phaseWeight_ne_zero
#print axioms UnitaryErrorBases.ThreeCycleFourier.phasePairEquations_iff_recurrence


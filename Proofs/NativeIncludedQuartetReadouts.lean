namespace UnitaryErrorBases.ThreeCycleFourier

open scoped BigOperators

abbrev Index := ZMod 3
abbrev Coordinates := Index → Index → Index → ℂ

private lemma index_cases (i : Index) : i = 0 ∨ i = 1 ∨ i = 2 := by
  exact (by decide : ∀ j : Index, j = 0 ∨ j = 1 ∨ j = 2) i

@[simp] private lemma index_neg_one : -(1 : Index) = 2 := by decide
@[simp] private lemma index_neg_two : -(2 : Index) = 1 := by decide
@[simp] private lemma index_one_add_one : (1 : Index) + 1 = 2 := by decide
@[simp] private lemma index_one_add_two : (1 : Index) + 2 = 0 := by decide
@[simp] private lemma index_two_add_one : (2 : Index) + 1 = 0 := by decide
@[simp] private lemma index_two_add_two : (2 : Index) + 2 = 1 := by decide
@[simp] private lemma index_two_mul_two : (2 : Index) * 2 = 1 := by decide

/-- The positive-imaginary primitive cube root used by the clock matrix. -/
def omega : ℂ := (-1 + Complex.I * (Real.sqrt 3 : ℂ)) / 2

lemma omega_sq : omega ^ 2 = -1 - omega := by
  have hs : (Real.sqrt 3) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  apply Complex.ext <;>
    norm_num [omega, pow_two, Complex.mul_re, Complex.mul_im] <;>
    nlinarith [hs]

lemma omega_cube : omega ^ 3 = 1 := by
  calc
    omega ^ 3 = omega ^ 2 * omega := by ring
    _ = (-1 - omega) * omega := by rw [omega_sq]
    _ = -(omega ^ 2 + omega) := by ring
    _ = 1 := by rw [omega_sq]; ring

private lemma omega_pow_four : omega ^ 4 = omega := by
  calc
    omega ^ 4 = omega ^ 3 * omega := by ring
    _ = omega := by rw [omega_cube]; ring

private lemma omega_pow_five : omega ^ 5 = -1 - omega := by
  calc
    omega ^ 5 = omega ^ 3 * omega ^ 2 := by ring
    _ = -1 - omega := by rw [omega_cube, omega_sq]; ring

private lemma omega_pow_six : omega ^ 6 = 1 := by
  calc
    omega ^ 6 = (omega ^ 3) ^ 2 := by ring
    _ = 1 := by rw [omega_cube]; ring

/-- Powers are indexed cyclically, so negative Fourier exponents use `ZMod`. -/
def character (r : Index) : ℂ := omega ^ r.val

@[simp] private lemma character_zero : character 0 = 1 := rfl
@[simp] private lemma character_one : character 1 = omega := by
  simp [character, ZMod.val_one_eq_one_mod]
@[simp] private lemma character_two : character 2 = omega ^ 2 := rfl

private lemma sum_three (f : Index → ℂ) : ∑ i, f i = f 0 + f 1 + f 2 := by
  exact Fin.sum_univ_three f

/-- Forward transform with the `1/3` normalization and negative exponent. -/
def forward (y : Coordinates) (b k mu : Index) : ℂ :=
  (1 / 3 : ℂ) * ∑ a, y a b k * character (-mu * a)

/-- Inverse transform with positive exponent and no normalization. -/
def inverse (z : Coordinates) (a b k : Index) : ℂ :=
  ∑ mu, z b k mu * character (mu * a)

theorem inverse_forward (y : Coordinates) : inverse (forward y) = y := by
  funext a b k
  rcases index_cases a with rfl | rfl | rfl <;>
    simp [inverse, forward, sum_three, sub_eq_add_neg] <;>
    ring_nf <;>
    simp only [omega_pow_four, omega_cube, omega_sq] <;> ring

theorem forward_inverse (z : Coordinates) : forward (inverse z) = z := by
  funext b k mu
  rcases index_cases mu with rfl | rfl | rfl <;>
    simp [inverse, forward, sum_three, sub_eq_add_neg] <;>
    ring_nf <;>
    simp only [omega_pow_four, omega_cube, omega_sq] <;> ring

/-- Equation (6.6), for the oriented support pair `b, b+1`. -/
def pairEquation (u : Index → Index → ℂ) (y : Coordinates)
    (b a a' : Index) : ℂ :=
  ∑ k, character ((a' - a) * k) *
    (u b k * y a' (b + 1) (k - 1) - u b (k + 1) * y a b k)

/-- Coefficient of `omega^(-beta*a + (beta+mu)*a')`; the final `+1` matters. -/
def modeEquation (u : Index → Index → ℂ) (z : Coordinates)
    (b beta mu : Index) : ℂ :=
  u b beta * z (b + 1) (beta - 1) mu -
    u b (beta + mu + 1) * z b (beta + mu) mu

set_option maxHeartbeats 2000000 in
/-- The two-variable inverse expansion of the original equations. -/
theorem pairEquation_expansion (u : Index → Index → ℂ) (y : Coordinates)
    (b a a' : Index) :
    pairEquation u y b a a' =
      ∑ beta, ∑ mu, modeEquation u (forward y) b beta mu *
        character (-beta * a + (beta + mu) * a') := by
  rcases index_cases a with rfl | rfl | rfl <;>
    rcases index_cases a' with rfl | rfl | rfl <;>
    simp [pairEquation, modeEquation, forward, sum_three, sub_eq_add_neg] <;>
    ring_nf <;>
    simp only [omega_pow_six, omega_pow_five, omega_pow_four, omega_cube, omega_sq] <;>
    ring

set_option maxHeartbeats 2000000 in
/-- The normalized coefficient extraction uses both original phase indices. -/
theorem modeEquation_extraction (u : Index → Index → ℂ) (y : Coordinates)
    (b beta mu : Index) :
    modeEquation u (forward y) b beta mu =
      (1 / 9 : ℂ) * ∑ a, ∑ a', pairEquation u y b a a' *
        character (beta * a - (beta + mu) * a') := by
  rcases index_cases beta with rfl | rfl | rfl <;>
    rcases index_cases mu with rfl | rfl | rfl <;>
    simp [pairEquation, modeEquation, forward, sum_three, sub_eq_add_neg] <;>
    ring_nf <;>
    simp only [omega_pow_six, omega_pow_five, omega_pow_four, omega_cube, omega_sq] <;>
    ring

/-- Vanishing of all original pair equations is equivalent in both directions. -/
theorem pairEquations_iff_modes (u : Index → Index → ℂ) (y : Coordinates) :
    (∀ b a a', pairEquation u y b a a' = 0) ↔
      (∀ b beta mu, modeEquation u (forward y) b beta mu = 0) := by
  constructor
  · intro h b beta mu
    rw [modeEquation_extraction]
    simp only [h, zero_mul, Finset.sum_const_zero, mul_zero]
  · intro h b a a'
    rw [pairEquation_expansion]
    simp only [h, zero_mul, Finset.sum_const_zero]

/-- Exact phase ratio after putting `beta=k+1`; its denominator must be nonzero. -/
def transportFactor (u : Index → Index → ℂ) (b k mu : Index) : ℂ :=
  u b (k + mu + 2) / u b (k + 1)

/-- The cyclic recurrence, without imposing any resonance or genericity condition. -/
def SatisfiesRecurrence (u : Index → Index → ℂ) (z : Coordinates) : Prop :=
  ∀ b k mu, z (b + 1) k mu = transportFactor u b k mu * z b (k + mu + 1) mu

theorem modeEquations_iff_recurrence (u : Index → Index → ℂ)
    (hu : ∀ b k, u b k ≠ 0) (z : Coordinates) :
    (∀ b beta mu, modeEquation u z b beta mu = 0) ↔ SatisfiesRecurrence u z := by
  constructor
  · intro h b k mu
    have hc := sub_eq_zero.mp (h b (k + 1) mu)
    change u b (k + 1) * z (b + 1) (k + 1 - 1) mu =
      u b (k + 1 + mu + 1) * z b (k + 1 + mu) mu at hc
    have h₁ : k + 1 - 1 = k := by ring
    have h₂ : k + 1 + mu + 1 = k + mu + 2 := by ring
    have h₃ : k + 1 + mu = k + mu + 1 := by ring
    rw [h₁, h₂, h₃] at hc
    dsimp [transportFactor]
    apply (mul_left_cancel₀ (hu b (k + 1)))
    calc
      u b (k + 1) * z (b + 1) k mu =
          u b (k + mu + 2) * z b (k + mu + 1) mu := hc
      _ = u b (k + 1) *
          (u b (k + mu + 2) / u b (k + 1) * z b (k + mu + 1) mu) := by
        field_simp [hu b (k + 1)]
  · intro h b beta mu
    have hc := h b (beta - 1) mu
    have h₁ : beta - 1 + 1 = beta := by ring
    have h₂ : beta - 1 + mu + 2 = beta + mu + 1 := by ring
    have h₃ : beta - 1 + mu + 1 = beta + mu := by ring
    dsimp [transportFactor] at hc
    rw [h₁, h₂, h₃] at hc
    dsimp [modeEquation]
    rw [hc]
    field_simp [hu b beta]
    ring

/-- Full transport of (6.6) to the phase recurrence, for every coordinate array. -/
theorem pairEquations_iff_recurrence (u : Index → Index → ℂ)
    (hu : ∀ b k, u b k ≠ 0) (y : Coordinates) :
    (∀ b a a', pairEquation u y b a a' = 0) ↔
      SatisfiesRecurrence u (forward y) :=
  (pairEquations_iff_modes u y).trans (modeEquations_iff_recurrence u hu (forward y))

/-- Every recurrence solution reconstructs a solution of the original equations. -/
theorem inverse_pairEquations_iff_recurrence (u : Index → Index → ℂ)
    (hu : ∀ b k, u b k ≠ 0) (z : Coordinates) :
    (∀ b a a', pairEquation u (inverse z) b a a' = 0) ↔
      SatisfiesRecurrence u z := by
  simpa only [forward_inverse] using pairEquations_iff_recurrence u hu (inverse z)

/-- The diagonal factors for the normalized monomial representatives. -/
def phaseEntry (d : Index → ℂ) (b k : Index) : ℂ := if b = 2 then d k else 1

/-- The coefficient of `diag(u) X` in `D_b* X D_(b+1)`. -/
def phaseWeight (d : Index → ℂ) (b k : Index) : ℂ :=
  star (phaseEntry d b k) * phaseEntry d (b + 1) (k - 1)

lemma phaseWeight_ne_zero (d : Index → ℂ) (hd : ∀ k, d k ≠ 0) (b k : Index) :
    phaseWeight d b k ≠ 0 := by
  have he : ∀ b k, phaseEntry d b k ≠ 0 := by
    intro b k
    dsimp [phaseEntry]
    split_ifs <;> simp_all
  exact mul_ne_zero (star_ne_zero.mpr (he b k)) (he (b + 1) (k - 1))

/-- Unit phases supply the nonzero weights required by Fourier transport. -/
theorem phasePairEquations_iff_recurrence (d : Index → ℂ)
    (hd : ∀ k, Complex.normSq (d k) = 1) (y : Coordinates) :
    (∀ b a a', pairEquation (phaseWeight d) y b a a' = 0) ↔
      SatisfiesRecurrence (phaseWeight d) (forward y) := by
  have hn : ∀ k, d k ≠ 0 := by
    intro k hk
    have := hd k
    simp [hk] at this
  exact pairEquations_iff_recurrence _ (phaseWeight_ne_zero d hn) y

end UnitaryErrorBases.ThreeCycleFourier


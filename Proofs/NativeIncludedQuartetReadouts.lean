/-
# Literal twelve complex projectors and finite matrix reconstruction

The labels are three coordinate projectors and, in frame 1+s,
(1/3) v vᴴ with v=(1,omega^t,omega^(s-t)), s,t in Z/3. They are explicit
matrices; no mutually-unbiased-bases hypothesis is assumed.

Complete-MUB reconstruction is classical: Parthasarathy quant-ph/0408069
Theorem2.4(i), and Klappenecker–Rötteler quant-ph/0502031 Theorem3/Remark2
(complete MUBs are 2-designs). The exact literal binder and arbitrary-complex
matrix identity below are finite application proofs, not a novelty claim.
The projectors are the complex quartet in CKM arXiv:1308.3188v4 §8.2 and
the native labelled construction recorded in MASTER6.3.

The existing omega/character declarations and their proof source are reused
from the first-party FourierTransport module, not redefined. All new
matrix definitions and proof terms here are locally authored. Mathlib at
065356127b1dc0016f66b7283ce0ce2c4055aa55 is imported without source copying
or modification; its Apache-2.0 provenance is retained in the input module.
Thanks to the Lean and mathlib contributors and the classical source authors.
“If I have seen further it is by standing on the sholders of Giants.” — Isaac Newton, letter to Robert Hooke, 1676.
Quotation source: https://www.newtonproject.ox.ac.uk/view/texts/normalized/OTHE00018
-/


@[expose] public section
noncomputable section

namespace UnitaryErrorBases.ComplexQuartet

open scoped BigOperators
open ThreeCycleFourier

abbrev PhaseIndex := ThreeCycleFourier.Index
abbrev ComplexMatrix3 := Matrix (Fin 3) (Fin 3) ℂ

private theorem phase_index_cases (i : PhaseIndex) : i = 0 ∨ i = 1 ∨ i = 2 := by
  exact (by decide : ∀ j : PhaseIndex, j = 0 ∨ j = 1 ∨ j = 2) i

private theorem matrix_index_cases (i : Fin 3) : i = 0 ∨ i = 1 ∨ i = 2 := by
  exact (by decide : ∀ j : Fin 3, j = 0 ∨ j = 1 ∨ j = 2) i

private theorem phase_sum_three (f : PhaseIndex → ℂ) :
    (∑ t, f t) = f 0 + f 1 + f 2 := by
  exact Fin.sum_univ_three f

@[simp] private theorem phase_two_val : (2 : PhaseIndex).val = 2 := by decide
@[simp] private theorem phase_two_ne_zero : (2 : PhaseIndex) ≠ 0 := by decide
@[simp] private theorem phase_two_ne_one : (2 : PhaseIndex) ≠ 1 := by decide
@[simp] private theorem phase_four_eq_one : (4 : PhaseIndex) = 1 := by decide
@[simp] private theorem phase_neg_one : -(1 : PhaseIndex) = 2 := by decide
@[simp] private theorem phase_neg_two : -(2 : PhaseIndex) = 1 := by decide
@[simp] private theorem phase_one_sub_two : (1 : PhaseIndex) - 2 = 2 := by decide
@[simp] private theorem phase_two_sub_one : (2 : PhaseIndex) - 1 = 1 := by decide
@[simp] private theorem phase_two_mul_two : (2 : PhaseIndex) * 2 = 1 := by decide

private theorem character_value (r : PhaseIndex) :
    character r = if r = 0 then 1 else if r = 1 then omega else omega ^ 2 := by
  rcases phase_index_cases r with rfl | rfl | rfl <;>
    norm_num [ThreeCycleFourier.character, ZMod.val_one_eq_one_mod]

/-- The three coordinate rank-one projectors, labelled by their nonzero entry. -/
def coordinateProjector (t : Fin 3) : ComplexMatrix3 :=
  Matrix.diagonal (fun j => if j = t then 1 else 0)

/-- The literal ray in frame 1+s, with outcome t in the fixed code labels. -/
def phaseRay (s t : PhaseIndex) : Fin 3 → ℂ :=
  ![1, character t, character (s - t)]

/-- The nine normalized outer products; the adjoint is part of the definition. -/
def phaseProjector (s t : PhaseIndex) : ComplexMatrix3 :=
  (1 / 3 : ℂ) • Matrix.vecMulVec (phaseRay s t) (star (phaseRay s t))

private theorem coordinateProjector_apply (t row column : Fin 3) :
    coordinateProjector t row column =
      if row = column then (if row = t then 1 else 0) else 0 := by
  rw [coordinateProjector, Matrix.diagonal_apply]

private theorem phaseProjector_apply (s t : PhaseIndex) (row column : Fin 3) :
    phaseProjector s t row column =
      (1 / 3 : ℂ) * (phaseRay s t row * star (phaseRay s t column)) := by
  rw [phaseProjector, Matrix.smul_apply, Matrix.vecMulVec_apply] <;> rfl

private theorem omega_star : star omega = omega ^ 2 := by
  rw [ThreeCycleFourier.omega_sq]
  apply Complex.ext <;>
    norm_num [ThreeCycleFourier.omega, Complex.mul_re, Complex.mul_im] <;> ring

private theorem negative_omega_star : star (-1 - omega) = omega := by
  rw [star_sub, star_neg, star_one, omega_star, ThreeCycleFourier.omega_sq]
  ring

private theorem omega_pow_four : omega ^ 4 = omega := by
  calc
    omega ^ 4 = omega ^ 3 * omega := by ring
    _ = omega := by rw [ThreeCycleFourier.omega_cube, one_mul]

private theorem omega_pow_five : omega ^ 5 = omega ^ 2 := by
  calc
    omega ^ 5 = omega ^ 3 * omega ^ 2 := by ring
    _ = omega ^ 2 := by rw [ThreeCycleFourier.omega_cube, one_mul]

private theorem omega_pow_six : omega ^ 6 = 1 := by
  calc
    omega ^ 6 = omega ^ 3 * omega ^ 3 := by ring
    _ = 1 := by simp [ThreeCycleFourier.omega_cube]

private theorem omega_pow_seven : omega ^ 7 = omega := by
  calc
    omega ^ 7 = omega ^ 6 * omega := by ring
    _ = omega := by rw [omega_pow_six, one_mul]

private theorem omega_pow_eight : omega ^ 8 = omega ^ 2 := by
  calc
    omega ^ 8 = omega ^ 6 * omega ^ 2 := by ring
    _ = omega ^ 2 := by rw [omega_pow_six, one_mul]

/-- The three-term character sum for the existing primitive cube root. -/
theorem finite_character_sum (r : PhaseIndex) :
    (∑ t : PhaseIndex, character (r * t)) = if r = 0 then 3 else 0 := by
  rcases phase_index_cases r with rfl | rfl | rfl
  · norm_num [phase_sum_three, character_value, ThreeCycleFourier.omega_sq]
  · norm_num [phase_sum_three, character_value, ThreeCycleFourier.omega_sq] <;> ring
  · norm_num [phase_sum_three, character_value, ThreeCycleFourier.omega_sq]
    simp only [if_neg (show (4 : PhaseIndex) ≠ 0 by decide),
      if_pos (show (4 : PhaseIndex) = 1 by decide)]
    ring

theorem coordinateProjector_isHermitian (t : Fin 3) :
    (coordinateProjector t).IsHermitian := by
  apply Matrix.IsHermitian.ext
  intro row column
  fin_cases t <;> fin_cases row <;> fin_cases column <;>
    norm_num [coordinateProjector, Matrix.diagonal_apply]

theorem phaseProjector_isHermitian (s t : PhaseIndex) :
    (phaseProjector s t).IsHermitian := by
  change (phaseProjector s t).conjTranspose = phaseProjector s t
  simp [phaseProjector, Matrix.conjTranspose_smul, Matrix.conjTranspose_vecMulVec]

theorem coordinateProjector_trace (t : Fin 3) :
    (coordinateProjector t).trace = 1 := by
  fin_cases t <;> norm_num [coordinateProjector, Matrix.trace_fin_three]

set_option maxHeartbeats 2000000 in
theorem phaseProjector_trace (s t : PhaseIndex) :
    (phaseProjector s t).trace = 1 := by
  simp only [Matrix.trace_fin_three, phaseProjector_apply]
  rcases phase_index_cases s with rfl | rfl | rfl <;>
    rcases phase_index_cases t with rfl | rfl | rfl <;>
    norm_num [phaseRay, character_value, omega_star, ThreeCycleFourier.omega_sq] <;>
    (try simp only [if_neg (show (4 : PhaseIndex) ≠ 0 by decide),
      if_pos (show (4 : PhaseIndex) = 1 by decide),
      if_neg (show -(1 : PhaseIndex) ≠ 1 by decide),
      if_pos (show -(2 : PhaseIndex) = 1 by decide),
      starRingEnd_apply, negative_omega_star, omega_star, ThreeCycleFourier.omega_sq]) <;>
    ring_nf (ifUnchanged := .silent) <;>
    (try simp only [omega_pow_eight, omega_pow_seven, omega_pow_six,
      omega_pow_five, omega_pow_four, ThreeCycleFourier.omega_cube,
      ThreeCycleFourier.omega_sq]) <;> ring1

theorem coordinateProjector_sum :
    (∑ t : Fin 3, coordinateProjector t) = (1 : ComplexMatrix3) := by
  apply Matrix.ext
  intro row column
  fin_cases row <;> fin_cases column <;>
    norm_num [coordinateProjector, Fin.sum_univ_three, Matrix.sum_apply,
      Matrix.diagonal_apply, Matrix.one_apply]

set_option maxHeartbeats 2000000 in
theorem phaseProjector_sum (s : PhaseIndex) :
    (∑ t : PhaseIndex, phaseProjector s t) = (1 : ComplexMatrix3) := by
  apply Matrix.ext
  intro row column
  simp only [Matrix.sum_apply, phase_sum_three, phaseProjector_apply, Matrix.one_apply]
  rcases phase_index_cases s with rfl | rfl | rfl <;>
    rcases matrix_index_cases row with rfl | rfl | rfl <;>
    rcases matrix_index_cases column with rfl | rfl | rfl <;>
    norm_num [phaseRay, character_value, omega_star, ThreeCycleFourier.omega_sq] <;>
    (try simp only [if_neg (show (4 : PhaseIndex) ≠ 0 by decide),
      if_pos (show (4 : PhaseIndex) = 1 by decide),
      if_neg (show -(1 : PhaseIndex) ≠ 1 by decide),
      if_pos (show -(2 : PhaseIndex) = 1 by decide),
      starRingEnd_apply, negative_omega_star, omega_star, ThreeCycleFourier.omega_sq]) <;>
    ring_nf (ifUnchanged := .silent) <;>
    (try simp only [omega_pow_eight, omega_pow_seven, omega_pow_six,
      omega_pow_five, omega_pow_four, ThreeCycleFourier.omega_cube,
      ThreeCycleFourier.omega_sq]) <;> ring1

set_option maxHeartbeats 2000000 in
/-- Complex-linear reconstruction from exactly the three coordinate and nine
literal phase projectors. No Hermitian or positivity hypothesis on A occurs. -/
theorem literal_quartet_reconstruction (A : ComplexMatrix3) :
    (∑ t : Fin 3, (A * coordinateProjector t).trace • coordinateProjector t) +
        (∑ s : PhaseIndex, ∑ t : PhaseIndex,
          (A * phaseProjector s t).trace • phaseProjector s t) =
      A + A.trace • (1 : ComplexMatrix3) := by
  obtain ⟨a, rfl⟩ : ∃ a : Fin 3 → Fin 3 → ℂ, A = Matrix.of a :=
    ⟨Matrix.of.symm A, rfl⟩
  apply Matrix.ext
  intro row column
  simp only [Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply,
    Matrix.trace_fin_three, Matrix.mul_apply, phase_sum_three, Fin.sum_univ_three,
    coordinateProjector_apply, phaseProjector_apply, Matrix.of_apply,
    Matrix.one_apply, smul_eq_mul]
  rcases matrix_index_cases row with rfl | rfl | rfl <;>
    rcases matrix_index_cases column with rfl | rfl | rfl <;>
    norm_num [phaseRay, character_value, omega_star, ThreeCycleFourier.omega_sq] <;>
    (try simp only [if_neg (show (4 : PhaseIndex) ≠ 0 by decide),
      if_pos (show (4 : PhaseIndex) = 1 by decide),
      if_neg (show -(1 : PhaseIndex) ≠ 1 by decide),
      if_pos (show -(2 : PhaseIndex) = 1 by decide),
      starRingEnd_apply, negative_omega_star, omega_star, ThreeCycleFourier.omega_sq]) <;>
    ring_nf (ifUnchanged := .silent) <;>
    (try simp only [omega_pow_eight, omega_pow_seven, omega_pow_six,
      omega_pow_five, omega_pow_four, ThreeCycleFourier.omega_cube,
      ThreeCycleFourier.omega_sq]) <;> ring1

end UnitaryErrorBases.ComplexQuartet


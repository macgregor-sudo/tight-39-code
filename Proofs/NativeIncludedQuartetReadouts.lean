@[expose] public section
noncomputable section

namespace CompactAlbert

/-- Under exactly UU*=I the adjugate fixed-point condition is determinant one.
Both directions use polynomial adjugate products, with no inverse hypothesis. -/
theorem adjugate_conjTranspose_eq_iff_det_eq_one (U : TitsComplexMatrix)
    (hU : U * U.conjTranspose = (1 : TitsComplexMatrix)) :
    U.adjugate.conjTranspose = U ↔ U.det = 1 := by
  constructor
  · intro hsharp
    have hs : U.adjugate = U.conjTranspose := by
      have h := congrArg (fun M : TitsComplexMatrix => M.conjTranspose) hsharp
      simpa only [Matrix.conjTranspose_conjTranspose] using h
    have hd : U.det • (1 : TitsComplexMatrix) = (1 : TitsComplexMatrix) := by
      calc
        U.det • (1 : TitsComplexMatrix) = U * U.adjugate := (Matrix.mul_adjugate U).symm
        _ = U * U.conjTranspose := by rw [hs]
        _ = 1 := hU
    have h00 := congrArg (fun M : TitsComplexMatrix => M 0 0) hd
    simpa [Matrix.smul_apply, smul_eq_mul] using h00
  · intro hdet
    have hleft : U.adjugate * U = (1 : TitsComplexMatrix) := by
      simpa only [hdet, one_smul] using Matrix.adjugate_mul U
    have hs : U.adjugate = U.conjTranspose := by
      calc
        U.adjugate = U.adjugate * (U * U.conjTranspose) := by rw [hU, mul_one]
        _ = (U.adjugate * U) * U.conjTranspose := (Matrix.mul_assoc _ _ _).symm
        _ = U.conjTranspose := by rw [hleft, one_mul]
    have h := congrArg (fun M : TitsComplexMatrix => M.conjTranspose) hs
    simpa only [Matrix.conjTranspose_conjTranspose] using h

/-- Exact entrywise scaling from B to U=3B, including the quadratic adjugate.
No determinant, inverse or hidden rank assumption is used in this adapter. -/
theorem tits_rows_iff_scaled_unitary_adjugate_conditions (B : TitsComplexMatrix) :
    (B * B.conjTranspose = (1 / 9 : ℂ) • (1 : TitsComplexMatrix) ∧
      B.adjugate.conjTranspose = (1 / 3 : ℂ) • B) ↔
      ((3 : ℂ) • B) * ((3 : ℂ) • B).conjTranspose = (1 : TitsComplexMatrix) ∧
        ((3 : ℂ) • B).adjugate.conjTranspose = (3 : ℂ) • B := by
  constructor
  · rintro ⟨hB, hsharp⟩
    constructor
    · norm_num [Matrix.conjTranspose_smul, Matrix.smul_mul, Matrix.mul_smul,
        smul_smul, hB]
    · norm_num [Matrix.adjugate_smul, Matrix.conjTranspose_smul,
        smul_smul, hsharp]
  · rintro ⟨hU, hsharp⟩
    have hB := congrArg (fun M : TitsComplexMatrix => (1 / 9 : ℂ) • M) hU
    have hs := congrArg (fun M : TitsComplexMatrix => (1 / 9 : ℂ) • M) hsharp
    norm_num [Matrix.conjTranspose_smul, Matrix.smul_mul, Matrix.mul_smul,
      smul_smul] at hB
    norm_num [Matrix.adjugate_smul, Matrix.conjTranspose_smul, smul_smul] at hs
    exact ⟨hB, hs⟩

/-- The normalized B-row equations are exactly UU*=I and det U=1 for U=3B.
These explicit conditions agree with the ordinary special-unitary convention;
no bundled group or additional subgroup structure is introduced. -/
theorem tits_rows_iff_scaled_specialUnitary_conditions (B : TitsComplexMatrix) :
    (B * B.conjTranspose = (1 / 9 : ℂ) • (1 : TitsComplexMatrix) ∧
      B.adjugate.conjTranspose = (1 / 3 : ℂ) • B) ↔
      ((3 : ℂ) • B) * ((3 : ℂ) • B).conjTranspose = (1 : TitsComplexMatrix) ∧
        ((3 : ℂ) • B).det = 1 := by
  rw [tits_rows_iff_scaled_unitary_adjugate_conditions]
  constructor
  · rintro ⟨hU, hsharp⟩
    exact ⟨hU, (adjugate_conjTranspose_eq_iff_det_eq_one ((3 : ℂ) • B) hU).mp hsharp⟩
  · rintro ⟨hU, hdet⟩
    exact ⟨hU, (adjugate_conjTranspose_eq_iff_det_eq_one ((3 : ℂ) • B) hU).mpr hdet⟩

/-- Actual native idempotency at visible I/3 is the explicit scaled
special-unitary conjunction. The native trace-one conclusion is already
proved in Stage A. Deriving visible I/3 from anchor unbiasedness is separate. -/
theorem native_idempotent_iff_scaled_specialUnitary_conditions (x : Glennie.Albert)
    (ha : hermitianMatrix (toTitsCoordinates x) =
      (1 / 3 : ℂ) • (1 : TitsComplexMatrix)) :
    Glennie.jordan x x = x ↔
      ((3 : ℂ) • (toTitsCoordinates x).2.2) *
          ((3 : ℂ) • (toTitsCoordinates x).2.2).conjTranspose =
            (1 : TitsComplexMatrix) ∧
        ((3 : ℂ) • (toTitsCoordinates x).2.2).det = 1 := by
  exact (native_idempotent_iff_tits_rows_of_visible_third x ha).trans
    (tits_rows_iff_scaled_specialUnitary_conditions ((toTitsCoordinates x).2.2))

end CompactAlbert


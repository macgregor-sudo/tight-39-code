  let B : TitsComplexMatrix := (toTitsCoordinates x).2.2
  let c : TitsComplexMatrix := hermitianMatrix (toTitsCoordinates y)
  let D : TitsComplexMatrix := (toTitsCoordinates y).2.2
  have hp : Glennie.trace (Glennie.jordan x y) =
      (compactSecondTitsProductComplex a B c D).trace.re := by
    have h := congrArg (fun p : TitsMatrixPair => p.1.trace.re)
      (native_tits_product_pair x y)
    change (hermitianMatrix (toTitsCoordinates (Glennie.jordan x y))).trace.re =
      (compactSecondTitsProductComplex a B c D).trace.re at h
    rw [hermitianMatrix_trace, Complex.ofReal_re] at h
    exact h
  change Glennie.trace (Glennie.jordan x y) =
    (a * c).trace.re + 2 * (B * D.conjTranspose).trace.re
  rw [hp]
  norm_num [compactSecondTitsProductComplex, Matrix.trace_add,
    Matrix.trace_sub, Matrix.trace_smul, Matrix.trace_one,
    Matrix.trace_mul_comm c a, matrixTrace_pair_re_symm D B,
    smul_eq_mul, Complex.mul_re, Complex.mul_im] <;> ring


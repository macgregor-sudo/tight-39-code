/-! Native B-row square composition, with the existing signed coordinate maps. -/

@[expose] public section
noncomputable section

namespace CompactAlbert

open scoped BigOperators

/-- The scalar coordinate of octonion conjugation. -/
theorem titsScalar_conjugate (x : Glennie.Octonion) :
    (octonionToTitsRow (Glennie.octConj x)).1 = star (octonionToTitsRow x).1 := by
  apply Complex.ext <;> simp [octonionToTitsRow, Glennie.octConj]

/-- Projecting the existing real-linear coordinate equivalence preserves sums. -/
theorem titsRow_add (x y : Glennie.Octonion) :
    (octonionToTitsRow (x + y)).2 =
      (octonionToTitsRow x).2 + (octonionToTitsRow y).2 := by
  exact congrArg Prod.snd (map_add octonionTitsRowEquiv x y)

/-- Projecting the same equivalence preserves real scalar multiplication. -/
theorem titsRow_smul (r : ℝ) (x : Glennie.Octonion) :
    (octonionToTitsRow (r • x)).2 = r • (octonionToTitsRow x).2 := by
  exact congrArg Prod.snd (map_smul octonionTitsRowEquiv r x)

/-- The B-row of octonion conjugation changes sign. -/
theorem titsRow_conjugate (x : Glennie.Octonion) :
    (octonionToTitsRow (Glennie.octConj x)).2 = -(octonionToTitsRow x).2 := by
  funext column
  fin_cases column <;> apply Complex.ext <;>
    simp [octonionToTitsRow, Glennie.octConj]

/-- The generic cofactor identity agrees with the already checked cross-product
orientation. This is an adapter, not a second cross-product definition. -/
theorem adjugate_conjTranspose_eq_complexCross_rows
    (B : Matrix (Fin 3) (Fin 3) ℂ) :
    B.adjugate.conjTranspose =
      ![fun column => star (complexCross3 (B 1) (B 2) column),
        fun column => star (complexCross3 (B 2) (B 0) column),
        fun column => star (complexCross3 (B 0) (B 1) column)] := by
  ext row column
  rw [Matrix.adjugate_conjTranspose_apply_fin_three]
  fin_cases row <;> fin_cases column <;> simp [complexCross3] <;> ring

/-- Hidden component of the actual compact Albert square. The row order is
`(o12, octConj o02, o01)`, and B is `-conj Z`. The positive adjugate term is
unconditional, including singular B. This is not the independent Tits product
theorem: its cubic coefficient and visible component are outside this endpoint. -/
theorem native_tits_hidden_square (x : Glennie.Albert) :
    (toTitsCoordinates (Glennie.jordan x x)).2.2 =
      (((titsTrace (toTitsCoordinates x) : ℂ) •
          (1 : Matrix (Fin 3) (Fin 3) ℂ) -
        hermitianMatrix (toTitsCoordinates x)) * (toTitsCoordinates x).2.2 +
        (toTitsCoordinates x).2.2.adjugate.conjTranspose) := by
  apply Matrix.ext
  intro row column
  change ((toTitsCoordinates (Glennie.jordan x x)).2.2 :
      Matrix (Fin 3) (Fin 3) ℂ) row column =
    ((((titsTrace (toTitsCoordinates x) : ℂ) •
          (1 : Matrix (Fin 3) (Fin 3) ℂ) -
        hermitianMatrix (toTitsCoordinates x)) * (toTitsCoordinates x).2.2 +
        (toTitsCoordinates x).2.2.adjugate.conjTranspose) :
      Matrix (Fin 3) (Fin 3) ℂ) row column
  rw [Matrix.add_apply, Matrix.mul_apply]
  simp only [Matrix.sub_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
  rw [adjugate_conjTranspose_eq_complexCross_rows]
  fin_cases row <;> fin_cases column <;>
    simp [toTitsCoordinates, hermitianMatrix, titsTrace,
      Glennie.jordan_o01, Glennie.jordan_o02, Glennie.jordan_o12,
      titsRow_conjugate, titsScalar_conjugate, titsRow_add, titsRow_smul,
      titsRow_mul, octonionComplexScalar, complexCross3,
      Pi.add_apply, Pi.sub_apply, Pi.smul_apply, Pi.neg_apply, Matrix.one_apply,
      Matrix.mul_apply, Matrix.conjTranspose_apply, Fin.sum_univ_three,
      Complex.real_smul, smul_eq_mul] <;> ring

end CompactAlbert


/-!
# Complex scalar and vector coordinates for compact octonions

Write `x = c + z₁ j + z₂ ℓ + z₃ (jℓ)`, with complex coefficients on the left.
Since `i(jℓ) = -kℓ`, the last component is `x₆ - i x₇`. The following identities
are proved directly from the actual compact Cayley–Dickson multiplication in
`Glennie.Native`. They supply the eight-coordinate multiplication and pairing
steps for the separate native-to-Tits product argument.

The formulas use a bilinear dot product and the usual oriented cross product;
conjugations occur explicitly in each theorem. This is neither a replacement
octonion definition nor a proof of the full Albert product correspondence.

Source: compact-albert-recognition, commit
40d3b344180d9ddb78aaa2876873377c1e631515, `Glennie/Native.lean` (Apache-2.0).
The complex coefficient convention agrees with `Glennie/Sector.lean` at that
pin; this file expands the full multiplication formula and connects it to B-rows.
See `THIRD_PARTY_NOTICES.md#native-albert-code` for retained license and modification notices.

Mathematical provenance: John C. Baez, "The Octonions", author manuscript
dated 16 May 2001, Section 2.2, equations (2)-(3), printed pages 8-9;
published in Bulletin of the AMS 39 (2002). The inspected manuscript and
published edition are not asserted byte-identical. Baez uses
(ac - d * star b, star a * d + c * b); the native
convention is related by (a,b) ↦ (a,star b). The signed complex-vector
formulas below are an explicit coordinate specialization of that classical
construction, not a verbatim theorem of Baez or a novelty claim.
Inspected author manuscript: https://math.ucr.edu/home/baez/octonions/octonions.pdf.
-/

noncomputable section

namespace CompactAlbert

open scoped BigOperators

/-- The complex coefficient of 1 in the fixed left-complex decomposition. -/
def octonionComplexScalar (x : Glennie.Octonion) : ℂ :=
  (octonionToTitsRow x).1

/-- The left-complex coefficients of `(j, ℓ, jℓ)`, including the last sign. -/
def octonionComplexVector (x : Glennie.Octonion) : Fin 3 → ℂ :=
  ![⟨x.1.imJ, x.1.imK⟩, ⟨x.2.re, x.2.imI⟩, ⟨x.2.imJ, -x.2.imK⟩]

/-- Bilinear dot product; conjugation is inserted explicitly by the caller. -/
def complexDot3 (z w : Fin 3 → ℂ) : ℂ :=
  z 0 * w 0 + z 1 * w 1 + z 2 * w 2

/-- The cross product with orientation `(0,1,2)`. -/
def complexCross3 (z w : Fin 3 → ℂ) : Fin 3 → ℂ :=
  ![z 1 * w 2 - z 2 * w 1,
    z 2 * w 0 - z 0 * w 2,
    z 0 * w 1 - z 1 * w 0]

/-- The previously fixed Tits row is exactly `-conj z`. -/
theorem titsRow_eq_neg_conjugate_vector (x : Glennie.Octonion) :
    (octonionToTitsRow x).2 = fun column => -star (octonionComplexVector x column) := by
  funext column
  fin_cases column <;> apply Complex.ext <;>
    simp [octonionToTitsRow, octonionComplexVector]

/-- Scalar part of the classical Cayley–Dickson product in the displayed signed
coordinates; see Baez, Section 2.2, equations (2)-(3), and the convention bridge
in the module documentation. -/
theorem octonionComplexScalar_mul (x y : Glennie.Octonion) :
    octonionComplexScalar (Glennie.octMul x y) =
      octonionComplexScalar x * octonionComplexScalar y -
        complexDot3 (octonionComplexVector x)
          (fun column => star (octonionComplexVector y column)) := by
  apply Complex.ext <;>
    simp [octonionComplexScalar, octonionToTitsRow, octonionComplexVector,
      complexDot3, Glennie.octMul, Quaternion.re_mul, Quaternion.imI_mul,
      Quaternion.imJ_mul, Quaternion.imK_mul, Complex.mul_re, Complex.mul_im] <;>
    ring

/-- Vector part of the same classical Cayley–Dickson multiplication.
The conjugated cross product records the fixed left-complex basis convention. -/
theorem octonionComplexVector_mul (x y : Glennie.Octonion) :
    octonionComplexVector (Glennie.octMul x y) = fun column =>
      octonionComplexScalar x * octonionComplexVector y column +
      star (octonionComplexScalar y) * octonionComplexVector x column +
      star (complexCross3 (octonionComplexVector x) (octonionComplexVector y) column) := by
  funext column
  fin_cases column <;> apply Complex.ext <;>
    simp [octonionComplexScalar, octonionToTitsRow, octonionComplexVector,
      complexCross3, Glennie.octMul, Quaternion.re_mul, Quaternion.imI_mul,
      Quaternion.imJ_mul, Quaternion.imK_mul, Complex.mul_re, Complex.mul_im] <;>
    ring

/-- The classical Euclidean pairing in one complex scalar and three complex
coordinates, specialized to the actual native signed coordinate map. -/
theorem octonion_pairing_complex_coordinates (x y : Glennie.Octonion) :
    Glennie.octDot x y =
      (octonionComplexScalar x * star (octonionComplexScalar y)).re +
        ∑ column : Fin 3,
          (octonionComplexVector x column * star (octonionComplexVector y column)).re := by
  rw [Glennie.octDot_coordinates]
  simp [octonionComplexScalar, octonionToTitsRow, octonionComplexVector,
    Fin.sum_univ_three, Complex.mul_re]
  ring

/-- The classical sum-of-squares norm for the compact Cayley–Dickson construction;
compare Baez, Section 2.2, printed page 9. This fixes our coordinate specialization. -/
theorem octonion_norm_complex_coordinates (x : Glennie.Octonion) :
    Glennie.octNormSq x =
      Complex.normSq (octonionComplexScalar x) +
        ∑ column : Fin 3, Complex.normSq (octonionComplexVector x column) := by
  simp [Glennie.octNormSq, Quaternion.normSq_def', octonionComplexScalar,
    octonionToTitsRow, octonionComplexVector, Complex.normSq_apply,
    Fin.sum_univ_three]
  ring

/-- Actual native multiplication in the already fixed Tits rows.
This is the preceding classical vector identity rewritten using `b = -conj z`;
the cross-product term therefore has a minus sign. -/
theorem titsRow_mul (x y : Glennie.Octonion) :
    (octonionToTitsRow (Glennie.octMul x y)).2 = fun column =>
      star (octonionComplexScalar x) * (octonionToTitsRow y).2 column +
      octonionComplexScalar y * (octonionToTitsRow x).2 column -
      star (complexCross3 (octonionToTitsRow x).2 (octonionToTitsRow y).2 column) := by
  rw [titsRow_eq_neg_conjugate_vector, octonionComplexVector_mul]
  funext column
  fin_cases column <;> apply Complex.ext <;>
    simp [octonionComplexScalar, octonionToTitsRow, octonionComplexVector,
      complexCross3, Complex.mul_re, Complex.mul_im] <;> ring

end CompactAlbert


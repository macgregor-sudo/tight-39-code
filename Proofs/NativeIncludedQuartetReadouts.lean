/-!
# Explicit compact Albert coordinates

The native domain is `Glennie.Albert`, with upper octonion entries `(o01, o02, o12)`.
The cyclic entries used here are `(o12, octConj o02, o01)`. Each octonion is written
as `c + z₁ j + z₂ ℓ + z₃ (jℓ)` with left complex coefficients; `i(jℓ) = -kℓ`.
The corresponding row of the Tits matrix is `-conj z`.

This file constructs the real-linear coordinate equivalence and preserves the
native unit and trace. The displayed Hermitian matrix is a separate, explicit
map. No Jordan product is defined by transport and no product-preservation
theorem is asserted here.

Source attribution: the imported native model is from compact-albert-recognition,
commit 40d3b344180d9ddb78aaa2876873377c1e631515, `Glennie/Native.lean` (Apache-2.0).
The Hermitian-matrix inverse proof adapts the entrywise argument in that commit's
`Glennie/SectorModel.lean`, changing its upper-entry coordinates to cyclic entries.
See `THIRD_PARTY_NOTICES.md#native-albert-code` and the preserved upstream license and notices.
-/

noncomputable section

namespace CompactAlbert

open scoped Quaternion

/-- Three real diagonals, three cyclic complex scalars, and the Tits matrix B. -/
abbrev TitsCoordinates :=
  (Fin 3 → ℝ) × (Fin 3 → ℂ) × Matrix (Fin 3) (Fin 3) ℂ

/-- An octonion encoded by its complex scalar and the row `-conj z` of B.
The negative imaginary part in the last entry records `i(jℓ) = -kℓ`. -/
def octonionToTitsRow (x : Glennie.Octonion) : ℂ × (Fin 3 → ℂ) :=
  (⟨x.1.re, x.1.imI⟩,
    ![⟨-x.1.imJ, x.1.imK⟩, ⟨-x.2.re, x.2.imI⟩, ⟨-x.2.imJ, -x.2.imK⟩])

/-- Recover the native quaternion pair from one complex scalar and one B-row. -/
def octonionFromTitsRow (p : ℂ × (Fin 3 → ℂ)) : Glennie.Octonion :=
  (⟨p.1.re, p.1.im, -(p.2 0).re, (p.2 0).im⟩,
    ⟨-(p.2 1).re, (p.2 1).im, -(p.2 2).re, -(p.2 2).im⟩)

@[simp] theorem octonionFromTitsRow_toTitsRow (x : Glennie.Octonion) :
    octonionFromTitsRow (octonionToTitsRow x) = x := by
  apply Prod.ext <;> apply Quaternion.ext <;>
    simp [octonionFromTitsRow, octonionToTitsRow]

@[simp] theorem octonionToTitsRow_fromTitsRow (p : ℂ × (Fin 3 → ℂ)) :
    octonionToTitsRow (octonionFromTitsRow p) = p := by
  apply Prod.ext
  · apply Complex.ext <;> rfl
  · funext column
    fin_cases column <;> apply Complex.ext <;>
      simp [octonionFromTitsRow, octonionToTitsRow]

/-- The single-octonion change of coordinates is real-linear, including its signs. -/
def octonionTitsRowEquiv : Glennie.Octonion ≃ₗ[ℝ] ℂ × (Fin 3 → ℂ) where
  toFun := octonionToTitsRow
  invFun := octonionFromTitsRow
  left_inv := octonionFromTitsRow_toTitsRow
  right_inv := octonionToTitsRow_fromTitsRow
  map_add' x y := by
    apply Prod.ext
    · apply Complex.ext <;> simp [octonionToTitsRow]
    · funext column
      fin_cases column <;> apply Complex.ext <;>
        simp [octonionToTitsRow, neg_add, add_comm]
  map_smul' r x := by
    apply Prod.ext
    · apply Complex.ext <;> simp [octonionToTitsRow, smul_eq_mul]
    · funext column
      fin_cases column <;> apply Complex.ext <;>
        simp [octonionToTitsRow, smul_eq_mul]

/-- Cyclic slot 1 occupies zero-based row 0, and similarly for slots 2 and 3. -/
def toTitsCoordinates (x : Glennie.Albert) : TitsCoordinates :=
  let first := octonionToTitsRow x.o12
  let second := octonionToTitsRow (Glennie.octConj x.o02)
  let third := octonionToTitsRow x.o01
  (![x.d0, x.d1, x.d2], ![first.1, second.1, third.1],
    ![first.2, second.2, third.2])

/-- The native upper entry o02 is the conjugate of cyclic slot 2. -/
def fromTitsCoordinates (q : TitsCoordinates) : Glennie.Albert :=
  let first := octonionFromTitsRow (q.2.1 0, q.2.2 0)
  let second := octonionFromTitsRow (q.2.1 1, q.2.2 1)
  let third := octonionFromTitsRow (q.2.1 2, q.2.2 2)
  ⟨q.1 0, q.1 1, q.1 2, third, Glennie.octConj second, first⟩

@[simp] theorem fromTitsCoordinates_toTitsCoordinates (x : Glennie.Albert) :
    fromTitsCoordinates (toTitsCoordinates x) = x := by
  apply Glennie.Albert.extExplicit <;>
    simp [fromTitsCoordinates, toTitsCoordinates]

@[simp] theorem toTitsCoordinates_fromTitsCoordinates (q : TitsCoordinates) :
    toTitsCoordinates (fromTitsCoordinates q) = q := by
  apply Prod.ext
  · funext row
    fin_cases row <;> simp [toTitsCoordinates, fromTitsCoordinates]
  · apply Prod.ext
    · funext row
      fin_cases row <;> simp [toTitsCoordinates, fromTitsCoordinates]
    · funext row
      fin_cases row <;> simp [toTitsCoordinates, fromTitsCoordinates]

/-- Real-linearity of the forward adapter, before packaging the equivalence. -/
theorem toTitsCoordinates_add (x y : Glennie.Albert) :
    toTitsCoordinates (x + y) = toTitsCoordinates x + toTitsCoordinates y := by
  have row_add (a b : Glennie.Octonion) :
      octonionToTitsRow (a + b) = octonionToTitsRow a + octonionToTitsRow b :=
    octonionTitsRowEquiv.map_add a b
  apply Prod.ext
  · funext row
    fin_cases row <;> simp [toTitsCoordinates]
  · apply Prod.ext
    · funext row
      fin_cases row <;> simp [toTitsCoordinates, row_add]
    · funext row column
      change (toTitsCoordinates (x + y)).2.2 row column =
        (toTitsCoordinates x).2.2 row column + (toTitsCoordinates y).2.2 row column
      fin_cases row <;> simp [toTitsCoordinates, row_add]

theorem toTitsCoordinates_smul (r : ℝ) (x : Glennie.Albert) :
    toTitsCoordinates (r • x) = r • toTitsCoordinates x := by
  have row_smul (a : Glennie.Octonion) :
      octonionToTitsRow (r • a) = r • octonionToTitsRow a :=
    octonionTitsRowEquiv.map_smul r a
  apply Prod.ext
  · funext row
    fin_cases row <;> simp [toTitsCoordinates, smul_eq_mul]
  · apply Prod.ext
    · funext row
      fin_cases row <;> simp [toTitsCoordinates, row_smul]
    · funext row column
      change (toTitsCoordinates (r • x)).2.2 row column =
        r • (toTitsCoordinates x).2.2 row column
      fin_cases row <;> simp [toTitsCoordinates, row_smul]

/-- An explicit real-linear equivalence from the actual native compact Albert type. -/
def compactTitsCoordinateEquiv : Glennie.Albert ≃ₗ[ℝ] TitsCoordinates where
  toFun := toTitsCoordinates
  invFun := fromTitsCoordinates
  left_inv := fromTitsCoordinates_toTitsCoordinates
  right_inv := toTitsCoordinates_fromTitsCoordinates
  map_add' := toTitsCoordinates_add
  map_smul' := toTitsCoordinates_smul

/-- Coordinates of `(I, 0)` in the Tits model. -/
def titsUnit : TitsCoordinates := (fun _ => 1, 0, 0)

/-- The real trace is the sum of the three diagonal coordinates. -/
def titsTrace (q : TitsCoordinates) : ℝ := q.1 0 + q.1 1 + q.1 2

@[simp] theorem compactTitsCoordinateEquiv_unit :
    compactTitsCoordinateEquiv (1 : Glennie.Albert) = titsUnit := by
  apply Prod.ext
  · funext row
    fin_cases row <;> simp [compactTitsCoordinateEquiv, toTitsCoordinates, titsUnit]
  · apply Prod.ext
    · funext row
      fin_cases row <;> apply Complex.ext <;>
        simp [compactTitsCoordinateEquiv, toTitsCoordinates, titsUnit,
          octonionToTitsRow, Glennie.octConj]
    · funext row column
      fin_cases row <;> fin_cases column <;> apply Complex.ext <;>
        simp [compactTitsCoordinateEquiv, toTitsCoordinates, titsUnit,
          octonionToTitsRow, Glennie.octConj]

@[simp] theorem compactTitsCoordinateEquiv_trace (x : Glennie.Albert) :
    titsTrace (compactTitsCoordinateEquiv x) = Glennie.trace x := rfl

/-- The Hermitian component has upper entries `(c₃, conj c₂, c₁)`.
The cyclic scalar vector is indexed from zero. -/
def hermitianMatrix (q : TitsCoordinates) : Matrix (Fin 3) (Fin 3) ℂ :=
  !![(q.1 0 : ℂ), q.2.1 2, star (q.2.1 1);
    star (q.2.1 2), (q.1 1 : ℂ), q.2.1 0;
    q.2.1 1, star (q.2.1 0), (q.1 2 : ℂ)]

theorem hermitianMatrix_isHermitian (q : TitsCoordinates) :
    (hermitianMatrix q).IsHermitian := by
  ext row column
  fin_cases row <;> fin_cases column <;>
    simp [hermitianMatrix, Matrix.conjTranspose_apply]

/-- The actual Hermitian-matrix subtype, paired with an arbitrary complex matrix. -/
abbrev HermitianTitsPair :=
  {a : Matrix (Fin 3) (Fin 3) ℂ // a.IsHermitian} × Matrix (Fin 3) (Fin 3) ℂ

/-- The raw matrix pair underlying the Tits coordinates. -/
def toMatrixPair (q : TitsCoordinates) :
    Matrix (Fin 3) (Fin 3) ℂ × Matrix (Fin 3) (Fin 3) ℂ :=
  (hermitianMatrix q, q.2.2)

/-- The Hermitian condition is proved, rather than imposed as a caller assumption. -/
def toHermitianPair (q : TitsCoordinates) : HermitianTitsPair :=
  (⟨hermitianMatrix q, hermitianMatrix_isHermitian q⟩, q.2.2)

/-- Recover cyclic scalars from positions `(1,2), (2,0), (0,1)` of a Hermitian matrix. -/
def fromHermitianPair (p : HermitianTitsPair) : TitsCoordinates :=
  (![(p.1.val 0 0).re, (p.1.val 1 1).re, (p.1.val 2 2).re],
    ![p.1.val 1 2, p.1.val 2 0, p.1.val 0 1], p.2)

@[simp] theorem fromHermitianPair_toHermitianPair (q : TitsCoordinates) :
    fromHermitianPair (toHermitianPair q) = q := by
  apply Prod.ext
  · funext row
    fin_cases row <;> simp [fromHermitianPair, toHermitianPair, hermitianMatrix]
  · apply Prod.ext
    · funext row
      fin_cases row <;> simp [fromHermitianPair, toHermitianPair, hermitianMatrix]
    · rfl

@[simp] theorem toHermitianPair_fromHermitianPair (p : HermitianTitsPair) :
    toHermitianPair (fromHermitianPair p) = p := by
  have conjugate_entry (row column : Fin 3) :
      star (p.1.val column row) = p.1.val row column :=
    congrFun (congrFun p.1.property row) column
  have real_diagonal (row : Fin 3) :
      ((p.1.val row row).re : ℂ) = p.1.val row row := by
    apply Complex.ext
    · simp
    · have conjugate_im := congrArg Complex.im (conjugate_entry row row)
      simp at conjugate_im ⊢
      linarith
  apply Prod.ext
  · apply Subtype.ext
    ext row column
    fin_cases row <;> fin_cases column <;>
      simp [toHermitianPair, fromHermitianPair, hermitianMatrix,
        real_diagonal, conjugate_entry]
  · rfl

/-- This equivalence identifies the coordinate carrier with the actual Hermitian pair.
Real-linear structure on the Hermitian subtype remains a separate interface. -/
def titsHermitianPairEquiv : TitsCoordinates ≃ HermitianTitsPair where
  toFun := toHermitianPair
  invFun := fromHermitianPair
  left_inv := fromHermitianPair_toHermitianPair
  right_inv := toHermitianPair_fromHermitianPair

end CompactAlbert

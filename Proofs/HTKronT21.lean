module

public import HTKronLists

@[expose] public section

/-!
# T component (2, 1): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 422 rows are split at row-type boundaries: idempotency rows [0,94) and
[94,296) (the latter with all frame-sum rows), pairing rows [296,359) and
[359,422). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T21w0 : Z4 := ⟨(-), (-), (-), ()⟩

theorem T21c0 : engine (denLcm (NativeT.rawEntries 2 1)) (NativeT.tSpec 2 1) (((NativeT.rawEntries 2 1).drop 0).take 94) (stateList ystar) =
    T21w0 := by decide +kernel

def T21w1 : Z4 := ⟨(), (), (), (-)⟩

theorem T21c1 : engine (denLcm (NativeT.rawEntries 2 1)) (NativeT.tSpec 2 1) (((NativeT.rawEntries 2 1).drop 94).take 202) (stateList ystar) =
    T21w1 := by decide +kernel

def T21w2 : Z4 := ⟨(-), (), (-), (-)⟩

theorem T21c2 : engine (denLcm (NativeT.rawEntries 2 1)) (NativeT.tSpec 2 1) (((NativeT.rawEntries 2 1).drop 296).take 63) (stateList ystar) =
    T21w2 := by decide +kernel

def T21w3 : Z4 := ⟨(), (-), (), ()⟩

theorem T21c3 : engine (denLcm (NativeT.rawEntries 2 1)) (NativeT.tSpec 2 1) (((NativeT.rawEntries 2 1).drop 359).take 63) (stateList ystar) =
    T21w3 := by decide +kernel

theorem T21len : (NativeT.rawEntries 2 1).length = 422 := by decide +kernel

theorem T21sum : T21w0 + (T21w1 + (T21w2 + (T21w3 + 0))) = tBookValue 2 1 := by decide +kernel

theorem tCheck21 : tValue 2 1 = tBookValue 2 1 := by
  have h0 : tValue 2 1 = engine (denLcm (NativeT.rawEntries 2 1)) (NativeT.tSpec 2 1) ((NativeT.rawEntries 2 1).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 94 94 rfl, T21c0,
    engine_split' _ _ _ _ 94 202 296 rfl, T21c1,
    engine_split' _ _ _ _ 296 63 359 rfl, T21c2,
    engine_split' _ _ _ _ 359 63 422 rfl, T21c3,
    engine_drop_length _ _ _ _ 422 (by rw [T21len])]
  exact T21sum

end Option2.NativeStress.HTRouteKron

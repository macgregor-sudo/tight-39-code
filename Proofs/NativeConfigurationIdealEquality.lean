module

public import NativeConfigurationReverseAssemblyInterface
public import NativeConfigurationTraceIdealStandaloneAudit

@[expose] public section

/-!
# Equality of the two original configuration residual ideals

The actual all-39 trace-row theorem closes the one visible input of the
checked reverse assembly. Together with the previously checked forward
inclusion, the original F2184 and G3159 polynomial families generate the
same ideal over a commutative coefficient ring when `2 * h = 1` and
`3 * t = 1`. This is equality of polynomial ideals; it does not assert a
finite certificate rank, local dimension, or geometric classification.

The proof uses only first-party row-family interfaces and mathlib's ideal
order, without copying third-party code or claiming mathematical novelty.
-/

namespace NativePolynomial.ConfigurationResiduals

open ConfigurationResidualIndices

variable {R : Type*} [CommRing R]

/-- Every numbered original F row lies in the ideal of original G rows. -/
theorem fRow_mem_gSpan (h t : R) (hHalf : (2 : R) * h = 1)
    (hThird : (3 : R) * t = 1) (r : Fin 2184) :
    fRow h t r ∈ Ideal.span (Set.range (gRow h t)) := by
  exact fRow_mem_gSpan_of_trace h t hHalf
    (fTrace_mem_gSpan h t hHalf hThird) r

/-- Reverse inclusion for the ideals generated by the original rows. -/
theorem fIdeal_le_gSpan (h t : R) (hHalf : (2 : R) * h = 1)
    (hThird : (3 : R) * t = 1) :
    fIdeal h t ≤ Ideal.span (Set.range (gRow h t)) := by
  exact fIdeal_le_gSpan_of_trace h t hHalf
    (fTrace_mem_gSpan h t hHalf hThird)

/-- The two literal residual families define the same polynomial ideal. -/
theorem fIdeal_eq_gSpan (h t : R) (hHalf : (2 : R) * h = 1)
    (hThird : (3 : R) * t = 1) :
    fIdeal h t = Ideal.span (Set.range (gRow h t)) := by
  exact ideals_eq_of_trace h t hHalf
    (fTrace_mem_gSpan h t hHalf hThird)

end NativePolynomial.ConfigurationResiduals

#check @NativePolynomial.ConfigurationResiduals.fRow_mem_gSpan
#check @NativePolynomial.ConfigurationResiduals.fIdeal_le_gSpan
#check @NativePolynomial.ConfigurationResiduals.fIdeal_eq_gSpan
#print axioms NativePolynomial.ConfigurationResiduals.fRow_mem_gSpan
#print axioms NativePolynomial.ConfigurationResiduals.fIdeal_le_gSpan
#print axioms NativePolynomial.ConfigurationResiduals.fIdeal_eq_gSpan

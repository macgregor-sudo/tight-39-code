module

public import NativeConfigurationWithinIdealStandaloneAudit
public import NativeConfigurationCrossIdealStandaloneAudit

@[expose] public section

/-!
# The G residual ideal is contained in the F residual ideal

The shared idempotency and frame-sum rows are actual F generators. Together
with the within-product and cross-frame row lemmas, the four typed G branches
give membership of every numbered G row. The universal property of the ideal
span then gives the forward inclusion. Only the within branch needs 2*h=1;
t remains arbitrary. Reverse inclusion and equality are separate targets.

This is elementary polynomial ideal arithmetic, with no novelty claim.
Earlier first-party indices, rows and membership proofs are imported and
applied, not copied. Mathlib remains pinned at
065356127b1dc0016f66b7283ce0ce2c4055aa55. The unchanged native dependency
comes from https://github.com/macgregor-sudo/compact-albert-recognition,
commit 40d3b344180d9ddb78aaa2876873377c1e631515. Existing Apache-2.0 notices
and extraction provenance remain at THIRD_PARTY_NOTICES.md#native-albert-code.
No new row family, model, native evaluation or certificate binding is added.
Thanks to the native-model, Lean and mathlib contributors.
“If I have seen further it is by standing on the sholders of Giants.” — Isaac Newton, letter to Robert Hooke, 1676.
Quotation source: https://www.newtonproject.ox.ac.uk/view/texts/normalized/OTHE00018
-/

namespace NativePolynomial.ConfigurationResiduals

open ConfigurationResidualIndices

variable {R : Type*} [CommRing R]

/-- The shared G idempotency branch is an actual F idempotency generator. -/
theorem gId_mem_fIdeal (h t : R) (i : Fin 39) (k : Fin 27) :
    gRow h t (gNumber (gId i k)) ∈ fIdeal h t := by
  have hRow : fRow h t (fNumber (fId i k)) ∈ fIdeal h t :=
    Ideal.subset_span ⟨fNumber (fId i k), rfl⟩
  rw [fRow_id] at hRow
  rw [gRow_id]
  exact hRow

/-- The shared G frame-sum branch is an actual F frame-sum generator. -/
theorem gSum_mem_fIdeal (h t : R) (f : Fin 13) (k : Fin 27) :
    gRow h t (gNumber (gSum f k)) ∈ fIdeal h t := by
  have hRow : fRow h t (fNumber (fSum f k)) ∈ fIdeal h t :=
    Ideal.subset_span ⟨fNumber (fSum f k), rfl⟩
  rw [fRow_sum] at hRow
  rw [gRow_sum]
  exact hRow

/-- Exhausting the actual typed labels covers every numbered G polynomial. -/
theorem gRow_mem_fIdeal (h t : R) (hHalf : (2 : R) * h = 1) (r : Fin 3159) :
    gRow h t r ∈ fIdeal h t := by
  have hAll (label : GLabel) : gRow h t (gNumber label) ∈ fIdeal h t := by
    rcases label with ik | other
    · rcases ik with ⟨i, k⟩
      exact gId_mem_fIdeal h t i k
    · rcases other with fsk | other
      · rcases fsk with ⟨⟨f, s⟩, k⟩
        exact within_mem_fIdeal h t hHalf f s k
      · rcases other with fk | fgab
        · rcases fk with ⟨f, k⟩
          exact gSum_mem_fIdeal h t f k
        · rcases fgab with ⟨fg, a, b⟩
          exact cross_mem_fIdeal h t fg a b
  have hRow := hAll (gNumber.symm r)
  rw [gNumber.apply_symm_apply] at hRow
  exact hRow

/-- The ideal generated by all actual G rows is contained in the F ideal. -/
theorem gSpan_le_fIdeal (h t : R) (hHalf : (2 : R) * h = 1) :
    Ideal.span (Set.range (gRow h t)) ≤ fIdeal h t := by
  apply Ideal.span_le.mpr
  rintro q ⟨r, rfl⟩
  exact gRow_mem_fIdeal h t hHalf r

end NativePolynomial.ConfigurationResiduals



#check @NativePolynomial.ConfigurationResiduals.gId_mem_fIdeal
#check @NativePolynomial.ConfigurationResiduals.gSum_mem_fIdeal
#check @NativePolynomial.ConfigurationResiduals.gRow_mem_fIdeal
#check @NativePolynomial.ConfigurationResiduals.gSpan_le_fIdeal
#print axioms NativePolynomial.ConfigurationResiduals.gId_mem_fIdeal
#print axioms NativePolynomial.ConfigurationResiduals.gSum_mem_fIdeal
#print axioms NativePolynomial.ConfigurationResiduals.gRow_mem_fIdeal
#print axioms NativePolynomial.ConfigurationResiduals.gSpan_le_fIdeal

@[expose] public section

/-! Direction-A Tits product identity, component by component (generated by py/gen.py;
coefficients of the `linear_combination` steps computed by sympy).  Each lemma says the
Tits coordinates of a native product are the `titsProduct` of the Tits coordinates. -/

namespace TitsS

open NativePolynomial.CoordinateMaps Matrix

variable {S : Type*} [CommRing S] (ι : Q12 →+* S)

local notation "𝕚" => ι Q12.I

theorem prod_Bt00 (h : S) (x y : Fin 27 → S) :
    (titsOfNative ι (coordinateProduct h x y)).2.2 0 0 =
      (titsProduct h (titsOfNative ι x) (titsOfNative ι y)).2.2 0 0 := by
  simp only [titsProduct, crossT, titsOfNative, Matrix.add_apply, Matrix.smul_apply, Matrix.sub_apply,
    Matrix.mul_apply, Fin.sum_univ_three, Matrix.one_apply, Matrix.trace, Matrix.diag, Matrix.transpose_apply,
    smul_eq_mul, Matrix.adjugate_fin_three, Matrix.of_apply, Matrix.cons_val, Fin.isValue, Fin.reduceEq,
    ↓reduceIte, mul_one, mul_zero, Sparse.coord21, Sparse.coord22]
  linear_combination (-h*x 10*y 16 + h*x 12*y 6 - h*x 14*y 4 - h*x 16*y 10 + h*x 18*y 8 - h*x 4*y 14 + h*x 6*y 12 + h*x 8*y 18) * I_mul_I ι


module

public import HTKronLists

@[expose] public section

/-!
# T component (1, 1): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 413 rows are split at row-type boundaries: idempotency rows [0,94) and
[94,297) (the latter with all frame-sum rows), pairing rows [297,355) and
[355,413). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T11w0 : Z4 := ⟨(), (-), (), ()⟩

theorem T11c0 : engine (denLcm (NativeT.rawEntries 1 1)) (NativeT.tSpec 1 1) (((NativeT.rawEntries 1 1).drop 0).take 94) (stateList ystar) =
    T11w0 := by decide +kernel

def T11w1 : Z4 := ⟨(-), (), (-), (-)⟩

theorem T11c1 : engine (denLcm (NativeT.rawEntries 1 1)) (NativeT.tSpec 1 1) (((NativeT.rawEntries 1 1).drop 94).take 203) (stateList ystar) =
    T11w1 := by decide +kernel

def T11w2 : Z4 := ⟨(), (), (-), ()⟩

theorem T11c2 : engine (denLcm (NativeT.rawEntries 1 1)) (NativeT.tSpec 1 1) (((NativeT.rawEntries 1 1).drop 297).take 58) (stateList ystar) =
    T11w2 := by decide +kernel

def T11w3 : Z4 := ⟨(-), (-), (-), (-)⟩

theorem T11c3 : engine (denLcm (NativeT.rawEntries 1 1)) (NativeT.tSpec 1 1) (((NativeT.rawEntries 1 1).drop 355).take 58) (stateList ystar) =
    T11w3 := by decide +kernel

theorem T11len : (NativeT.rawEntries 1 1).length = 413 := by decide +kernel

theorem T11sum : T11w0 + (T11w1 + (T11w2 + (T11w3 + 0))) = tBookValue 1 1 := by decide +kernel

theorem tCheck11 : tValue 1 1 = tBookValue 1 1 := by
  have h0 : tValue 1 1 = engine (denLcm (NativeT.rawEntries 1 1)) (NativeT.tSpec 1 1) ((NativeT.rawEntries 1 1).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 94 94 rfl, T11c0,
    engine_split' _ _ _ _ 94 203 297 rfl, T11c1,
    engine_split' _ _ _ _ 297 58 355 rfl, T11c2,
    engine_split' _ _ _ _ 355 58 413 rfl, T11c3,
    engine_drop_length _ _ _ _ 413 (by rw [T11len])]
  exact T11sum

end Option2.NativeStress.HTRouteKron

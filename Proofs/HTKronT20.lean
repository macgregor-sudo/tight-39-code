module

public import HTKronLists

@[expose] public section

/-!
# T component (2, 0): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 461 rows are split at row-type boundaries: idempotency rows [0,113) and
[113,337) (the latter with all frame-sum rows), pairing rows [337,399) and
[399,461). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T20w0 : Z4 := ⟨(-), (-), (-), ()⟩

theorem T20c0 : engine (denLcm (NativeT.rawEntries 2 0)) (NativeT.tSpec 2 0) (((NativeT.rawEntries 2 0).drop 0).take 113) (stateList ystar) =
    T20w0 := by decide +kernel

def T20w1 : Z4 := ⟨(), (), (), (-)⟩

theorem T20c1 : engine (denLcm (NativeT.rawEntries 2 0)) (NativeT.tSpec 2 0) (((NativeT.rawEntries 2 0).drop 113).take 224) (stateList ystar) =
    T20w1 := by decide +kernel

def T20w2 : Z4 := ⟨(-), (-), (-), ()⟩

theorem T20c2 : engine (denLcm (NativeT.rawEntries 2 0)) (NativeT.tSpec 2 0) (((NativeT.rawEntries 2 0).drop 337).take 62) (stateList ystar) =
    T20w2 := by decide +kernel

def T20w3 : Z4 := ⟨(), (), (), (-)⟩

theorem T20c3 : engine (denLcm (NativeT.rawEntries 2 0)) (NativeT.tSpec 2 0) (((NativeT.rawEntries 2 0).drop 399).take 62) (stateList ystar) =
    T20w3 := by decide +kernel

theorem T20len : (NativeT.rawEntries 2 0).length = 461 := by decide +kernel

theorem T20sum : T20w0 + (T20w1 + (T20w2 + (T20w3 + 0))) = tBookValue 2 0 := by decide +kernel

theorem tCheck20 : tValue 2 0 = tBookValue 2 0 := by
  have h0 : tValue 2 0 = engine (denLcm (NativeT.rawEntries 2 0)) (NativeT.tSpec 2 0) ((NativeT.rawEntries 2 0).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 113 113 rfl, T20c0,
    engine_split' _ _ _ _ 113 224 337 rfl, T20c1,
    engine_split' _ _ _ _ 337 62 399 rfl, T20c2,
    engine_split' _ _ _ _ 399 62 461 rfl, T20c3,
    engine_drop_length _ _ _ _ 461 (by rw [T20len])]
  exact T20sum

end Option2.NativeStress.HTRouteKron

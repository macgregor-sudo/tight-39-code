module

public import NativeCoordinateProductTrace
public import FrameResidualIdealIdentities
public import ConfigurationResidualIndices

@[expose] public section

/-!
# The literal configuration polynomial residual families

One point-first polynomial variable family and the coordinate product,
unit, trace and weighted pairing define all original F2184/G3159 rows. Typed
matches are numbered only through the canonical index equivalences. The first
ideal theorem derives the 27 first within-frame G rows from actual F generators.
No complete ideal equality, row clearing or certificate binding is asserted.

This is first-party polynomial/bilinear arithmetic, with no novelty claim.
The earlier first-party frame identity is imported and applied, not rederived.
Scalar transport uses preservation of literal numerals by C. The same integer
numerator N defines the coordinate product h * N; when 2 * h = 1 its real
polynomial evaluation agrees with the native Jordan product. Mathlib APIs are pinned at
065356127b1dc0016f66b7283ce0ce2c4055aa55; no upstream implementation is copied.
The actual native source is imported through the integer N chain from
https://github.com/macgregor-sudo/compact-albert-recognition, commit
40d3b344180d9ddb78aaa2876873377c1e631515. Existing Apache-2.0 notices and
extraction provenance remain at THIRD_PARTY_NOTICES.md#native-albert-code. No outbound
license choice or new Albert carrier is introduced.
Thanks to the native-model, Lean and mathlib contributors.
“If I have seen further it is by standing on the sholders of Giants.” — Isaac Newton, letter to Robert Hooke, 1676.
Quotation source: https://www.newtonproject.ox.ac.uk/view/texts/normalized/OTHE00018
-/

noncomputable section

namespace NativePolynomial.ConfigurationResiduals

open scoped BigOperators
open CoordinateMaps MvPolynomial FrameResiduals ConfigurationResidualIndices

variable {R : Type*} [CommRing R]

/-- Literal point-first coordinate index, with no modular index coercion. -/
def variableIndex (i : Fin 39) (k : Fin 27) : Fin 1053 :=
  ⟨27 * i.val + k.val, by omega⟩

theorem variableIndex_val (i : Fin 39) (k : Fin 27) :
    (variableIndex i k).val = 27 * i.val + k.val := rfl

/-- The actual polynomial coordinate of point i. -/
def point (i : Fin 39) (k : Fin 27) : MvPolynomial (Fin 1053) R :=
  X (variableIndex i k)

/-- Point a of ordered frame f. -/
def framePointIndex (f : Fin 13) (a : Fin 3) : Fin 39 :=
  ⟨3 * f.val + a.val, by omega⟩

theorem framePointIndex_val (f : Fin 13) (a : Fin 3) :
    (framePointIndex f a).val = 3 * f.val + a.val := rfl

/-- Complete original F residuals in the canonical typed order. -/
def fResidual (h t : R) : FLabel → MvPolynomial (Fin 1053) R
  | .inl (i, k) => idempotencyResidual (coordinateProduct (C h)) (point i) k
  | .inr (.inl i) => coordinateTrace (point i) - 1
  | .inr (.inr (.inl (f, k))) =>
      (∑ a : Fin 3, point (framePointIndex f a) k) - coordinateUnit k
  | .inr (.inr (.inr ij)) =>
      coordinatePairing (point ij.val.1) (point ij.val.2) -
        (if ij.val.1.val / 3 = ij.val.2.val / 3 then 0 else C t)

/-- Complete original G residuals; withinPair retains label order. -/
def gResidual (h t : R) : GLabel → MvPolynomial (Fin 1053) R
  | .inl (i, k) => idempotencyResidual (coordinateProduct (C h)) (point i) k
  | .inr (.inl ((f, s), k)) =>
      coordinateProduct (C h)
        (point (framePointIndex f (withinPair s).val.1))
        (point (framePointIndex f (withinPair s).val.2)) k
  | .inr (.inr (.inl (f, k))) =>
      (∑ a : Fin 3, point (framePointIndex f a) k) - coordinateUnit k
  | .inr (.inr (.inr (fg, (a, b)))) =>
      coordinatePairing (point (framePointIndex fg.val.1 a))
        (point (framePointIndex fg.val.2 b)) - C t

/-- Numbered F rows use the sole canonical inverse index equivalence. -/
def fRow (h t : R) : Fin 2184 → MvPolynomial (Fin 1053) R :=
  ConfigurationResidualIndices.fRow (fResidual h t)

/-- Numbered G rows use the sole canonical inverse index equivalence. -/
def gRow (h t : R) : Fin 3159 → MvPolynomial (Fin 1053) R :=
  ConfigurationResidualIndices.gRow (gResidual h t)

/-- The ideal generated by all actual original F polynomials. -/
def fIdeal (h t : R) : Ideal (MvPolynomial (Fin 1053) R) :=
  Ideal.span (Set.range (fRow h t))

theorem fRow_id (h t : R) (i : Fin 39) (k : Fin 27) :
    fRow h t (fNumber (fId i k)) =
      idempotencyResidual (coordinateProduct (C h)) (point i) k := by
  rw [fRow, ConfigurationResidualIndices.fRow_number]
  rfl

theorem fRow_trace (h t : R) (i : Fin 39) :
    fRow h t (fNumber (fTrace i)) = coordinateTrace (point i) - 1 := by
  rw [fRow, ConfigurationResidualIndices.fRow_number]
  rfl

theorem fRow_sum (h t : R) (f : Fin 13) (k : Fin 27) :
    fRow h t (fNumber (fSum f k)) =
      (∑ a : Fin 3, point (framePointIndex f a) k) - coordinateUnit k := by
  rw [fRow, ConfigurationResidualIndices.fRow_number]
  rfl

theorem fRow_pair (h t : R) (ij : Pair 39) :
    fRow h t (fNumber (fPair ij)) =
      coordinatePairing (point ij.val.1) (point ij.val.2) -
        (if ij.val.1.val / 3 = ij.val.2.val / 3 then 0 else C t) := by
  rw [fRow, ConfigurationResidualIndices.fRow_number]
  rfl

theorem gRow_id (h t : R) (i : Fin 39) (k : Fin 27) :
    gRow h t (gNumber (gId i k)) =
      idempotencyResidual (coordinateProduct (C h)) (point i) k := by
  rw [gRow, ConfigurationResidualIndices.gRow_number]
  rfl

theorem gRow_within (h t : R) (f : Fin 13) (s : Fin 3) (k : Fin 27) :
    gRow h t (gNumber (gWithin f s k)) =
      coordinateProduct (C h)
        (point (framePointIndex f (withinPair s).val.1))
        (point (framePointIndex f (withinPair s).val.2)) k := by
  rw [gRow, ConfigurationResidualIndices.gRow_number]
  rfl

theorem gRow_sum (h t : R) (f : Fin 13) (k : Fin 27) :
    gRow h t (gNumber (gSum f k)) =
      (∑ a : Fin 3, point (framePointIndex f a) k) - coordinateUnit k := by
  rw [gRow, ConfigurationResidualIndices.gRow_number]
  rfl

theorem gRow_cross (h t : R) (fg : Pair 13) (a b : Fin 3) :
    gRow h t (gNumber (gCross fg a b)) =
      coordinatePairing (point (framePointIndex fg.val.1 a))
        (point (framePointIndex fg.val.2 b)) - C t := by
  rw [gRow, ConfigurationResidualIndices.gRow_number]
  rfl

/-- The actual first-frame sum row is the vector residual in the old identity. -/
theorem fRow_firstSum (h t : R) (k : Fin 27) :
    fRow h t (fNumber (fSum 0 k)) =
      frameSumResidual coordinateUnit (point 0) (point 1) (point 2) k := by
  rw [fRow_sum, Fin.sum_univ_three]
  rfl

/-- Bind the first product to its literal G index 1053+k. -/
theorem gRow_firstWithin (h t : R) (k : Fin 27) :
    gRow h t ⟨1053 + k.val, by omega⟩ =
      coordinateProduct (C h) (point 0) (point 1) k := by
  have hIndex : gNumber (gWithin 0 0 k) =
      (⟨1053 + k.val, by omega⟩ : Fin 3159) := by
    apply Fin.ext
    exact gNumber_first_within k
  have hPointZero : framePointIndex 0 0 = (0 : Fin 39) := by
    apply Fin.ext
    rfl
  have hPointOne : framePointIndex 0 1 = (1 : Fin 39) := by
    apply Fin.ext
    rfl
  rw [← hIndex]
  simpa only [withinPair_zero, hPointZero, hPointOne] using gRow_within h t 0 0 k

/-- The first 27 original G product rows belong to the actual original F ideal. -/
theorem firstWithin_mem_fIdeal (h t : R) (hHalf : (2 : R) * h = 1) (k : Fin 27) :
    gRow h t ⟨1053 + k.val, by omega⟩ ∈ fIdeal h t := by
  have hHalfP : (2 : MvPolynomial (Fin 1053) R) * C h = 1 := by
    have hConstant : (C (2 : R) : MvPolynomial (Fin 1053) R) = 2 :=
      _root_.map_ofNat C 2
    have hMapped := congrArg (C : R →+* MvPolynomial (Fin 1053) R) hHalf
    rw [map_mul, hConstant, map_one] at hMapped
    exact hMapped
  have hId (i : Fin 39) (j : Fin 27) :
      idempotencyResidual (coordinateProduct (C h)) (point i) j ∈ fIdeal h t := by
    have hRow : fRow h t (fNumber (fId i j)) ∈ fIdeal h t :=
      Ideal.subset_span ⟨fNumber (fId i j), rfl⟩
    rw [fRow_id] at hRow
    exact hRow
  have hSum (j : Fin 27) :
      frameSumResidual coordinateUnit (point 0) (point 1) (point 2) j ∈ fIdeal h t := by
    have hRow : fRow h t (fNumber (fSum 0 j)) ∈ fIdeal h t :=
      Ideal.subset_span ⟨fNumber (fSum 0 j), rfl⟩
    rw [fRow_firstSum] at hRow
    exact hRow
  have hProduct := product_mem_of_frame_residuals (fIdeal h t)
    (coordinateProduct (C h)) coordinateUnit
    (coordinateProduct_comm (C h)) (coordinateProduct_unit_left (C h) hHalfP)
    (coordinate_two_isUnit (C h) hHalfP)
    (point 0) (point 1) (point 2) (hId 0) (hId 1) (hId 2) hSum
  rw [gRow_firstWithin]
  exact hProduct k

end NativePolynomial.ConfigurationResiduals




module

public import HTKronLists

@[expose] public section

/-!
# T component (2, 2): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 460 rows are split at row-type boundaries: idempotency rows [0,112) and
[112,336) (the latter with all frame-sum rows), pairing rows [336,398) and
[398,460). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T22w0 : Z4 := ⟨(), (-), (), ()⟩

theorem T22c0 : engine (denLcm (NativeT.rawEntries 2 2)) (NativeT.tSpec 2 2) (((NativeT.rawEntries 2 2).drop 0).take 112) (stateList ystar) =
    T22w0 := by decide +kernel

def T22w1 : Z4 := ⟨(-), (), (-), (-)⟩

theorem T22c1 : engine (denLcm (NativeT.rawEntries 2 2)) (NativeT.tSpec 2 2) (((NativeT.rawEntries 2 2).drop 112).take 224) (stateList ystar) =
    T22w1 := by decide +kernel

def T22w2 : Z4 := ⟨(-), (), (-), (-)⟩

theorem T22c2 : engine (denLcm (NativeT.rawEntries 2 2)) (NativeT.tSpec 2 2) (((NativeT.rawEntries 2 2).drop 336).take 62) (stateList ystar) =
    T22w2 := by decide +kernel

def T22w3 : Z4 := ⟨(), (-), (), ()⟩

theorem T22c3 : engine (denLcm (NativeT.rawEntries 2 2)) (NativeT.tSpec 2 2) (((NativeT.rawEntries 2 2).drop 398).take 62) (stateList ystar) =
    T22w3 := by decide +kernel

theorem T22len : (NativeT.rawEntries 2 2).length = 460 := by decide +kernel

theorem T22sum : T22w0 + (T22w1 + (T22w2 + (T22w3 + 0))) = tBookValue 2 2 := by decide +kernel

theorem tCheck22 : tValue 2 2 = tBookValue 2 2 := by
  have h0 : tValue 2 2 = engine (denLcm (NativeT.rawEntries 2 2)) (NativeT.tSpec 2 2) ((NativeT.rawEntries 2 2).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 112 112 rfl, T22c0,
    engine_split' _ _ _ _ 112 224 336 rfl, T22c1,
    engine_split' _ _ _ _ 336 62 398 rfl, T22c2,
    engine_split' _ _ _ _ 398 62 460 rfl, T22c3,
    engine_drop_length _ _ _ _ 460 (by rw [T22len])]
  exact T22sum

end Option2.NativeStress.HTRouteKron

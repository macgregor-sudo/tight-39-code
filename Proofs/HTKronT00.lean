module

public import HTKronLists

@[expose] public section

/-!
# T component (0, 0): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 556 rows are split at row-type boundaries: idempotency rows [0,134) and
[134,423) (the latter with all frame-sum rows), pairing rows [423,489) and
[489,556). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T00w0 : Z4 := ⟨(), (), (), (-)⟩

theorem T00c0 : engine (denLcm (NativeT.rawEntries 0 0)) (NativeT.tSpec 0 0) (((NativeT.rawEntries 0 0).drop 0).take 134) (stateList ystar) =
    T00w0 := by decide +kernel

def T00w1 : Z4 := ⟨(-), (-), (-), ()⟩

theorem T00c1 : engine (denLcm (NativeT.rawEntries 0 0)) (NativeT.tSpec 0 0) (((NativeT.rawEntries 0 0).drop 134).take 289) (stateList ystar) =
    T00w1 := by decide +kernel

def T00w2 : Z4 := ⟨(), (), (), (-)⟩

theorem T00c2 : engine (denLcm (NativeT.rawEntries 0 0)) (NativeT.tSpec 0 0) (((NativeT.rawEntries 0 0).drop 423).take 66) (stateList ystar) =
    T00w2 := by decide +kernel

def T00w3 : Z4 := ⟨(-), (-), (-), ()⟩

theorem T00c3 : engine (denLcm (NativeT.rawEntries 0 0)) (NativeT.tSpec 0 0) (((NativeT.rawEntries 0 0).drop 489).take 67) (stateList ystar) =
    T00w3 := by decide +kernel

theorem T00len : (NativeT.rawEntries 0 0).length = 556 := by decide +kernel

theorem T00sum : T00w0 + (T00w1 + (T00w2 + (T00w3 + 0))) = tBookValue 0 0 := by decide +kernel

theorem tCheck00 : tValue 0 0 = tBookValue 0 0 := by
  have h0 : tValue 0 0 = engine (denLcm (NativeT.rawEntries 0 0)) (NativeT.tSpec 0 0) ((NativeT.rawEntries 0 0).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 134 134 rfl, T00c0,
    engine_split' _ _ _ _ 134 289 423 rfl, T00c1,
    engine_split' _ _ _ _ 423 66 489 rfl, T00c2,
    engine_split' _ _ _ _ 489 67 556 rfl, T00c3,
    engine_drop_length _ _ _ _ 556 (by rw [T00len])]
  exact T00sum

end Option2.NativeStress.HTRouteKron

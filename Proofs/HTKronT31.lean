module

public import HTKronLists

@[expose] public section

/-!
# T component (3, 1): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 463 rows are split at row-type boundaries: idempotency rows [0,114) and
[114,342) (the latter with all frame-sum rows), pairing rows [342,402) and
[402,463). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T31w0 : Z4 := ⟨(-), (), (), ()⟩

theorem T31c0 : engine (denLcm (NativeT.rawEntries 3 1)) (NativeT.tSpec 3 1) (((NativeT.rawEntries 3 1).drop 0).take 114) (stateList ystar) =
    T31w0 := by decide +kernel

def T31w1 : Z4 := ⟨(), (-), (-), (-)⟩

theorem T31c1 : engine (denLcm (NativeT.rawEntries 3 1)) (NativeT.tSpec 3 1) (((NativeT.rawEntries 3 1).drop 114).take 228) (stateList ystar) =
    T31w1 := by decide +kernel

def T31w2 : Z4 := ⟨(-), (-), (-), (-)⟩

theorem T31c2 : engine (denLcm (NativeT.rawEntries 3 1)) (NativeT.tSpec 3 1) (((NativeT.rawEntries 3 1).drop 342).take 60) (stateList ystar) =
    T31w2 := by decide +kernel

def T31w3 : Z4 := ⟨(-), (-), (-), (-)⟩

theorem T31c3 : engine (denLcm (NativeT.rawEntries 3 1)) (NativeT.tSpec 3 1) (((NativeT.rawEntries 3 1).drop 402).take 61) (stateList ystar) =
    T31w3 := by decide +kernel

theorem T31len : (NativeT.rawEntries 3 1).length = 463 := by decide +kernel

theorem T31sum : T31w0 + (T31w1 + (T31w2 + (T31w3 + 0))) = tBookValue 3 1 := by decide +kernel

theorem tCheck31 : tValue 3 1 = tBookValue 3 1 := by
  have h0 : tValue 3 1 = engine (denLcm (NativeT.rawEntries 3 1)) (NativeT.tSpec 3 1) ((NativeT.rawEntries 3 1).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 114 114 rfl, T31c0,
    engine_split' _ _ _ _ 114 228 342 rfl, T31c1,
    engine_split' _ _ _ _ 342 60 402 rfl, T31c2,
    engine_split' _ _ _ _ 402 61 463 rfl, T31c3,
    engine_drop_length _ _ _ _ 463 (by rw [T31len])]
  exact T31sum

end Option2.NativeStress.HTRouteKron

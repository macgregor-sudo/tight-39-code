@[expose] public section

/-! # Explicit row formula for the phased pure T10 covector

At every unit phase `ξ` (u_a = ξ_a / exactPhases_a), the weight of original row `fNumber pe.e.label`, for an
entry `pe` of `covT10`, is `toComplex(literal) · u^(pe.x)`; every other original row has weight `0`. -/

set_option autoImplicit false
set_option maxRecDepth 100000
namespace Option2.NativeStress.HTPhaseComplete
open HTPhaseKron NativeH ConfigurationResidualIndices CKM.NativeFirstOrder

/-- Distinct original rows (kernel check; the same fact is `rep10_nodup` via `rep10_typed`). -/
theorem rows10_nodup : (covT10.map fun q => (fNumber q.e.label).val).Nodup := by decide +kernel

theorem ellT10_row (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (pe : PEntry) (h : pe ∈ covT10) :
    ellT10 ξ hξ (fNumber pe.e.label) = Q12.toComplex pe.e.coefficient.toQ12 * mono (Uph ξ hξ) pe.x :=
  sum_ite_of_nodup covT10 (fun q => Q12.toComplex q.e.coefficient.toQ12 * mono (Uph ξ hξ) q.x)
    rows10_nodup pe h

theorem ellT10_off (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (r : Fin 2184)
    (h : ∀ q ∈ covT10, fNumber q.e.label ≠ r) : ellT10 ξ hξ r = 0 :=
  sum_ite_of_not_mem covT10 _ r h

end Option2.NativeStress.HTPhaseComplete

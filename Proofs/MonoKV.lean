  (bif Nat.blt s 24 then (bif Nat.blt s 12 then (bif Nat.blt s 6 then (bif Nat.blt s 3 then (bif Nat.blt s 1 then [(144115188076118016,1),(1152921504606846984,1),(18014398643699712,1048572)] else (bif Nat.blt s 2 then [(590298062158519336960,1),(549755813952,1),(9223372045444710400,1)] else [(16781312,1),(73787257769814917120,1),(1073774592,1048572)])) else (bif Nat.blt s 4 then [(35184372092928,1),(2251799813685760,1048572),(73786976294838239232,1048572)] else (bif Nat.blt s 5 then [(144150372447944704,1),(4398046515200,1),(73786976303428141056,1)] else [(1152956688978935808,1),(285873023221760,1),(590295810358705684480,1048572)]))) else (bif Nat.blt s 9 then (bif Nat.blt s 7 then [(316659348799488,1),(549755814400,1048572),(16809984,1048572)] else (bif Nat.blt s 8 then [(35185445830656,1),(9223372036854776320,1048572),(73786976294854983680,1)] else [(18049582881570816,1),(4399120252928,1048572),(16777280,1048572)])) else (bif Nat.blt s 10 then [(590295845543077740544,1),(4398063288320,1),(9223372586610589696,1048572)] else (bif Nat.blt s 11 then [(35184372350976,1),(590295810358705652224,1048572),(9223653511831486464,1048572)] else [(35184506306560,1),(8589935104,1048572),(549755817984,1048572)])))) else (bif Nat.blt s 18 then (bif Nat.blt s 15 then (bif Nat.blt s 13 then [(35192962023424,1),(4398046543872,1048572),(2252349569499136,1048572)] else (bif Nat.blt s 14 then [(35184372088896,1),(73786980692884717568,1),(9225623836668461056,1048572)] else [(35184372088840,1),(576,1048572),(2251800887427072,1048572)])) else (bif Nat.blt s 16 then [(2101248,1),(2251868533161984,1048572),(134217792,1)] else (bif Nat.blt s 17 then [(2251799815782400,1),(144119586122366976,1),(8589934656,1)] else [(549757911040,1),(1152925902653358080,1),(590295810367295586304,1)]))) else (bif Nat.blt s 21 then (bif Nat.blt s 19 then [(281474978807808,1),(618475290624,1048572),(8590196736,1)] else (bif Nat.blt s 20 then [(9223372036856872960,1),(18018796555993088,1048572),(590295810358705651
/-- accumulator: (key, coefficient mod P), keys strictly increasing, no zero coefficients -/
abbrev Acc := List (Nat × Nat)

noncomputable def insAddR (k c : Nat) (l : Acc) : Acc :=
  List.rec (motive := fun _ => Acc) (bif Nat.beq c 0 then [] else [(k, c)])
    (fun g l ih => bif Nat.blt k g.1 then (bif Nat.beq c 0 then g :: l else (k, c) :: g :: l)
      else bif Nat.beq k g.1 then
        (bif Nat.beq ((g.2 + c) % P) 0 then l else (k, (g.2 + c) % P) :: l)
      else g :: ih) l

noncomputable def addRowR (acc : Acc) (s km c : Nat) : Acc :=
  List.rec (motive := fun _ => Acc → Acc) (fun a => a)
    (fun e _ ih a => ih (insAddR (km + e.1) (c * e.2 % P) a)) (triKR s) acc

def vkey (v : Nat) : Nat := bif Nat.beq v 31 then 0 else 8 ^ v

/-- key of the multiplier of slot `w` -/
def mkey (w : Nat) : Nat := vkey ((w >>> 6) % 32) + vkey ((w >>> 11) % 32) + vkey ((w >>> 16) % 32)

noncomputable def decodeR (n : Nat) : Nat → Acc → Acc :=
  Nat.rec (motive := fun _ => Nat → Acc → Acc) (fun _ a => a)
    (fun _ ih N a =>
      let w := N % 18446744073709551616
      ih (N >>> 64) (addRowR a (w % 64) (mkey w) (w >>> 21)))
    n

def vOk (v : Nat) : Bool := Nat.blt v 24 || Nat.beq v 31
def vcnt (v : Nat) : Nat := bif Nat.beq v 31 then 0 else 1

def slotOk (d w : Nat) : Bool :=
  Nat.blt (w % 64) 48 && vOk ((w >>> 6) % 32) && vOk ((w >>> 11) % 32) && vOk ((w >>> 16) % 32) &&
    Nat.beq (vcnt ((w >>> 6) % 32) + vcnt ((w >>> 11) % 32) + vcnt ((w >>> 16) % 32) + 2) d

noncomputable def validR (d n : Nat) : Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Bool) (fun _ => true)
    (fun _ ih N => slotOk d (N % 18446744073709551616) && ih (N >>> 64)) n

noncomputable def headKey (l : Acc) : Option Nat :=
  List.rec (motive := fun _ => Option Nat) none (fun g _ _ => some g.1) l

noncomputable def checkV (d kμ n N : Nat) : Bool :=
  validR d n N && (List.rec (motive := fun _ => Bool) false (fun g _ _ => Nat.beq g.1 kμ) (decodeR n N []))

end MonoKV

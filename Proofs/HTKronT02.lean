module

public import HTKronLists

@[expose] public section

/-!
# T component (0, 2): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 481 rows are split at row-type boundaries: idempotency rows [0,115) and
[115,349) (the latter with all frame-sum rows), pairing rows [349,415) and
[415,481). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T02w0 : Z4 := ⟨(), (), (), (-)⟩

theorem T02c0 : engine (denLcm (NativeT.rawEntries 0 2)) (NativeT.tSpec 0 2) (((NativeT.rawEntries 0 2).drop 0).take 115) (stateList ystar) =
    T02w0 := by decide +kernel

def T02w1 : Z4 := ⟨(-), (), (-), ()⟩

theorem T02c1 : engine (denLcm (NativeT.rawEntries 0 2)) (NativeT.tSpec 0 2) (((NativeT.rawEntries 0 2).drop 115).take 234) (stateList ystar) =
    T02w1 := by decide +kernel

def T02w2 : Z4 := ⟨(-), (-), (-), ()⟩

theorem T02c2 : engine (denLcm (NativeT.rawEntries 0 2)) (NativeT.tSpec 0 2) (((NativeT.rawEntries 0 2).drop 349).take 66) (stateList ystar) =
    T02w2 := by decide +kernel

def T02w3 : Z4 := ⟨(), (), (), (-)⟩

theorem T02c3 : engine (denLcm (NativeT.rawEntries 0 2)) (NativeT.tSpec 0 2) (((NativeT.rawEntries 0 2).drop 415).take 66) (stateList ystar) =
    T02w3 := by decide +kernel

theorem T02len : (NativeT.rawEntries 0 2).length = 481 := by decide +kernel

theorem T02sum : T02w0 + (T02w1 + (T02w2 + (T02w3 + 0))) = tBookValue 0 2 := by decide +kernel

theorem tCheck02 : tValue 0 2 = tBookValue 0 2 := by
  have h0 : tValue 0 2 = engine (denLcm (NativeT.rawEntries 0 2)) (NativeT.tSpec 0 2) ((NativeT.rawEntries 0 2).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 115 115 rfl, T02c0,
    engine_split' _ _ _ _ 115 234 349 rfl, T02c1,
    engine_split' _ _ _ _ 349 66 415 rfl, T02c2,
    engine_split' _ _ _ _ 415 66 481 rfl, T02c3,
    engine_drop_length _ _ _ _ 481 (by rw [T02len])]
  exact T02sum

end Option2.NativeStress.HTRouteKron

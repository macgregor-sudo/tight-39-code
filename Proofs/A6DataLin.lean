/-- The 80 free (pivot-of-`Bsl`) columns, 12-bit table. -/
def pivPacked : ℕ :=
  0x41c41b41a41941841741641541441341241141040f40e40d4014003ff3fd3fc3fb3fa3f53cb3ca3c93c83c73c63c53c43c33c23c13c03bd3bc3b03af3ac3ab3aa3a932932832532432332232132031b31a30a3062d82d72d42d32d22d12ca2c923623522c22b21a2111e51e413d13c1351341221190ec0eb

/-- Sparse support of the `s`-th annihilator weight vector. -/
def wRow (s : ℕ) : List (ℕ × ℕ) := sparseRow wData wOffs s

/-- Sparse row `j` of the slice basis. -/
def bRow (j : ℕ) : List (ℕ × ℕ) := sparseRow bData bOffs j

/-- Annihilator weights `w_s(r)`, 48 × 2184 (A1's annihilators reduced mod p). -/
def wLin : Fin 48 → Fin 2184 → F := fun s r => ((natSlot (wRow s.val) r.val : ℕ) : F)

/-- The pivoted kernel basis (slice) `B`, 1053 × 80. -/
def Bsl : Matrix (Fin 1053) (Fin 80) F := fun j t => ((natSlot (bRow j.val) t.val : ℕ) : F)

/-- Pivot rows of `Bsl` (the free columns of `L_p`). -/
def pivSl : Fin 80 → Fin 1053 := fun t => ⟨tab 12 pivPacked t.val % 1053, Nat.mod_lt _ (by decide)⟩


/-!
# A6 compact route, lane LIN: data module `A6DataLin` (w, B, pivots), mod p = 1048573

Generated by `W2/lanes/LIN/py/gen.py` + `py/emit.py` from A1's exact data (L.json, annihilators_w.json; reduction
`i ↦ 365259`, `√3 ↦ 1024`) and lane DATA's pivot-form kernel basis (feas/DATA/out/B_p1048573.npy, piv_p1048573.json).
Data only (no proofs). Formats:
* sparse tables (`wData/wOffs`, `bData/bOffs`): `sparseRow data offs i` = list of `(key, value)` pairs of row `i`
  (32-bit entries: key 12 bits, value 20 bits, residues in `[0, p)`); offsets 16-bit.
* `wLin s r = natSlot (wRow s) r` (`wRow s`: support of the s-th annihilator, keys = F-row numbers `< 2184`), 10,087 entries.
* `Bsl j t = natSlot (bRow j) t` (`bRow j`: nonzero entries of row `j` of the pivot-form kernel basis, keys `t < 80`),
  17,512 entries (incl. the 80 identity entries on the free columns `pivSl t`).
* `pivSl t = tab 12 pivPacked t` (the 80 free columns of the rref of `L_p`, increasing).
First-party code and data (no borrowed code).
-/

namespace A6Compact

/-! ## Decoders (kernel-evaluable; `Nat.rec` / shifts / `%` only) -/

/-- Sum of the values carried by key `k` in a sparse list of `(key, value)` pairs (repeated keys are summed). -/
def natSlot (l : List (ℕ × ℕ)) (k : ℕ) : ℕ :=
  (l.map fun e => cond (Nat.beq e.1 k) e.2 0).sum

/-- Entry `i` of a packed table of `w`-bit fields. -/
def tab (w x i : ℕ) : ℕ := (x >>> (w * i)) % 2 ^ w

/-- `n` packed 32-bit entries from the low end of `x`: key = low 12 bits, value = next 20 bits. -/
def decodeEntries (n : ℕ) : ℕ → List (ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (ℕ × ℕ)) (fun _ => [])
    (fun _ ih x => (x % 4096, (x >>> 12) % 1048576) :: ih (x >>> 32)) n

/-- Row `i` of a packed sparse table: entries `offs[i] .. offs[i+1]-1` of `data` (offsets: 16-bit table). -/
def sparseRow (data offs i : ℕ) : List (ℕ × ℕ) :=
  decodeEntries (tab 16 offs (i + 1) - tab 16 offs i)
    ((data >>> (32 * tab 16 offs i)) % 2 ^ (32 * (tab 16 offs (i + 1) - tab 16 offs i)))


/-! # Explicit row formula for the phased pure T01 covector

At every unit phase `ξ` (u_a = ξ_a / exactPhases_a), the weight of original row `fNumber pe.e.label`, for an
entry `pe` of `covT01`, is `toComplex(literal) · u^(pe.x)`; every other original row has weight `0`. -/

set_option autoImplicit false
set_option maxRecDepth 100000
namespace Option2.NativeStress.HTPhaseComplete
open HTPhaseKron NativeH ConfigurationResidualIndices CKM.NativeFirstOrder

/-- Distinct original rows (kernel check; the same fact is `rep01_nodup` via `rep01_typed`). -/
theorem rows01_nodup : (covT01.map fun q => (fNumber q.e.label).val).Nodup := by decide +kernel

theorem ellT01_row (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (pe : PEntry) (h : pe ∈ covT01) :
    ellT01 ξ hξ (fNumber pe.e.label) = Q12.toComplex pe.e.coefficient.toQ12 * mono (Uph ξ hξ) pe.x :=
  sum_ite_of_nodup covT01 (fun q => Q12.toComplex q.e.coefficient.toQ12 * mono (Uph ξ hξ) q.x)
    rows01_nodup pe h

theorem ellT01_off (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (r : Fin 2184)
    (h : ∀ q ∈ covT01, fNumber q.e.label ≠ r) : ellT01 ξ hξ r = 0 :=
  sum_ite_of_not_mem covT01 _ r h

end Option2.NativeStress.HTPhaseComplete

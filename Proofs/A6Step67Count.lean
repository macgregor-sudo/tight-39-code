nodes (each checked by its own `decide +kernel`, so the kernel's peak memory is per piece) below a 8-node skeleton. -/

theorem check_split_of {n x bk bc : ℕ} {Gs : List (List ℕ)} {Vs : List ℕ} {k c : Cert}
    (hx : (decide (x < n) && Vs.contains x) = true)
    (hk : check n (filterMask bk Gs) (Vs.filter (· != x)) k = true)
    (hc : check n (filterMask bc (Gs.map (colonL x))) Vs c = true) :
    check n Gs Vs (.split x bk bc k c) = true := by
  show (decide (x < n) && Vs.contains x && check n (filterMask bk Gs) (Vs.filter (· != x)) k &&
    check n (filterMask bc (Gs.map (colonL x))) Vs c) = true
  rw [hx, hk, hc]; rfl

theorem counts_split (Vs : List ℕ) (x bk bc : ℕ) (k c : Cert) :
    counts Vs (.split x bk bc k c) = counts (Vs.filter (· != x)) k + counts Vs c := rfl


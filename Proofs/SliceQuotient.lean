module

public import SliceGlue
public import QuadricRelations

@[expose] public section

/-!
# CHAINMID prototype: the uncut relation quotient equals the restricted-quadric quotient (step 4)

Generic in the field `K`, the number of ambient variables `n` and the slice dimension `m`.
For the A6 chain: `K = ZMod p`, `n = 1053`, `m = 80`, cuts `= []`.

`quadricRelations q d` is the degree-`d` part of the ideal generated by the forms `q s`, written
literally as the span of the products `a * q s` with `a` homogeneous of degree `r`, `r + 2 = d`
(same shape as `annihilatorQuadricDegreeRelations`).

Main theorem `finrank_equationCutPiece_nil_eq`: if `B` is a pivoted slice matrix, every linear part of
the selected rows vanishes on the slice (`L·B = 0`) and the linear parts span a space of dimension
`≥ n - m` (`rank L ≥ n - m`), then for every `d`
`finrank (equationCutPiece g E w [] d) = finrank (K[Y_0..Y_{m-1}]_d ⧸ quadricRelations q̄ d)`,
where `q̄ s = restrict B (equationAnnihilatorQuadric g (w s))`.
-/

open MvPolynomial Module PolynomialJets SliceLemmas

namespace ChainMid

variable {K : Type*} [Field K]

variable {n m : ℕ} {ι ε κ : Type*} [Fintype ι]

/-- Restriction to the slice is onto in every degree (pivot form). -/
theorem restrictHomogeneous_surjective {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) (d : ℕ) : Function.Surjective (restrictHomogeneous B d) := by
  intro y
  refine ⟨⟨rename piv y.val, (y.property : (y.val).IsHomogeneous d).rename_isHomogeneous⟩, ?_⟩
  apply Subtype.ext
  rw [restrictHomogeneous_apply]
  exact restrict_rename hB y.val

/-- The restricted quadrics. -/
noncomputable def restrictedQuadric (B : Matrix (Fin n) (Fin m) K)
    (g : ι → MvPolynomial (Fin n) K) (w : κ → ι → K) (s : κ) : MvPolynomial (Fin m) K :=
  restrict B (equationAnnihilatorQuadric g (w s))

/-- The composite `S_d → T_d → T_d ⧸ (q̄)_d`. -/
noncomputable def sliceQuotientMap (B : Matrix (Fin n) (Fin m) K)
    (g : ι → MvPolynomial (Fin n) K) (w : κ → ι → K) (d : ℕ) :
    homogeneousSubmodule (Fin n) K d →ₗ[K]
      homogeneousSubmodule (Fin m) K d ⧸ quadricRelations (restrictedQuadric B g w) d :=
  (quadricRelations (restrictedQuadric B g w) d).mkQ ∘ₗ restrictHomogeneous B d

theorem sliceQuotientMap_surjective {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) (g : ι → MvPolynomial (Fin n) K) (w : κ → ι → K) (d : ℕ) :
    Function.Surjective (sliceQuotientMap B g w d) :=
  (Submodule.mkQ_surjective _).comp (restrictHomogeneous_surjective hB d)

/-- Relations die on the slice quotient (needs only `L·B = 0`). -/
theorem equationDegreeRelations_le_ker {B : Matrix (Fin n) (Fin m) K}
    (g : ι → MvPolynomial (Fin n) K) (E : ε → ι) (w : κ → ι → K)
    (hvanish : cutLinearSpace g E [] ≤ linearAnnihilator B) (d : ℕ) :
    equationDegreeRelations g E w d ≤ LinearMap.ker (sliceQuotientMap B g w d) := by
  rw [equationDegreeRelations, Submodule.span_le]
  rintro p (⟨e, r, hr, a, hp⟩ | ⟨s, r, hr, a, hp⟩)
  · -- `a * (linear part)` restricts to zero
    have hlin : restrict B (homogeneousComponent 1 (g (E e))) = 0 :=
      (hvanish (Submodule.subset_span (Or.inl ⟨e, rfl⟩))).2
    have h0 : restrictHomogeneous B d p = 0 := by
      apply Subtype.ext
      rw [restrictHomogeneous_apply, hp, map_mul, hlin, mul_zero]
      rfl
    show (quadricRelations (restrictedQuadric B g w) d).mkQ (restrictHomogeneous B d p) = 0
    rw [h0, map_zero]
  · -- `a * q_s` restricts to `(restrict a) * q̄_s`, a generator
    show (quadricRelations (restrictedQuadric B g w) d).mkQ (restrictHomogeneous B d p) = 0
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    apply Submodule.subset_span
    refine ⟨s, r, hr, restrictHomogeneous B r a, ?_⟩
    rw [restrictHomogeneous_apply, restrictHomogeneous_apply, hp, map_mul]
    rfl

/-- Every restricted-quadric relation is the restriction of an uncut relation. -/
theorem quadricRelations_le_map {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) (g : ι → MvPolynomial (Fin n) K) (E : ε → ι) (w : κ → ι → K)
    (d : ℕ) :
    quadricRelations (restrictedQuadric B g w) d ≤
      (equationDegreeRelations g E w d).map (restrictHomogeneous B d) := by
  rw [quadricRelations, Submodule.span_le]
  rintro p ⟨s, r, hr, a, hp⟩
  obtain ⟨a', rfl⟩ := restrictHomogeneous_surjective hB r a
  have hq : (equationAnnihilatorQuadric g (w s)).IsHomogeneous 2 :=
    equationAnnihilatorQuadric_isHomogeneous g (w s)
  have hhom : (a'.val * equationAnnihilatorQuadric g (w s)) ∈
      homogeneousSubmodule (Fin n) K d := by
    have := (a'.property : (a'.val).IsHomogeneous r).mul hq
    rwa [hr] at this
  refine ⟨⟨_, hhom⟩, Submodule.subset_span (Or.inr ⟨s, r, hr, a', rfl⟩), ?_⟩
  apply Subtype.ext
  rw [restrictHomogeneous_apply, hp, map_mul, restrictHomogeneous_apply]
  rfl

/-- In positive degree the kernel of the slice quotient map is exactly the uncut relations. -/
theorem ker_sliceQuotientMap_succ {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) (g : ι → MvPolynomial (Fin n) K) (E : ε → ι) (w : κ → ι → K)
    (hvanish : cutLinearSpace g E [] ≤ linearAnnihilator B)
    (hdim : n - m ≤ finrank K (cutLinearSpace g E [])) (e : ℕ) :
    LinearMap.ker (sliceQuotientMap B g w (e + 1)) = equationDegreeRelations g E w (e + 1) := by
  refine le_antisymm ?_ (equationDegreeRelations_le_ker g E w hvanish (e + 1))
  intro f hf
  have hf' : restrictHomogeneous B (e + 1) f ∈ quadricRelations (restrictedQuadric B g w) (e + 1) := by
    have := hf
    rw [LinearMap.mem_ker, sliceQuotientMap, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] at this
    exact this
  obtain ⟨r0, hr0, hr0f⟩ := quadricRelations_le_map hB g E w (e + 1) hf'
  have hW := cutLinearSpace_eq_linearAnnihilator hB hvanish hdim
  have hdiff : f - r0 ∈ LinearMap.ker (restrictHomogeneous B (e + 1)) := by
    rw [LinearMap.mem_ker, map_sub, hr0f, sub_self]
  rw [ker_restrictHomogeneous hB hW e] at hdiff
  have hrel := sliceRelationsIn_cutLinearSpace_le g E w [] e hdiff
  have := Submodule.add_mem _ hrel hr0
  rwa [sub_add_cancel] at this

/-- **Step 4.** The uncut relation quotient in `n` variables has the same dimension as the quotient
of the degree-`d` forms on the `m`-dimensional slice by the restricted quadrics. -/
theorem finrank_equationCutPiece_nil_eq {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) (g : ι → MvPolynomial (Fin n) K) (E : ε → ι) (w : κ → ι → K)
    (hvanish : cutLinearSpace g E [] ≤ linearAnnihilator B)
    (hdim : n - m ≤ finrank K (cutLinearSpace g E [])) (d : ℕ) :
    finrank K (equationCutPiece g E w [] d) =
      finrank K (homogeneousSubmodule (Fin m) K d ⧸
        quadricRelations (restrictedQuadric B g w) d) := by
  cases d with
  | zero =>
    have h0 : equationIteratedCutRelations g E w [] 0 = ⊥ := by
      rw [equationIteratedCutRelations_nil, equationDegreeRelations, Submodule.span_eq_bot]
      rintro p (⟨e, r, hr, _⟩ | ⟨s, r, hr, _⟩) <;> omega
    rw [(Submodule.quotEquivOfEqBot _ h0).finrank_eq,
      (Submodule.quotEquivOfEqBot _ (quadricRelations_zero _)).finrank_eq,
      finrank_homogeneousSubmodule, finrank_homogeneousSubmodule]
    simp
  | succ e =>
    have hker := ker_sliceQuotientMap_succ hB g E w hvanish hdim e
    exact ((Submodule.quotEquivOfEq _ _ hker.symm).trans
      ((sliceQuotientMap B g w (e + 1)).quotKerEquivOfSurjective
        (sliceQuotientMap_surjective hB g w (e + 1)))).finrank_eq

end ChainMid

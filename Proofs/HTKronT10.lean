module

public import HTKronLists

@[expose] public section

/-!
# T component (1, 0): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 438 rows are split at row-type boundaries: idempotency rows [0,105) and
[105,321) (the latter with all frame-sum rows), pairing rows [321,379) and
[379,438). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T10w0 : Z4 := ⟨(), (-), (-), (-)⟩

theorem T10c0 : engine (denLcm (NativeT.rawEntries 1 0)) (NativeT.tSpec 1 0) (((NativeT.rawEntries 1 0).drop 0).take 105) (stateList ystar) =
    T10w0 := by decide +kernel

def T10w1 : Z4 := ⟨(-), (), (), ()⟩

theorem T10c1 : engine (denLcm (NativeT.rawEntries 1 0)) (NativeT.tSpec 1 0) (((NativeT.rawEntries 1 0).drop 105).take 216) (stateList ystar) =
    T10w1 := by decide +kernel

def T10w2 : Z4 := ⟨(-), (), (-), ()⟩

theorem T10c2 : engine (denLcm (NativeT.rawEntries 1 0)) (NativeT.tSpec 1 0) (((NativeT.rawEntries 1 0).drop 321).take 58) (stateList ystar) =
    T10w2 := by decide +kernel

def T10w3 : Z4 := ⟨(), (-), (), (-)⟩

theorem T10c3 : engine (denLcm (NativeT.rawEntries 1 0)) (NativeT.tSpec 1 0) (((NativeT.rawEntries 1 0).drop 379).take 59) (stateList ystar) =
    T10w3 := by decide +kernel

theorem T10len : (NativeT.rawEntries 1 0).length = 438 := by decide +kernel

theorem T10sum : T10w0 + (T10w1 + (T10w2 + (T10w3 + 0))) = tBookValue 1 0 := by decide +kernel

theorem tCheck10 : tValue 1 0 = tBookValue 1 0 := by
  have h0 : tValue 1 0 = engine (denLcm (NativeT.rawEntries 1 0)) (NativeT.tSpec 1 0) ((NativeT.rawEntries 1 0).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 105 105 rfl, T10c0,
    engine_split' _ _ _ _ 105 216 321 rfl, T10c1,
    engine_split' _ _ _ _ 321 58 379 rfl, T10c2,
    engine_split' _ _ _ _ 379 59 438 rfl, T10c3,
    engine_drop_length _ _ _ _ 438 (by rw [T10len])]
  exact T10sum

end Option2.NativeStress.HTRouteKron

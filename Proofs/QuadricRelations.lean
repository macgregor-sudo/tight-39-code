module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous

@[expose] public section

/-!
# A6 compact route: the degree-`d` relation space of a family of forms (single definition)

Moved here unchanged from CHAINMID `SliceQuotient.lean` (feas/CHAINMID/lean, lines 26–36) so that the generic chain
(SliceQuotient, FreeVariables, ChainMidAssembly) and the leading-monomial bound (MONO `LeadingMonomialBound`, which had a
verbatim copy `Mono.quadricRelations`) share ONE constant `ChainMid.quadricRelations`, with a Mathlib-only import.
-/

open MvPolynomial

namespace ChainMid

variable {K : Type*} [Field K]

/-- Degree-`d` part of the ideal generated by a family of forms (literal span of products). -/
noncomputable def quadricRelations {τ κ : Type*} (q : κ → MvPolynomial τ K) (d : ℕ) :
    Submodule K (homogeneousSubmodule τ K d) :=
  Submodule.span K {p | ∃ s : κ, ∃ r : ℕ, r + 2 = d ∧ ∃ a : homogeneousSubmodule τ K r,
    p.val = a.val * q s}

theorem quadricRelations_zero {τ κ : Type*} (q : κ → MvPolynomial τ K) :
    quadricRelations q 0 = ⊥ := by
  rw [quadricRelations, Submodule.span_eq_bot]
  rintro p ⟨s, r, hr, _⟩
  omega

end ChainMid

module

public import A3Averaging
public import NativeIncludedQuartetReadouts

@[expose] public section

/-!
# Real representations of `K = C₃ × C₃` (A4, generic layer)

A `KAction` is an action of `K = C₃ × C₃` on a real vector space, given by the images `g0`, `g1` of
the generators `(1,0)` and `(0,1)`. The four order-three subgroups `H` are generated by
`(1,0), (0,1), (2,2), (2,1)` (index `0, 1, 2, 3`, as in A3's `anchorGenerator`); `gen H` is the
image of that generator, `fixH H` its fixed space and `fixK` the common fixed space.

The actual two-dimensional real types `V_H`: `ℂ` with `(1,0)` acting by `ω ^ a` and `(0,1)` by `ω ^ b`,
where `kChar H = (a, b)` is the root character of MASTER §6.6 (kernel exactly `H`). The standard model
`stdAction m n` is `ℝ^m_triv ⊕ ⨁_H V_H^(n H)`.

This file also gives restriction to an invariant subspace, the quotient action, the product action,
equivariant equivalences (`KEquiv`), and exactness of invariants for quotients.
No native object enters.
-/

noncomputable section

namespace CKM.NativeIntrinsicTriality

open CKM.NativeFirstOrder (fixedSpace mem_fixedSpace)

/-- The primitive cube root of unity of the accepted three-cycle Fourier data. -/
abbrev ω : ℂ := UnitaryErrorBases.ThreeCycleFourier.omega

/-! ### Generic helpers (added by KREP) -/

section Helpers

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

theorem krep_pow_three (g : Module.End ℝ V) : g ^ 3 = g * (g * g) := by
  rw [pow_succ, pow_two, mul_assoc]

theorem krep_cube_apply {g : Module.End ℝ V} (h : g ^ 3 = 1) (v : V) : g (g (g v)) = v := by
  have := LinearMap.congr_fun h v
  rwa [krep_pow_three] at this

theorem krep_comm_apply {a b : Module.End ℝ V} (h : a * b = b * a) (v : V) : a (b v) = b (a v) :=
  LinearMap.congr_fun h v

theorem krep_omega_pow_cube (k : ℕ) : (ω ^ k) ^ 3 = 1 := by
  rw [← pow_mul, mul_comm, pow_mul, UnitaryErrorBases.ThreeCycleFourier.omega_cube, one_pow]

theorem krep_omega_re : ω.re = -1 / 2 := by
  simp [UnitaryErrorBases.ThreeCycleFourier.omega]

theorem krep_omega_ne_one : ω ≠ 1 := by
  intro h
  have := congrArg Complex.re h
  rw [krep_omega_re, Complex.one_re] at this
  norm_num at this

theorem krep_omega_sq_ne_one : ω ^ 2 ≠ 1 := by
  intro h
  apply krep_omega_ne_one
  have h3 := UnitaryErrorBases.ThreeCycleFourier.omega_cube
  rw [pow_succ, h, one_mul] at h3
  exact h3

theorem krep_omega_pow_eq_one_iff (k : ℕ) : ω ^ k = 1 ↔ k % 3 = 0 := by
  rw [pow_eq_pow_mod k UnitaryErrorBases.ThreeCycleFourier.omega_cube]
  have hk : k % 3 < 3 := Nat.mod_lt _ (by norm_num)
  generalize k % 3 = r at hk ⊢
  interval_cases r
  · simp
  · simp [krep_omega_ne_one]
  · exact iff_of_false krep_omega_sq_ne_one (by norm_num)

/-- Averaging `(w + g w + g² w)/3` along an order-three endomorphism. -/
def krepAvg (g : Module.End ℝ V) (w : V) : V := (3 : ℝ)⁻¹ • (w + g w + g (g w))

theorem krepAvg_fixed {g : Module.End ℝ V} (hg : g ^ 3 = 1) (w : V) :
    g (krepAvg g w) = krepAvg g w := by
  simp only [krepAvg, map_smul, map_add, krep_cube_apply hg]
  congr 1
  abel

theorem krepAvg_comm {g h : Module.End ℝ V} (hc : ∀ v, h (g v) = g (h v)) (w : V) :
    h (krepAvg g w) = krepAvg g (h w) := by
  simp only [krepAvg, map_smul, map_add, hc]

theorem krepAvg_sub (g : Module.End ℝ V) (a b : V) :
    krepAvg g (a - b) = krepAvg g a - krepAvg g b := by
  simp only [krepAvg, map_sub]
  module

theorem krepAvg_mem {U : Submodule ℝ V} {g : Module.End ℝ V} (hU : ∀ v ∈ U, g v ∈ U) {v : V}
    (hv : v ∈ U) : krepAvg g v ∈ U :=
  U.smul_mem _ (U.add_mem (U.add_mem hv (hU v hv)) (hU _ (hU v hv)))

theorem krepAvg_sub_mem {U : Submodule ℝ V} {g : Module.End ℝ V} (hU : ∀ v ∈ U, g v ∈ U) {w : V}
    (hw : g w - w ∈ U) : w - krepAvg g w ∈ U := by
  have h2 : g (g w) - w ∈ U := by
    have := U.add_mem (hU _ hw) hw
    rwa [map_sub, sub_add_sub_cancel] at this
  have e : w - krepAvg g w = (3 : ℝ)⁻¹ • (-(g w - w) - (g (g w) - w)) := by
    simp only [krepAvg]
    module
  rw [e]
  exact U.smul_mem _ (U.sub_mem (U.neg_mem hw) h2)

end Helpers

/-- An action of `K = C₃ × C₃` on a real vector space by the images of `(1,0)` and `(0,1)`. -/
structure KAction (V : Type*) [AddCommGroup V] [Module ℝ V] where
  g0 : Module.End ℝ V
  g1 : Module.End ℝ V
  g0_cube : g0 ^ 3 = 1
  g1_cube : g1 ^ 3 = 1
  comm : g0 * g1 = g1 * g0

namespace KAction

variable {V W : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]

/-- Image of the generator of the subgroup `H`: `(1,0), (0,1), (2,2), (2,1)`. -/
def gen (ρ : KAction V) : Fin 4 → Module.End ℝ V
  | 0 => ρ.g0
  | 1 => ρ.g1
  | 2 => ρ.g0 ^ 2 * ρ.g1 ^ 2
  | 3 => ρ.g0 ^ 2 * ρ.g1

/-- The `H`-fixed subspace. -/
def fixH (ρ : KAction V) (H : Fin 4) : Submodule ℝ V := fixedSpace (ρ.gen H)

/-- The `K`-fixed subspace. -/
def fixK (ρ : KAction V) : Submodule ℝ V := fixedSpace ρ.g0 ⊓ fixedSpace ρ.g1

/-- An invariant subspace. -/
def IsInvariant (ρ : KAction V) (U : Submodule ℝ V) : Prop :=
  (∀ v ∈ U, ρ.g0 v ∈ U) ∧ (∀ v ∈ U, ρ.g1 v ∈ U)

/-- Restriction to an invariant subspace. -/
def restrict (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) : KAction U where
  g0 := ρ.g0.restrict hU.1
  g1 := ρ.g1.restrict hU.2
  g0_cube := by
    refine LinearMap.ext fun u => Subtype.ext ?_
    rw [krep_pow_three]
    simp only [Module.End.mul_apply, LinearMap.coe_restrict_apply, Module.End.one_apply]
    exact krep_cube_apply ρ.g0_cube u
  g1_cube := by
    refine LinearMap.ext fun u => Subtype.ext ?_
    rw [krep_pow_three]
    simp only [Module.End.mul_apply, LinearMap.coe_restrict_apply, Module.End.one_apply]
    exact krep_cube_apply ρ.g1_cube u
  comm := by
    refine LinearMap.ext fun u => Subtype.ext ?_
    simp only [Module.End.mul_apply, LinearMap.coe_restrict_apply]
    exact krep_comm_apply ρ.comm u

/-- The quotient action on `V ⧸ U`. -/
def quot (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) : KAction (V ⧸ U) where
  g0 := U.mapQ U ρ.g0 hU.1
  g1 := U.mapQ U ρ.g1 hU.2
  g0_cube := by
    apply Submodule.linearMap_qext
    refine LinearMap.ext fun v => ?_
    rw [krep_pow_three]
    simp only [LinearMap.comp_apply, Submodule.mkQ_apply, Module.End.mul_apply, Submodule.mapQ_apply,
      Module.End.one_apply, krep_cube_apply ρ.g0_cube]
  g1_cube := by
    apply Submodule.linearMap_qext
    refine LinearMap.ext fun v => ?_
    rw [krep_pow_three]
    simp only [LinearMap.comp_apply, Submodule.mkQ_apply, Module.End.mul_apply, Submodule.mapQ_apply,
      Module.End.one_apply, krep_cube_apply ρ.g1_cube]
  comm := by
    apply Submodule.linearMap_qext
    refine LinearMap.ext fun v => ?_
    simp only [LinearMap.comp_apply, Submodule.mkQ_apply, Module.End.mul_apply, Submodule.mapQ_apply,
      krep_comm_apply ρ.comm]

/-- The product action. -/
def prod (ρ : KAction V) (σ : KAction W) : KAction (V × W) where
  g0 := LinearMap.prodMap ρ.g0 σ.g0
  g1 := LinearMap.prodMap ρ.g1 σ.g1
  g0_cube := by
    rw [krep_pow_three]
    refine LinearMap.ext fun p => Prod.ext ?_ ?_ <;>
    simp only [Module.End.mul_apply, LinearMap.prodMap_apply, Module.End.one_apply,
      krep_cube_apply ρ.g0_cube, krep_cube_apply σ.g0_cube]
  g1_cube := by
    rw [krep_pow_three]
    refine LinearMap.ext fun p => Prod.ext ?_ ?_ <;>
    simp only [Module.End.mul_apply, LinearMap.prodMap_apply, Module.End.one_apply,
      krep_cube_apply ρ.g1_cube, krep_cube_apply σ.g1_cube]
  comm := by
    refine LinearMap.ext fun p => Prod.ext ?_ ?_ <;>
    simp only [Module.End.mul_apply, LinearMap.prodMap_apply, krep_comm_apply ρ.comm,
      krep_comm_apply σ.comm]

/-- Transport of a relation preserved by products from the generators to every `gen H`. -/
theorem gen_rel {X : Type*} [AddCommGroup X] [Module ℝ X] (ρ : KAction V) (σ : KAction X)
    (S : Module.End ℝ V → Module.End ℝ X → Prop)
    (hmul : ∀ a b c d, S a b → S c d → S (a * c) (b * d)) (h0 : S ρ.g0 σ.g0) (h1 : S ρ.g1 σ.g1)
    (H : Fin 4) : S (ρ.gen H) (σ.gen H) := by
  fin_cases H
  · exact h0
  · exact h1
  · show S (ρ.g0 ^ 2 * ρ.g1 ^ 2) (σ.g0 ^ 2 * σ.g1 ^ 2)
    simp only [pow_two]
    exact hmul _ _ _ _ (hmul _ _ _ _ h0 h0) (hmul _ _ _ _ h1 h1)
  · show S (ρ.g0 ^ 2 * ρ.g1) (σ.g0 ^ 2 * σ.g1)
    simp only [pow_two]
    exact hmul _ _ _ _ (hmul _ _ _ _ h0 h0) h1

theorem gen_cube (ρ : KAction V) (H : Fin 4) : ρ.gen H ^ 3 = 1 := by
  have hc : Commute ρ.g0 ρ.g1 := ρ.comm
  fin_cases H
  · exact ρ.g0_cube
  · exact ρ.g1_cube
  · show (ρ.g0 ^ 2 * ρ.g1 ^ 2) ^ 3 = 1
    rw [(hc.pow_pow 2 2).mul_pow 3, ← pow_mul, ← pow_mul, mul_comm 2 3, pow_mul, pow_mul, ρ.g0_cube,
      ρ.g1_cube, one_pow, one_mul]
  · show (ρ.g0 ^ 2 * ρ.g1) ^ 3 = 1
    rw [(hc.pow_left 2).mul_pow 3, ← pow_mul, mul_comm 2 3, pow_mul, ρ.g0_cube, ρ.g1_cube, one_pow,
      one_mul]

theorem gen_invariant (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) (H : Fin 4) :
    ∀ v ∈ U, ρ.gen H v ∈ U :=
  gen_rel ρ ρ (fun a _ => ∀ v ∈ U, a v ∈ U) (fun _ _ _ _ hab hcd v hv => hab _ (hcd v hv))
    hU.1 hU.2 H

theorem restrict_gen_apply (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) (H : Fin 4)
    (u : U) : ((ρ.restrict U hU).gen H u : V) = ρ.gen H u :=
  gen_rel (ρ.restrict U hU) ρ (fun a b => ∀ u : U, (a u : V) = b u)
    (fun a b c d hab hcd u => by rw [Module.End.mul_apply, hab, hcd, Module.End.mul_apply])
    (fun _ => rfl) (fun _ => rfl) H u

theorem quot_gen_apply (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) (H : Fin 4)
    (w : V) : (ρ.quot U hU).gen H (Submodule.Quotient.mk w) = Submodule.Quotient.mk (ρ.gen H w) :=
  gen_rel (ρ.quot U hU) ρ
    (fun a b => ∀ w, a (Submodule.Quotient.mk w) = Submodule.Quotient.mk (b w))
    (fun a b c d hab hcd w => by rw [Module.End.mul_apply, hcd, hab, Module.End.mul_apply])
    (fun _ => rfl) (fun _ => rfl) H w

theorem prod_gen (ρ : KAction V) (σ : KAction W) (H : Fin 4) :
    (ρ.prod σ).gen H = LinearMap.prodMap (ρ.gen H) (σ.gen H) := by
  have h1 := gen_rel (ρ.prod σ) ρ (fun a b => ∀ p, (a p).1 = b p.1)
    (fun a b c d hab hcd p => by rw [Module.End.mul_apply, hab, hcd, Module.End.mul_apply])
    (fun _ => rfl) (fun _ => rfl) H
  have h2 := gen_rel (ρ.prod σ) σ (fun a b => ∀ p, (a p).2 = b p.2)
    (fun a b c d hab hcd p => by rw [Module.End.mul_apply, hab, hcd, Module.End.mul_apply])
    (fun _ => rfl) (fun _ => rfl) H
  exact LinearMap.ext fun p => Prod.ext (h1 p) (h2 p)

end KAction

/-- A `K`-equivariant real-linear equivalence. -/
structure KEquiv {V W : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
    (ρ : KAction V) (σ : KAction W) extends V ≃ₗ[ℝ] W where
  map_g0 : ∀ v, toLinearEquiv (ρ.g0 v) = σ.g0 (toLinearEquiv v)
  map_g1 : ∀ v, toLinearEquiv (ρ.g1 v) = σ.g1 (toLinearEquiv v)

namespace KEquiv

variable {V W X : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  [AddCommGroup X] [Module ℝ X] {ρ : KAction V} {σ : KAction W} {θ : KAction X}

def refl (ρ : KAction V) : KEquiv ρ ρ where
  toLinearEquiv := LinearEquiv.refl ℝ V
  map_g0 := fun _ => rfl
  map_g1 := fun _ => rfl

def symm (e : KEquiv ρ σ) : KEquiv σ ρ where
  toLinearEquiv := e.toLinearEquiv.symm
  map_g0 := fun w => e.toLinearEquiv.injective (by
    rw [LinearEquiv.apply_symm_apply, e.map_g0, LinearEquiv.apply_symm_apply])
  map_g1 := fun w => e.toLinearEquiv.injective (by
    rw [LinearEquiv.apply_symm_apply, e.map_g1, LinearEquiv.apply_symm_apply])

def trans (e : KEquiv ρ σ) (f : KEquiv σ θ) : KEquiv ρ θ where
  toLinearEquiv := e.toLinearEquiv.trans f.toLinearEquiv
  map_g0 := fun v => by rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, e.map_g0, f.map_g0]
  map_g1 := fun v => by rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, e.map_g1, f.map_g1]

theorem map_gen (e : KEquiv ρ σ) (H : Fin 4) (v : V) :
    e.toLinearEquiv (ρ.gen H v) = σ.gen H (e.toLinearEquiv v) :=
  KAction.gen_rel ρ σ (fun a b => ∀ v, e.toLinearEquiv (a v) = b (e.toLinearEquiv v))
    (fun a b c d hab hcd v => by rw [Module.End.mul_apply, hab, hcd, Module.End.mul_apply])
    e.map_g0 e.map_g1 H v

theorem krep_finrank_eq_of_equiv (e : V ≃ₗ[ℝ] W) (p : Submodule ℝ V) (q : Submodule ℝ W)
    (h : ∀ v, v ∈ p ↔ e v ∈ q) : Module.finrank ℝ p = Module.finrank ℝ q := by
  have hpq : p.map (e : V →ₗ[ℝ] W) = q := by
    ext w
    rw [Submodule.mem_map_equiv, h, LinearEquiv.apply_symm_apply]
  exact (e.ofSubmodules p q hpq).finrank_eq

theorem finrank_fixH_eq (e : KEquiv ρ σ) (H : Fin 4) :
    Module.finrank ℝ (ρ.fixH H) = Module.finrank ℝ (σ.fixH H) := by
  refine krep_finrank_eq_of_equiv e.toLinearEquiv _ _ fun v => ?_
  simp only [KAction.fixH, mem_fixedSpace]
  rw [← e.map_gen H v]
  exact e.toLinearEquiv.injective.eq_iff.symm

theorem finrank_fixK_eq (e : KEquiv ρ σ) :
    Module.finrank ℝ ρ.fixK = Module.finrank ℝ σ.fixK := by
  refine krep_finrank_eq_of_equiv e.toLinearEquiv _ _ fun v => ?_
  simp only [KAction.fixK, Submodule.mem_inf, mem_fixedSpace]
  rw [← e.map_g0 v, ← e.map_g1 v, e.toLinearEquiv.injective.eq_iff, e.toLinearEquiv.injective.eq_iff]

end KEquiv

/-! ## The four real types and the standard model -/

/-- Root characters `(a, b)` of MASTER §6.6, in subgroup order `H₀, H₁, H₂, H₃`;
each has kernel exactly the subgroup generated by `(1,0), (0,1), (2,2), (2,1)` respectively. -/
def kChar : Fin 4 → ZMod 3 × ZMod 3 := ![(0, 2), (1, 0), (2, 1), (1, 1)]

/-- Real-linear multiplication by a complex scalar. -/
def cmul (c : ℂ) : Module.End ℝ ℂ := LinearMap.mulLeft ℝ c

theorem krep_cmul_apply (c z : ℂ) : cmul c z = c * z := rfl

/-- The two-dimensional real type `V_H`: `ℂ`, with `(1,0) ↦ ω^a`, `(0,1) ↦ ω^b`, `kChar H = (a,b)`. -/
def typeAction (H : Fin 4) : KAction ℂ where
  g0 := cmul (ω ^ (kChar H).1.val)
  g1 := cmul (ω ^ (kChar H).2.val)
  g0_cube := by
    rw [krep_pow_three]
    refine LinearMap.ext fun z => ?_
    simp only [Module.End.mul_apply, krep_cmul_apply, Module.End.one_apply]
    linear_combination z * krep_omega_pow_cube (kChar H).1.val
  g1_cube := by
    rw [krep_pow_three]
    refine LinearMap.ext fun z => ?_
    simp only [Module.End.mul_apply, krep_cmul_apply, Module.End.one_apply]
    linear_combination z * krep_omega_pow_cube (kChar H).2.val
  comm := by
    refine LinearMap.ext fun z => ?_
    simp only [Module.End.mul_apply, krep_cmul_apply]
    ring

/-- Underlying space of `ℝ^m_triv ⊕ ⨁_H V_H^(n H)`. -/
abbrev StdSpace (m : ℕ) (n : Fin 4 → ℕ) := (Fin m → ℝ) × ((H : Fin 4) → Fin (n H) → ℂ)

/-- Componentwise action of the characters on `⨁_H V_H^(n H)`, with exponents `e H`. -/
def stdIso (n : Fin 4 → ℕ) (e : Fin 4 → ℕ) : Module.End ℝ ((H : Fin 4) → Fin (n H) → ℂ) :=
  LinearMap.pi fun H => LinearMap.pi fun i =>
    cmul (ω ^ e H) ∘ₗ (LinearMap.proj i ∘ₗ LinearMap.proj (φ := fun H => Fin (n H) → ℂ) H)

theorem krep_stdIso_apply (n : Fin 4 → ℕ) (e : Fin 4 → ℕ) (y : (H : Fin 4) → Fin (n H) → ℂ)
    (H : Fin 4) (i : Fin (n H)) : stdIso n e y H i = ω ^ e H * y H i := rfl

/-- The standard model `ℝ^m_triv ⊕ ⨁_H V_H^(n H)`. -/
def stdAction (m : ℕ) (n : Fin 4 → ℕ) : KAction (StdSpace m n) where
  g0 := LinearMap.prodMap LinearMap.id (stdIso n fun H => (kChar H).1.val)
  g1 := LinearMap.prodMap LinearMap.id (stdIso n fun H => (kChar H).2.val)
  g0_cube := by
    rw [krep_pow_three]
    refine LinearMap.ext fun p => Prod.ext ?_ (funext fun H => funext fun i => ?_)
    · simp only [Module.End.mul_apply, LinearMap.prodMap_apply, LinearMap.id_apply,
        Module.End.one_apply]
    · simp only [Module.End.mul_apply, LinearMap.prodMap_apply, Module.End.one_apply,
        krep_stdIso_apply]
      linear_combination p.2 H i * krep_omega_pow_cube (kChar H).1.val
  g1_cube := by
    rw [krep_pow_three]
    refine LinearMap.ext fun p => Prod.ext ?_ (funext fun H => funext fun i => ?_)
    · simp only [Module.End.mul_apply, LinearMap.prodMap_apply, LinearMap.id_apply,
        Module.End.one_apply]
    · simp only [Module.End.mul_apply, LinearMap.prodMap_apply, Module.End.one_apply,
        krep_stdIso_apply]
      linear_combination p.2 H i * krep_omega_pow_cube (kChar H).2.val
  comm := by
    refine LinearMap.ext fun p => Prod.ext ?_ (funext fun H => funext fun i => ?_)
    · simp only [Module.End.mul_apply, LinearMap.prodMap_apply, LinearMap.id_apply]
    · simp only [Module.End.mul_apply, LinearMap.prodMap_apply, krep_stdIso_apply]
      ring

/-- Exponent of `ω` by which `gen H` acts on the `H'` component of the standard model. -/
def krepExp (H H' : Fin 4) : ℕ :=
  match H with
  | 0 => (kChar H').1.val
  | 1 => (kChar H').2.val
  | 2 => 2 * (kChar H').1.val + 2 * (kChar H').2.val
  | 3 => 2 * (kChar H').1.val + (kChar H').2.val

theorem krepExp_mod (H H' : Fin 4) : krepExp H H' % 3 = 0 ↔ H' = H := by
  revert H H'
  decide

theorem krep_omega_krepExp (H H' : Fin 4) : ω ^ krepExp H H' = 1 ↔ H' = H := by
  rw [krep_omega_pow_eq_one_iff, krepExp_mod]

theorem krep_std_gen_fst (m : ℕ) (n : Fin 4 → ℕ) (H : Fin 4) (p : StdSpace m n) :
    ((stdAction m n).gen H p).1 = p.1 := by
  fin_cases H
  · rfl
  · rfl
  · show (((stdAction m n).g0 ^ 2 * (stdAction m n).g1 ^ 2) p).1 = p.1
    rfl
  · show (((stdAction m n).g0 ^ 2 * (stdAction m n).g1) p).1 = p.1
    rfl

theorem krep_std_gen_snd (m : ℕ) (n : Fin 4 → ℕ) (H : Fin 4) (p : StdSpace m n) (H' : Fin 4)
    (i : Fin (n H')) : ((stdAction m n).gen H p).2 H' i = ω ^ krepExp H H' * p.2 H' i := by
  fin_cases H
  · rfl
  · rfl
  · show (((stdAction m n).g0 ^ 2 * (stdAction m n).g1 ^ 2) p).2 H' i =
      ω ^ (2 * (kChar H').1.val + 2 * (kChar H').2.val) * p.2 H' i
    simp only [pow_two, Module.End.mul_apply]
    simp only [stdAction, LinearMap.prodMap_apply, krep_stdIso_apply]
    ring
  · show (((stdAction m n).g0 ^ 2 * (stdAction m n).g1) p).2 H' i =
      ω ^ (2 * (kChar H').1.val + (kChar H').2.val) * p.2 H' i
    simp only [pow_two, Module.End.mul_apply]
    simp only [stdAction, LinearMap.prodMap_apply, krep_stdIso_apply]
    ring

theorem krep_std_mem_fixH (m : ℕ) (n : Fin 4 → ℕ) (H : Fin 4) (p : StdSpace m n) :
    p ∈ (stdAction m n).fixH H ↔ ∀ H', H' ≠ H → p.2 H' = 0 := by
  rw [KAction.fixH, mem_fixedSpace]
  constructor
  · intro hp H' hH'
    funext i
    have h1 : ((stdAction m n).gen H p).2 H' i = p.2 H' i := by rw [hp]
    rw [krep_std_gen_snd] at h1
    have hne : ω ^ krepExp H H' ≠ 1 := fun h => hH' ((krep_omega_krepExp H H').1 h)
    have h2 : (ω ^ krepExp H H' - 1) * p.2 H' i = 0 := by rw [sub_mul, one_mul, h1, sub_self]
    rcases mul_eq_zero.1 h2 with h | h
    · exact absurd (sub_eq_zero.1 h) hne
    · exact h
  · intro hp
    refine Prod.ext (krep_std_gen_fst m n H p) (funext fun H' => funext fun i => ?_)
    rw [krep_std_gen_snd]
    by_cases h : H' = H
    · rw [(krep_omega_krepExp H H').2 h, one_mul]
    · simp only [hp H' h, Pi.zero_apply, mul_zero]

theorem krep_std_mem_fixK (m : ℕ) (n : Fin 4 → ℕ) (p : StdSpace m n) :
    p ∈ (stdAction m n).fixK ↔ p.2 = 0 := by
  constructor
  · intro hp
    have h0 : p ∈ (stdAction m n).fixH 0 := hp.1
    have h1 : p ∈ (stdAction m n).fixH 1 := hp.2
    rw [krep_std_mem_fixH] at h0 h1
    funext H'
    by_cases h : H' = 0
    · exact h1 H' (by rw [h]; decide)
    · exact h0 H' h
  · intro hp
    have h0 : p ∈ (stdAction m n).fixH 0 := (krep_std_mem_fixH m n 0 p).2 fun H' _ => by rw [hp]; rfl
    have h1 : p ∈ (stdAction m n).fixH 1 := (krep_std_mem_fixH m n 1 p).2 fun H' _ => by rw [hp]; rfl
    exact ⟨h0, h1⟩

/-! ## Fixed dimensions -/

section Dims

variable {V W : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]

theorem krep_finrank_subtype (U : Submodule ℝ V) (p : Submodule ℝ U) (q : Submodule ℝ V)
    (hq : q ≤ U) (h : ∀ u : U, u ∈ p ↔ (u : V) ∈ q) :
    Module.finrank ℝ p = Module.finrank ℝ q := by
  have hmap : p.map U.subtype = q := by
    ext x
    simp only [Submodule.mem_map, Submodule.subtype_apply]
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact (h y).1 hy
    · intro hx
      exact ⟨⟨x, hq hx⟩, (h _).2 hx, rfl⟩
  rw [← hmap, Submodule.finrank_map_subtype_eq]

theorem krep_fixedSpace_prodMap (f : Module.End ℝ V) (g : Module.End ℝ W) :
    fixedSpace (LinearMap.prodMap f g) = (fixedSpace f).prod (fixedSpace g) := by
  ext ⟨v, w⟩
  simp only [mem_fixedSpace, Submodule.mem_prod, LinearMap.prodMap_apply, Prod.mk.injEq]

theorem krep_finrank_prod [FiniteDimensional ℝ V] [FiniteDimensional ℝ W] (p : Submodule ℝ V)
    (q : Submodule ℝ W) :
    Module.finrank ℝ (p.prod q) = Module.finrank ℝ p + Module.finrank ℝ q := by
  have hinj : Function.Injective (p.subtype.prodMap q.subtype) := by
    rintro ⟨a, b⟩ ⟨c, d⟩ h
    simp only [LinearMap.prodMap_apply, Prod.mk.injEq, Submodule.subtype_apply] at h
    rw [Subtype.ext h.1, Subtype.ext h.2]
  have := LinearMap.finrank_range_of_inj hinj
  rw [LinearMap.range_prodMap, Submodule.range_subtype, Submodule.range_subtype,
    Module.finrank_prod] at this
  exact this

theorem krep_finrank_fixH_restrict (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U)
    (H : Fin 4) :
    Module.finrank ℝ ((ρ.restrict U hU).fixH H) = Module.finrank ℝ ↥(ρ.fixH H ⊓ U) := by
  refine krep_finrank_subtype U _ _ inf_le_right fun u => ?_
  simp only [KAction.fixH, mem_fixedSpace, Submodule.mem_inf]
  rw [← ρ.restrict_gen_apply U hU H u]
  exact ⟨fun h => ⟨congrArg Subtype.val h, u.2⟩, fun h => Subtype.ext h.1⟩

theorem krep_finrank_fixK_restrict (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) :
    Module.finrank ℝ (ρ.restrict U hU).fixK = Module.finrank ℝ ↥(ρ.fixK ⊓ U) := by
  refine krep_finrank_subtype U _ _ inf_le_right fun u => ?_
  simp only [KAction.fixK, mem_fixedSpace, Submodule.mem_inf]
  exact ⟨fun h => ⟨⟨congrArg Subtype.val h.1, congrArg Subtype.val h.2⟩, u.2⟩,
    fun h => ⟨Subtype.ext h.1.1, Subtype.ext h.1.2⟩⟩

/-- Exactness of a fixed-part sequence, given surjectivity up to `U` (averaging). -/
theorem krep_exact [FiniteDimensional ℝ V] (U F : Submodule ℝ V) (Fq : Submodule ℝ (V ⧸ U))
    (hF : ∀ v ∈ F, U.mkQ v ∈ Fq) (hs : ∀ w, U.mkQ w ∈ Fq → ∃ f ∈ F, w - f ∈ U) :
    Module.finrank ℝ Fq + Module.finrank ℝ ↥(F ⊓ U) = Module.finrank ℝ F := by
  have hr : LinearMap.range (U.mkQ ∘ₗ F.subtype) = Fq := by
    ext q
    obtain ⟨w, rfl⟩ := U.mkQ_surjective q
    rw [LinearMap.mem_range]
    constructor
    · rintro ⟨f, hf⟩
      rw [← hf]
      exact hF f f.2
    · intro hw
      obtain ⟨f, hfF, hwf⟩ := hs w hw
      refine ⟨⟨f, hfF⟩, ?_⟩
      simp only [LinearMap.comp_apply, Submodule.subtype_apply, Submodule.mkQ_apply]
      refine (Submodule.Quotient.eq U).2 ?_
      rw [← neg_sub]
      exact U.neg_mem hwf
  have hk : Module.finrank ℝ (LinearMap.ker (U.mkQ ∘ₗ F.subtype)) = Module.finrank ℝ ↥(F ⊓ U) := by
    refine krep_finrank_subtype F _ _ inf_le_left fun u => ?_
    simp only [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.subtype_apply,
      Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_inf]
    exact ⟨fun h => ⟨u.2, h⟩, fun h => h.2⟩
  rw [← hr, ← hk]
  exact LinearMap.finrank_range_add_finrank_ker _

theorem krep_finrank_complex : Module.finrank ℝ ℂ = 2 := by
  rw [Module.finrank_eq_card_basis Complex.basisOneI, Fintype.card_fin]

theorem finrank_fixK_std (m : ℕ) (n : Fin 4 → ℕ) :
    Module.finrank ℝ (stdAction m n).fixK = m := by
  have h : (stdAction m n).fixK =
      LinearMap.range (LinearMap.inl ℝ (Fin m → ℝ) ((H : Fin 4) → Fin (n H) → ℂ)) := by
    ext ⟨x, y⟩
    rw [krep_std_mem_fixK, LinearMap.mem_range]
    constructor
    · intro hy
      exact ⟨x, by rw [LinearMap.inl_apply, show y = 0 from hy]⟩
    · rintro ⟨x', hx'⟩
      rw [LinearMap.inl_apply, Prod.mk.injEq] at hx'
      exact hx'.2.symm
  rw [h, LinearMap.finrank_range_of_inj LinearMap.inl_injective, Module.finrank_fin_fun]

theorem finrank_fixH_std (m : ℕ) (n : Fin 4 → ℕ) (H : Fin 4) :
    Module.finrank ℝ ((stdAction m n).fixH H) = m + 2 * n H := by
  let φ : ((Fin m → ℝ) × (Fin (n H) → ℂ)) →ₗ[ℝ] StdSpace m n :=
    LinearMap.prodMap LinearMap.id (LinearMap.single ℝ (fun H => Fin (n H) → ℂ) H)
  have hφ : ∀ x z, φ (x, z) = (x, Pi.single (M := fun H => Fin (n H) → ℂ) H z) := fun _ _ => rfl
  have hinj : Function.Injective φ := by
    rintro ⟨x, z⟩ ⟨x', z'⟩ h
    rw [hφ, hφ, Prod.mk.injEq] at h
    obtain ⟨rfl, h2⟩ := h
    have h3 := congrFun h2 H
    simp only [Pi.single_eq_same] at h3
    rw [h3]
  have h : (stdAction m n).fixH H = LinearMap.range φ := by
    ext ⟨x, y⟩
    rw [krep_std_mem_fixH, LinearMap.mem_range]
    constructor
    · intro hy
      refine ⟨(x, y H), ?_⟩
      rw [hφ, Prod.mk.injEq]
      refine ⟨rfl, funext fun H' => ?_⟩
      by_cases hH : H' = H
      · subst hH
        rw [Pi.single_eq_same]
      · rw [Pi.single_eq_of_ne hH]
        exact (hy H' hH).symm
    · rintro ⟨⟨x', z⟩, hxz⟩ H' hH
      rw [hφ, Prod.mk.injEq] at hxz
      rw [← hxz.2]
      exact Pi.single_eq_of_ne (M := fun H => Fin (n H) → ℂ) hH z
  have : FiniteDimensional ℝ ℂ := Complex.basisOneI.finiteDimensional_of_finite
  rw [h, LinearMap.finrank_range_of_inj hinj, Module.finrank_prod, Module.finrank_fin_fun,
    Module.finrank_pi_fintype]
  simp only [krep_finrank_complex, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    smul_eq_mul]
  ring

theorem finrank_fixH_prod [FiniteDimensional ℝ V] [FiniteDimensional ℝ W]
    (ρ : KAction V) (σ : KAction W) (H : Fin 4) :
    Module.finrank ℝ ((ρ.prod σ).fixH H) = Module.finrank ℝ (ρ.fixH H) + Module.finrank ℝ (σ.fixH H) := by
  rw [KAction.fixH, KAction.prod_gen, krep_fixedSpace_prodMap, krep_finrank_prod]
  rfl

theorem finrank_fixK_prod [FiniteDimensional ℝ V] [FiniteDimensional ℝ W]
    (ρ : KAction V) (σ : KAction W) :
    Module.finrank ℝ (ρ.prod σ).fixK = Module.finrank ℝ ρ.fixK + Module.finrank ℝ σ.fixK := by
  show Module.finrank ℝ ↥(fixedSpace (LinearMap.prodMap ρ.g0 σ.g0) ⊓
    fixedSpace (LinearMap.prodMap ρ.g1 σ.g1)) = _
  rw [krep_fixedSpace_prodMap, krep_fixedSpace_prodMap, Submodule.prod_inf_prod, krep_finrank_prod]
  rfl

/-- **Exactness of invariants** (characteristic zero averaging) for the `H`-fixed part. -/
theorem finrank_fixH_quot [FiniteDimensional ℝ V] (ρ : KAction V) (U : Submodule ℝ V)
    (hU : ρ.IsInvariant U) (H : Fin 4) :
    Module.finrank ℝ ((ρ.quot U hU).fixH H) + Module.finrank ℝ ((ρ.restrict U hU).fixH H) =
      Module.finrank ℝ (ρ.fixH H) := by
  rw [krep_finrank_fixH_restrict]
  apply krep_exact U (ρ.fixH H) ((ρ.quot U hU).fixH H)
  · intro v hv
    rw [KAction.fixH, mem_fixedSpace] at hv ⊢
    rw [Submodule.mkQ_apply, KAction.quot_gen_apply, hv]
  · intro w hw
    rw [KAction.fixH, mem_fixedSpace, Submodule.mkQ_apply, KAction.quot_gen_apply,
      Submodule.Quotient.eq] at hw
    refine ⟨krepAvg (ρ.gen H) w, ?_, krepAvg_sub_mem (ρ.gen_invariant U hU H) hw⟩
    rw [KAction.fixH, mem_fixedSpace]
    exact krepAvg_fixed (ρ.gen_cube H) w

/-- **Exactness of invariants** for the `K`-fixed part. -/
theorem finrank_fixK_quot [FiniteDimensional ℝ V] (ρ : KAction V) (U : Submodule ℝ V)
    (hU : ρ.IsInvariant U) :
    Module.finrank ℝ (ρ.quot U hU).fixK + Module.finrank ℝ (ρ.restrict U hU).fixK =
      Module.finrank ℝ ρ.fixK := by
  rw [krep_finrank_fixK_restrict]
  have q0 : ∀ w, (ρ.quot U hU).g0 (Submodule.Quotient.mk w) = Submodule.Quotient.mk (ρ.g0 w) :=
    fun _ => rfl
  have q1 : ∀ w, (ρ.quot U hU).g1 (Submodule.Quotient.mk w) = Submodule.Quotient.mk (ρ.g1 w) :=
    fun _ => rfl
  apply krep_exact U ρ.fixK (ρ.quot U hU).fixK
  · intro v hv
    simp only [KAction.fixK, Submodule.mem_inf, mem_fixedSpace] at hv ⊢
    rw [Submodule.mkQ_apply, q0, q1, hv.1, hv.2]
    exact ⟨rfl, rfl⟩
  · intro w hw
    simp only [KAction.fixK, Submodule.mem_inf, mem_fixedSpace, Submodule.mkQ_apply, q0, q1,
      Submodule.Quotient.eq] at hw
    -- average over `g1`, then over `g0`
    set w1 := krepAvg ρ.g1 w with hw1def
    have hw1 : w - w1 ∈ U := krepAvg_sub_mem hU.2 hw.2
    have hg1w1 : ρ.g1 w1 = w1 := krepAvg_fixed ρ.g1_cube w
    have hg0w1 : ρ.g0 w1 - w1 ∈ U := by
      rw [hw1def, krepAvg_comm (krep_comm_apply ρ.comm), ← krepAvg_sub]
      exact krepAvg_mem hU.2 hw.1
    refine ⟨krepAvg ρ.g0 w1, ?_, ?_⟩
    · simp only [KAction.fixK, Submodule.mem_inf, mem_fixedSpace]
      refine ⟨krepAvg_fixed ρ.g0_cube w1, ?_⟩
      rw [krepAvg_comm (fun v => (krep_comm_apply ρ.comm v).symm), hg1w1]
    · have := U.add_mem hw1 (krepAvg_sub_mem hU.1 hg0w1)
      rwa [sub_add_sub_cancel] at this

/-- Fixed subspaces of a restriction are the ambient fixed subspaces intersected with `U`. -/
theorem finrank_fixH_restrict (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) (H : Fin 4) :
    Module.finrank ℝ ((ρ.restrict U hU).fixH H) = Module.finrank ℝ ↥(ρ.fixH H ⊓ U) :=
  krep_finrank_fixH_restrict ρ U hU H

theorem finrank_fixK_restrict (ρ : KAction V) (U : Submodule ℝ V) (hU : ρ.IsInvariant U) :
    Module.finrank ℝ (ρ.restrict U hU).fixK = Module.finrank ℝ ↥(ρ.fixK ⊓ U) :=
  krep_finrank_fixK_restrict ρ U hU

end Dims


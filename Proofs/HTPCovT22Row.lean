/-! # Explicit row formula for the phased pure T22 covector

At every unit phase `ξ` (u_a = ξ_a / exactPhases_a), the weight of original row `fNumber pe.e.label`, for an
entry `pe` of `covT22`, is `toComplex(literal) · u^(pe.x)`; every other original row has weight `0`. -/

set_option autoImplicit false
set_option maxRecDepth 100000
namespace Option2.NativeStress.HTPhaseComplete
open HTPhaseKron NativeH ConfigurationResidualIndices CKM.NativeFirstOrder

/-- Distinct original rows (kernel check; the same fact is `rep22_nodup` via `rep22_typed`). -/
theorem rows22_nodup : (covT22.map fun q => (fNumber q.e.label).val).Nodup := by decide +kernel

theorem ellT22_row (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (pe : PEntry) (h : pe ∈ covT22) :
    ellT22 ξ hξ (fNumber pe.e.label) = Q12.toComplex pe.e.coefficient.toQ12 * mono (Uph ξ hξ) pe.x :=
  sum_ite_of_nodup covT22 (fun q => Q12.toComplex q.e.coefficient.toQ12 * mono (Uph ξ hξ) q.x)
    rows22_nodup pe h

theorem ellT22_off (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (r : Fin 2184)
    (h : ∀ q ∈ covT22, fNumber q.e.label ≠ r) : ellT22 ξ hξ r = 0 :=
  sum_ite_of_not_mem covT22 _ r h

end Option2.NativeStress.HTPhaseComplete

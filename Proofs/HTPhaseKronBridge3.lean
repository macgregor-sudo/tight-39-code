@[expose] public section

/-! # L1 (continued): character laws of the accepted literal family, and the bridge
`PhiR Q12.toComplex (u = ξ/ξ_base) = literalCfg ξ` at every unit phase. Generated by
py/gen_bridge3.py (first-party). -/

set_option autoImplicit false
set_option maxHeartbeats 1000000
namespace Option2.NativeStress.HTPhaseKron
open CompactAlbert CKM.NativeFirstOrder NativePolynomial NativeH.Equilibrium
open QuadraticCertificate.ExactCKMConfiguration UnitaryErrorBases.ThreeCycleFourier UnitaryErrorBases.ComplexQuartet

noncomputable def aG2 (ξ : Fin 4 → ℂ) (p : ℕ) : ℂ := ξ 0 * character (((p - 21) % 3 : ℕ) : PhaseIndex)
noncomputable def bG2 (ξ : Fin 4 → ℂ) (p : ℕ) : ℂ :=
  ξ 1 * character ((((p - 21) / 3 : ℕ) : PhaseIndex) + (((p - 21) % 3 : ℕ) : PhaseIndex))
noncomputable def aG3 (ξ : Fin 4 → ℂ) (p : ℕ) : ℂ := ξ 2 * character (((p - 30) % 3 : ℕ) : PhaseIndex)
noncomputable def bG3 (ξ : Fin 4 → ℂ) (p : ℕ) : ℂ :=
  ξ 3 * character ((((p - 30) / 3 : ℕ) : PhaseIndex) + (((p - 30) % 3 : ℕ) : PhaseIndex))

theorem Cn_pc' (ξ : Fin 4 → ℂ) (p c : ℕ) (hp : p < 39) (hc : c < 27) (n : ℕ) (hn : n = 27 * p + c) :
    Cn ξ n = ((upperCoordinates (literalPoint ξ ⟨p, hp⟩) ⟨c, hc⟩ : ℝ) : ℂ) := by
  subst hn; exact Cn_pc ξ p c hp hc

theorem bq_zero_low : (List.range 21).all (fun p =>
    [7, 8, 9, 10, 13, 14, 17, 18, 21, 22, 23, 24].all fun c => decide (bq (27 * p + c) = 0)) = true := by
  decide +kernel

theorem base_zero (p c : ℕ) (hp : p < 21) (hc : c ∈ [7, 8, 9, 10, 13, 14, 17, 18, 21, 22, 23, 24]) :
    Cn exactPhases (27 * p + c) = 0 := by
  have h := bq_zero_low
  simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
  rw [← base_link, h p hp c hc, map_zero]

theorem low_eq (ξ : Fin 4 → ℂ) (p c : ℕ) (hp : p < 21) (hc : c < 27) :
    Cn ξ (27 * p + c) = Cn exactPhases (27 * p + c) := by
  rw [Cn_pc' ξ p c (by omega) hc _ rfl, Cn_pc' exactPhases p c (by omega) hc _ rfl,
    literalPoint_low ξ _ (by simpa using hp), literalPoint_low exactPhases _ (by simpa using hp)]

theorem z2_2 (ξ : Fin 4 → ℂ) (p : ℕ) (h1 : 21 ≤ p) (h2 : p < 30) :
    Cn ξ (27 * p + 7) - Complex.I * Cn ξ (27 * p + 7 + 1) = -(starRingEnd ℂ (aG2 ξ p))/3 := by
  rw [Cn_pc' ξ p 7 (by omega) (by norm_num) _ rfl, Cn_pc' ξ p 8 (by omega) (by norm_num) _ rfl,
    point_g2 ξ p h1 h2]
  show ((-(aG2 ξ p).re/3 : ℝ) : ℂ) - Complex.I * ((-(aG2 ξ p).im/3 : ℝ) : ℂ) = -(starRingEnd ℂ (aG2 ξ p))/3
  apply Complex.ext <;> simp <;> ring


theorem cl_2 (ξ : Fin 4 → ℂ) (hξ : IsUnitPhase ξ) (p : ℕ) (hp : p < 39) :
    Cn ξ (27 * p + 3 + 2 * 2) - Complex.I * Cn ξ (27 * p + 3 + 2 * 2 + 1) =
      (Cn exactPhases (27 * p + 3 + 2 * 2) - Complex.I * Cn exactPhases (27 * p + 3 + 2 * 2 + 1)) *
        mono (Uph ξ hξ) (-1, 0, 0, 0) := by
  rw [show 27 * p + 3 + 2 * 2 = 27 * p + 7 by omega]
  rcases lt_or_ge p 21 with h | h
  · rw [low_eq ξ p 7 h (by norm_num), low_eq ξ p 8 h (by norm_num),
      base_zero p 7 h (by simp), base_zero p 8 h (by simp)]
    simp
  rcases lt_or_ge p 30 with h' | h'
  · rw [z2_2 ξ p h h', z2_2 exactPhases p h h', mono_Uph]
    simp only [aG2, bG2, map_mul, star_of_unit hξ, star_of_unit exactPhases_unit']
    field_simp [ne_of_unit hξ, ne_of_unit exactPhases_unit']
    try ring
  · rw [z3_2 ξ p (by omega) (by omega), z3_2 exactPhases p (by omega) (by omega), mono_Uph]
    simp only [aG3, bG3, map_mul, star_of_unit hξ, star_of_unit exactPhases_unit']
    field_simp [ne_of_unit hξ, ne_of_unit exactPhases_unit']
    try ring


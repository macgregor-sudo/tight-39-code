module

public import A6DataLin

@[expose] public section

/-!
# Lane LIN: sparse LU certificate of a 973 × 973 minor of `L_p`

Minor `A a b = L_p (rowSel a) (colSel b)` (pivot order of a right-looking Markowitz elimination on `L_p` restricted to
the 973 pivot columns). `A = Lo · U`, `Lo` unit lower triangular (`loRow a`: strictly lower entries `(k, ℓ)`, `k < a`),
`U` upper triangular with nonzero diagonal (`uRow k`: entries `(b, u)`, `b ≥ k`). `colPos` inverts `colSel`
(4095 off the pivot columns). Generated by `py/gen.py` + `py/emit.py`. First-party data.
-/

namespace A6Compact

/-- Strictly lower LU multipliers, packed (7486 entries). -/
def loData : ℕ :=
  

/-- Row offsets of `loData` (974 entries). -/
def loOffs : ℕ :=
  

/-- Upper LU factor rows, packed (3921 entries). -/
def uData : ℕ :=
  

/-- Row offsets of `uData` (974 entries). -/
def uOffs : ℕ :=
  

/-- Minor rows (F-row numbers), 12-bit table. -/
def rowSelPacked : ℕ :=
  

/-- Minor columns, 12-bit table. -/
def colSelPacked : ℕ :=
  

/-- Position of a column in `colSel` (4095 if none), 12-bit table. -/
def colPosPacked : ℕ :=
  

def loRow (a : ℕ) : List (ℕ × ℕ) := sparseRow loData loOffs a
def uRow (k : ℕ) : List (ℕ × ℕ) := sparseRow uData uOffs k
def rowSelN (a : ℕ) : ℕ := tab 12 rowSelPacked a
def colSelN (b : ℕ) : ℕ := tab 12 colSelPacked b
def colPosN (j : ℕ) : ℕ := tab 12 colPosPacked j

end A6Compact

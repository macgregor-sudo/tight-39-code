module

public import ConvergentResidualJetMap
public import PolynomialJetPrerequisitesModule

@[expose] public section

/-!
# Polynomial evaluation and pointed residual germs

Evaluation of the existing polynomial germ at zero is polynomial evaluation
at zero. After the existing translation by P it is evaluation at that same
P. Consequently the analytic ideal generated by the translated residuals
is contained in the vanishing ideal exactly when all residuals vanish at P.

These are first-party compositions of existing ring-homomorphism and ideal
APIs; no source body is copied. The mathematical facts are standard evaluation
functoriality and the universal property of an ideal span. Imported APIs are
Mathlib/Algebra/MvPolynomial/Basic.lean::ringHom_ext,
Mathlib/Algebra/MvPolynomial/Eval.lean::eval_assoc, and
Mathlib/RingTheory/Ideal/Maps.lean::map_le_iff_le_comap at
https://github.com/leanprover-community/mathlib4,
commit 065356127b1dc0016f66b7283ce0ce2c4055aa55 (Apache-2.0).
Thank you to the Lean and Mathlib contributors.
“If I have seen further it is by standing on the sholders of Giants.”
— Isaac Newton, letter to Robert Hooke, 1676.
-/

noncomputable section

namespace ConvergentResidualPointBinding

open ConvergentResidualJets PolynomialJets

theorem evalAtZero_polynomialGerm {n : ℕ} (p : Poly n) :
    evalAtZero n (polynomialGerm n p) = MvPolynomial.eval (0 : Fin n → ℂ) p := by
  have h : (evalAtZero n).comp (polynomialGerm n).toRingHom =
      MvPolynomial.eval (0 : Fin n → ℂ) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, MvPolynomial.eval_C]
      change evalAtZero n (polynomialGerm n (MvPolynomial.C c)) = c
      rw [polynomialGerm, MvPolynomial.aeval_C]
      rfl
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.eval_X, Pi.zero_apply]
      change evalAtZero n (polynomialGerm n (MvPolynomial.X i)) = 0
      rw [polynomialGerm, MvPolynomial.aeval_X]
      rfl
  exact RingHom.congr_fun h p

theorem evalAtZero_polynomialGerm_translate {n : ℕ} (P : Fin n → ℂ) (p : Poly n) :
    evalAtZero n (polynomialGerm n (translate P p)) = MvPolynomial.eval P p := by
  rw [evalAtZero_polynomialGerm, translate, ← MvPolynomial.eval_assoc]
  have hpoint : (MvPolynomial.eval (0 : Fin n → ℂ) ∘
      (fun j => MvPolynomial.X j + MvPolynomial.C (P j))) = P := by
    funext i
    simp only [Function.comp_apply, map_add, MvPolynomial.eval_X, MvPolynomial.eval_C,
      Pi.zero_apply, zero_add]
  rw [hpoint]

/-- The extended polynomial ideal vanishes exactly when its generators do. -/
theorem map_span_le_vanishingIdeal_iff {n : ℕ} {ι : Type*} (g : ι → Poly n) :
    Ideal.map (polynomialGerm n).toRingHom (Ideal.span (Set.range g)) ≤
        vanishingIdeal n ↔
      ∀ i, MvPolynomial.eval (0 : Fin n → ℂ) (g i) = 0 := by
  rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
  constructor
  · intro h i
    have hi := h (Set.mem_range_self i)
    change evalAtZero n (polynomialGerm n (g i)) = 0 at hi
    rwa [evalAtZero_polynomialGerm] at hi
  · rintro h _ ⟨i, rfl⟩
    change evalAtZero n (polynomialGerm n (g i)) = 0
    rw [evalAtZero_polynomialGerm]
    exact h i

/-- The same complex point controls the maximal-ideal condition after translation. -/
theorem map_translated_span_le_vanishingIdeal_iff {n : ℕ} {ι : Type*}
    (f : ι → Poly n) (P : Fin n → ℂ) :
    Ideal.map (polynomialGerm n).toRingHom
        (Ideal.span (Set.range (fun i => translate P (f i)))) ≤ vanishingIdeal n ↔
      ∀ i, MvPolynomial.eval P (f i) = 0 := by
  rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
  constructor
  · intro h i
    have hi := h (Set.mem_range_self i)
    change evalAtZero n (polynomialGerm n (translate P (f i))) = 0 at hi
    rwa [evalAtZero_polynomialGerm_translate] at hi
  · rintro h _ ⟨i, rfl⟩
    change evalAtZero n (polynomialGerm n (translate P (f i))) = 0
    rw [evalAtZero_polynomialGerm_translate]
    exact h i

end ConvergentResidualPointBinding

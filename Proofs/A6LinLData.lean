/-!
# Lane LIN: the Jacobian `L_p` (2184 × 1053, 17,877 nonzeros) and the reduced point, as packed literals

`lRow r` = nonzero entries `(column, value)` of row `r` of `L_p = equationLinearMatrix translatedRowModP` (tied to the
actual rows by the kernel checks of `A6LinTie*`). `ptVal v` = the reduced point `pointModP v` (20-bit table; tied in
`A6LinTie0`). Generated by `py/gen.py` + `py/emit.py`. First-party data.
-/

namespace A6Compact

/-- Jacobian rows, packed (17877 entries). -/
def lData : ℕ :=
  

/-- Row offsets of `lData` (2185 entries). -/
def lOffs : ℕ :=
  

/-- The reduced point, 20-bit table (1053 entries). -/
def ptPacked : ℕ :=
  

/-- Sparse row `r` of `L_p`. -/
def lRow (r : ℕ) : List (ℕ × ℕ) := sparseRow lData lOffs r

/-- The reduced point as residues. -/
def ptVal (v : ℕ) : ℕ := tab 20 ptPacked v

end A6Compact

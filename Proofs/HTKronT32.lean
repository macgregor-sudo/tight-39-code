module

public import HTKronLists

@[expose] public section

/-!
# T component (3, 2): Kronecker evaluation in four row blocks (ENGINE, first-party)

The original 465 rows are split at row-type boundaries: idempotency rows [0,114) and
[114,342) (the latter with all frame-sum rows), pairing rows [342,403) and
[403,465). Each block value is a literal proposed by an exact replica and re-checked by the
kernel from the original data; their sum is checked against the Book value.
-/

set_option autoImplicit false
set_option maxRecDepth 200000
set_option Elab.async false

namespace Option2.NativeStress.HTRouteKron

def T32w0 : Z4 := ⟨(-), (), (-), (-)⟩

theorem T32c0 : engine (denLcm (NativeT.rawEntries 3 2)) (NativeT.tSpec 3 2) (((NativeT.rawEntries 3 2).drop 0).take 114) (stateList ystar) =
    T32w0 := by decide +kernel

def T32w1 : Z4 := ⟨(), (-), (), ()⟩

theorem T32c1 : engine (denLcm (NativeT.rawEntries 3 2)) (NativeT.tSpec 3 2) (((NativeT.rawEntries 3 2).drop 114).take 228) (stateList ystar) =
    T32w1 := by decide +kernel

def T32w2 : Z4 := ⟨(), (), (), ()⟩

theorem T32c2 : engine (denLcm (NativeT.rawEntries 3 2)) (NativeT.tSpec 3 2) (((NativeT.rawEntries 3 2).drop 342).take 61) (stateList ystar) =
    T32w2 := by decide +kernel

def T32w3 : Z4 := ⟨(-), (-), (-), (-)⟩

theorem T32c3 : engine (denLcm (NativeT.rawEntries 3 2)) (NativeT.tSpec 3 2) (((NativeT.rawEntries 3 2).drop 403).take 62) (stateList ystar) =
    T32w3 := by decide +kernel

theorem T32len : (NativeT.rawEntries 3 2).length = 465 := by decide +kernel

theorem T32sum : T32w0 + (T32w1 + (T32w2 + (T32w3 + 0))) = tBookValue 3 2 := by decide +kernel

theorem tCheck32 : tValue 3 2 = tBookValue 3 2 := by
  have h0 : tValue 3 2 = engine (denLcm (NativeT.rawEntries 3 2)) (NativeT.tSpec 3 2) ((NativeT.rawEntries 3 2).drop 0) (stateList ystar) := by
    rw [List.drop_zero]; rfl
  rw [h0,
    engine_split' _ _ _ _ 0 114 114 rfl, T32c0,
    engine_split' _ _ _ _ 114 228 342 rfl, T32c1,
    engine_split' _ _ _ _ 342 61 403 rfl, T32c2,
    engine_split' _ _ _ _ 403 62 465 rfl, T32c3,
    engine_drop_length _ _ _ _ 465 (by rw [T32len])]
  exact T32sum

end Option2.NativeStress.HTRouteKron

module

public import SliceRestriction
public import Mathlib.RingTheory.Ideal.Quotient.Operations

@[expose] public section

/-!
# The kernel of restriction to a slice is generated by the annihilating linear forms

Setting: `B : Matrix (Fin n) (Fin m) K` together with a *pivot map* `piv : Fin m → Fin n`
such that the rows of `B` indexed by `piv` form the identity matrix,
`B (piv t) t' = if t = t' then 1 else 0`. (Any matrix of full column rank becomes of this
form after a change of slice coordinates.)

Main results.
* `pivotSubstitute B piv` replaces every variable `X_j` by its value on the slice, written in
  the pivot variables: `X_j ↦ ∑_t B j t • X_(piv t)`. It factors as
  `rename piv ∘ restrict B`, and `restrict B ∘ pivotSubstitute B piv = restrict B`.
* `restrict B` is a left inverse of `rename piv`: on polynomials in the pivot variables,
  restriction is just a renaming of variables, hence injective.
* `f - pivotSubstitute B piv f` lies in the ideal generated by the linear forms
  `X_j - ∑_t B j t • X_(piv t)`.
* (S1) restriction kills `W · S_e` when every element of `W` vanishes on the slice.
* (S2) If `W` contains all degree-one forms vanishing on the slice, every homogeneous
  polynomial of degree `e + 1` vanishing on the slice lies in `W · S_e`, the `K`-span of the
  products `w * g` with `w ∈ W` and `g` homogeneous of degree `e`.
-/

open MvPolynomial
open scoped Matrix

namespace SliceLemmas

variable {K : Type*} [Field K] {n m : ℕ}

/-- The pivot condition: the rows of `B` indexed by `piv` form the identity matrix. -/
def IsPivot (B : Matrix (Fin n) (Fin m) K) (piv : Fin m → Fin n) : Prop :=
  ∀ t t', B (piv t) t' = if t = t' then 1 else 0

/-- A pivot map is automatically injective. -/
theorem IsPivot.injective {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) : Function.Injective piv := by
  intro t t' h
  have h1 : B (piv t') t' = B (piv t) t' := by rw [h]
  rw [hB t', hB t] at h1
  by_contra hne
  simp [hne] at h1

/-- Substitution of every variable by its slice value written in the pivot variables:
`X_j ↦ ∑_t B j t • X_(piv t)`. -/
noncomputable def pivotSubstitute (B : Matrix (Fin n) (Fin m) K) (piv : Fin m → Fin n) :
    MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin n) K :=
  aeval fun j => ∑ t, C (B j t) * X (piv t)

/-- The linear form `X_j - ∑_t B j t • X_(piv t)`; these generate the kernel of restriction. -/
noncomputable def pivotRelation (B : Matrix (Fin n) (Fin m) K) (piv : Fin m → Fin n)
    (j : Fin n) : MvPolynomial (Fin n) K :=
  X j - ∑ t, C (B j t) * X (piv t)

/-- Pivot substitution is restriction followed by renaming the slice variables to the
pivot variables. -/
theorem pivotSubstitute_eq_rename_comp_restrict (B : Matrix (Fin n) (Fin m) K)
    (piv : Fin m → Fin n) :
    pivotSubstitute B piv = (rename piv).comp (restrict B) := by
  apply algHom_ext
  intro j
  simp [pivotSubstitute, restrict, map_sum]

/-- Restriction undoes renaming into the pivot variables. -/
theorem restrict_comp_rename {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) :
    (restrict B).comp (rename piv) = AlgHom.id K (MvPolynomial (Fin m) K) := by
  apply algHom_ext
  intro t
  have hB' : ∀ t t', B (piv t) t' = if t = t' then 1 else 0 := hB
  simp [restrict_X, hB']

theorem restrict_rename {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) (g : MvPolynomial (Fin m) K) : restrict B (rename piv g) = g := by
  have := congrArg (fun φ : MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin m) K => φ g)
    (restrict_comp_rename hB)
  simpa using this

/-- On polynomials in the pivot variables, restriction is injective (it is a renaming). -/
theorem restrict_injOn_range_rename {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) :
    Set.InjOn (restrict B) (Set.range (rename (R := K) piv)) := by
  rintro _ ⟨g, rfl⟩ _ ⟨g', rfl⟩ h
  rw [restrict_rename hB, restrict_rename hB] at h
  rw [h]

/-- Restriction is unchanged by first substituting the slice values of the variables. -/
theorem restrict_comp_pivotSubstitute {B : Matrix (Fin n) (Fin m) K} {piv : Fin m → Fin n}
    (hB : IsPivot B piv) :
    (restrict B).comp (pivotSubstitute B piv) = restrict B := by
  rw [pivotSubstitute_eq_rename_comp_restrict, ← AlgHom.comp_assoc, restrict_comp_rename hB,
    AlgHom.id_comp]

theorem pivotRelation_mem_homogeneousSubmodule (B : Matrix (Fin n) (Fin m) K)
    (piv : Fin m → Fin n) (j : Fin n) :
    pivotRelation B piv j ∈ homogeneousSubmodule (Fin n) K 1 :=
  (isHomogeneous_X K j).sub (IsHomogeneous.sum _ _ _ fun _ _ => isHomogeneous_C_mul_X _ _)

/-- The pivot relations vanish on the slice. -/
theorem pivotRelation_mem_linearAnnihilator {B : Matrix (Fin n) (Fin m) K}
    {piv : Fin m → Fin n} (hB : IsPivot B piv) (j : Fin n) :
    pivotRelation B piv j ∈ linearAnnihilator B := by
  refine ⟨pivotRelation_mem_homogeneousSubmodule B piv j, ?_⟩
  show restrict B (pivotRelation B piv j) = 0
  have h : (∑ t, C (B j t) * X (piv t) : MvPolynomial (Fin n) K) =
      rename piv (∑ t, C (B j t) * X t) := by
    simp [map_sum]
  rw [pivotRelation, map_sub, h, restrict_rename hB, restrict_X, sub_self]

/-- Every polynomial is congruent to its pivot substitution modulo the pivot relations. -/
theorem sub_pivotSubstitute_mem_span_pivotRelation (B : Matrix (Fin n) (Fin m) K)
    (piv : Fin m → Fin n) (f : MvPolynomial (Fin n) K) :
    f - pivotSubstitute B piv f ∈ Ideal.span (Set.range (pivotRelation B piv)) := by
  set I := Ideal.span (Set.range (pivotRelation B piv))
  have hcomp : (Ideal.Quotient.mkₐ K I).comp (pivotSubstitute B piv) =
      Ideal.Quotient.mkₐ K I := by
    apply algHom_ext
    intro j
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, pivotSubstitute, aeval_X]
    refine Ideal.Quotient.eq.mpr ?_
    have hj : pivotRelation B piv j ∈ I := Ideal.subset_span ⟨j, rfl⟩
    have : (∑ t, C (B j t) * X (piv t)) - X j = -pivotRelation B piv j := by
      simp [pivotRelation]
    rw [this]
    exact I.neg_mem hj
  have h := congrArg (fun φ : MvPolynomial (Fin n) K →ₐ[K] _ => φ f) hcomp
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h
  exact Ideal.Quotient.eq.mp h.symm

/-- The degree-`(e+1)` part of `W · S_e`: the `K`-span of the products `w * g` with `w ∈ W`
and `g` homogeneous of degree `e`. -/
noncomputable def sliceRelations (W : Submodule K (MvPolynomial (Fin n) K)) (e : ℕ) :
    Submodule K (MvPolynomial (Fin n) K) :=
  Submodule.span K
    {p | ∃ w ∈ W, ∃ g ∈ homogeneousSubmodule (Fin n) K e, p = w * g}

theorem mul_mem_sliceRelations {W : Submodule K (MvPolynomial (Fin n) K)} {e : ℕ}
    {w g : MvPolynomial (Fin n) K} (hw : w ∈ W) (hg : g ∈ homogeneousSubmodule (Fin n) K e) :
    w * g ∈ sliceRelations W e :=
  Submodule.subset_span ⟨w, hw, g, hg, rfl⟩

/-- `W · S_e` consists of homogeneous polynomials of degree `e + 1` when `W` consists of
linear forms. -/
theorem sliceRelations_le_homogeneousSubmodule {W : Submodule K (MvPolynomial (Fin n) K)}
    (hW : W ≤ homogeneousSubmodule (Fin n) K 1) (e : ℕ) :
    sliceRelations W e ≤ homogeneousSubmodule (Fin n) K (e + 1) := by
  rw [sliceRelations, Submodule.span_le]
  rintro _ ⟨w, hw, g, hg, rfl⟩
  have := (hW hw).mul hg
  rwa [add_comm] at this

/-- (S1) If every element of `W` vanishes on the slice, so does every element of `W · S_e`. -/
theorem restrict_eq_zero_of_mem_sliceRelations {B : Matrix (Fin n) (Fin m) K}
    {W : Submodule K (MvPolynomial (Fin n) K)} (hW : W ≤ linearAnnihilator B) {e : ℕ}
    {p : MvPolynomial (Fin n) K} (hp : p ∈ sliceRelations W e) : restrict B p = 0 := by
  have hle : sliceRelations W e ≤ LinearMap.ker (restrict B).toLinearMap := by
    rw [sliceRelations, Submodule.span_le]
    rintro _ ⟨w, hw, g, _, rfl⟩
    have hw' : restrict B w = 0 := (hW hw).2
    show restrict B (w * g) = 0
    rw [map_mul, hw', zero_mul]
  exact hle hp

/-- The degree-`(e+1)` component of `a * w` for a linear form `w` is
`(degree-e component of a) * w`. -/
theorem homogeneousComponent_mul_linear {w : MvPolynomial (Fin n) K}
    (hw : w ∈ homogeneousSubmodule (Fin n) K 1) (e : ℕ) (a : MvPolynomial (Fin n) K) :
    homogeneousComponent (e + 1) (a * w) = homogeneousComponent e a * w := by
  induction a using MvPolynomial.induction_on' with
  | monomial u r =>
    have hu : (monomial u r).IsHomogeneous u.degree := isHomogeneous_monomial r rfl
    have huw : (monomial u r * w).IsHomogeneous (u.degree + 1) := hu.mul hw
    rw [homogeneousComponent_of_mem huw, homogeneousComponent_of_mem hu]
    by_cases h : e = u.degree
    · simp [h]
    · simp [h]
  | add p q hp hq =>
    rw [add_mul, map_add, map_add, add_mul, hp, hq]

/-- The degree-`(e+1)` component of any element of the ideal generated by `W` lies in
`W · S_e`, when `W` consists of linear forms. -/
theorem homogeneousComponent_mem_sliceRelations_of_mem_span
    {W : Submodule K (MvPolynomial (Fin n) K)} (hW : W ≤ homogeneousSubmodule (Fin n) K 1)
    (e : ℕ) {p : MvPolynomial (Fin n) K} (hp : p ∈ Ideal.span (W : Set (MvPolynomial (Fin n) K))) :
    homogeneousComponent (e + 1) p ∈ sliceRelations W e := by
  suffices h : ∀ a : MvPolynomial (Fin n) K,
      homogeneousComponent (e + 1) (a * p) ∈ sliceRelations W e by
    simpa using h 1
  induction hp using Submodule.span_induction with
  | mem w hw =>
    intro a
    rw [homogeneousComponent_mul_linear (hW hw), mul_comm]
    exact mul_mem_sliceRelations hw (homogeneousComponent_mem e a)
  | zero => intro a; simp
  | add x y _ _ hx hy =>
    intro a
    rw [mul_add, map_add]
    exact add_mem (hx a) (hy a)
  | smul b x _ hx =>
    intro a
    rw [smul_eq_mul, ← mul_assoc]
    exact hx (a * b)

/-- (S2) Let `W` be a space of linear forms containing every linear form that vanishes on the
slice. Then every homogeneous polynomial of degree `e + 1` vanishing on the slice lies in
`W · S_e`. -/
theorem mem_sliceRelations_of_restrict_eq_zero {B : Matrix (Fin n) (Fin m) K}
    {piv : Fin m → Fin n} (hB : IsPivot B piv) {W : Submodule K (MvPolynomial (Fin n) K)}
    (hW : W ≤ homogeneousSubmodule (Fin n) K 1) (hann : linearAnnihilator B ≤ W) {e : ℕ}
    {f : MvPolynomial (Fin n) K} (hf : f ∈ homogeneousSubmodule (Fin n) K (e + 1))
    (hres : restrict B f = 0) : f ∈ sliceRelations W e := by
  have hsub : pivotSubstitute B piv f = 0 := by
    rw [pivotSubstitute_eq_rename_comp_restrict, AlgHom.comp_apply, hres, map_zero]
  have hspan : Ideal.span (Set.range (pivotRelation B piv)) ≤
      Ideal.span (W : Set (MvPolynomial (Fin n) K)) := by
    apply Ideal.span_mono
    rintro _ ⟨j, rfl⟩
    exact hann (pivotRelation_mem_linearAnnihilator hB j)
  have hmem : f ∈ Ideal.span (W : Set (MvPolynomial (Fin n) K)) := by
    have := hspan (sub_pivotSubstitute_mem_span_pivotRelation B piv f)
    rwa [hsub, sub_zero] at this
  have := homogeneousComponent_mem_sliceRelations_of_mem_span hW e hmem
  rwa [homogeneousComponent_eq_self hf] at this

/-- (S1 + S2) Under the hypotheses of (S2), with `W` vanishing on the slice, `W · S_e` is
exactly the space of degree-`(e+1)` forms vanishing on the slice. -/
theorem mem_sliceRelations_iff {B : Matrix (Fin n) (Fin m) K}
    {piv : Fin m → Fin n} (hB : IsPivot B piv) {W : Submodule K (MvPolynomial (Fin n) K)}
    (hW : W = linearAnnihilator B) {e : ℕ} (f : MvPolynomial (Fin n) K) :
    f ∈ sliceRelations W e ↔
      f ∈ homogeneousSubmodule (Fin n) K (e + 1) ∧ restrict B f = 0 := by
  have hWh : W ≤ homogeneousSubmodule (Fin n) K 1 := hW ▸ inf_le_left
  constructor
  · intro hf
    exact ⟨sliceRelations_le_homogeneousSubmodule hWh e hf,
      restrict_eq_zero_of_mem_sliceRelations hW.le hf⟩
  · rintro ⟨h1, h2⟩
    exact mem_sliceRelations_of_restrict_eq_zero hB hWh hW.ge h1 h2

end SliceLemmas
